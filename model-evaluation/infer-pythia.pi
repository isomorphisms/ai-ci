"""Local Pythia inference through foreign Transformers/PyTorch, checked by Ithon."""
import sys
import os
import json
import hashlib
import time
import importlib.util
from pathlib import Path
from builtins import ValueError, Exception, globals


def encoded(value ∈ object) → str:
    text ∈ str ← json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return text


def load(path ∈ str) → object:
    value ∈ object ← json.loads(Path(path).read_text())
    return value


def save(path ∈ str, value ∈ object) → None:
    with Path(path).open("x", encoding="utf-8") as stream:
        stream.write(encoded(value) + "\n")


def prompt_text(messages ∈ list[dict[str, str]]) → str:
    parts ∈ list[str] ← []
    for message in messages:
        parts.append(message["role"].capitalize() + ":\n" + message["content"])
    return "\n\n".join(parts) + "\n\nAssistant:\n"


def blocked(output ∈ str, reason ∈ str) → int:
    save(output + "/inference.json", {"status": "BLOCKED", "reason": reason, "requests_attempted": 0, "model_inference": "NOT_RUN", "live_transfer": "NOT_RUN"})
    print("BLOCKED: " + reason)
    return 3


def infer(output ∈ str) → int:
    record ∈ dict[str, object] ← load(output + "/model.json")
    profile ∈ dict[str, object] ← record["profile"]
    model_name ∈ str ← profile["hf_repo"]
    if not model_name.startswith("EleutherAI/pythia-") or profile["interface"] != "completion":
        raise ValueError("this adapter is specifically for Pythia completion models")
    for dependency in ["torch", "transformers", "huggingface_hub"]:
        if importlib.util.find_spec(dependency) is None:
            return blocked(output, "missing foreign inference dependency: " + dependency)
    cache ∈ str ← os.environ.get("MODEL_EVAL_MODEL_CACHE", "")
    if not cache or not Path(cache).is_absolute():
        return blocked(output, "declare an absolute MODEL_EVAL_MODEL_CACHE outside the source repositories")
    if os.environ.get("MODEL_EVAL_ALLOW_DOWNLOAD", "") != "1":
        return blocked(output, "explicit MODEL_EVAL_ALLOW_DOWNLOAD=1 is required for checkpoint acquisition")
    import torch
    import transformers
    import huggingface_hub
    from huggingface_hub import HfApi
    from transformers import AutoTokenizer, AutoModelForCausalLM
    jobs ∈ list[dict[str, object]] ← load(output + "/requests.json")
    manifest ∈ dict[str, object] ← load(output + "/manifest.json")
    if hashlib.sha256(encoded(jobs).encode()).hexdigest() != manifest["requests_sha256"] or len(jobs) != manifest["count"]:
        raise ValueError("prepared request manifest changed")
    api ∈ object ← HfApi()
    info ∈ object ← api.model_info(model_name, revision=profile["revision"])
    revision ∈ str ← info.sha
    if len(revision) != 40:
        raise ValueError("checkpoint did not resolve to an immutable revision")
    device ∈ str ← os.environ.get("MODEL_EVAL_DEVICE", "cpu")
    if device not in ["cpu", "cuda"]:
        raise ValueError("device must be explicitly cpu or cuda")
    if device == "cuda" and not torch.cuda.is_available():
        return blocked(output, "declared CUDA device is unavailable")
    dtype ∈ object ← torch.float32
    if device == "cuda":
        dtype ← torch.float16
    tokenizer ∈ object ← AutoTokenizer.from_pretrained(model_name, revision=revision, cache_dir=cache, trust_remote_code=False)
    model ∈ object ← AutoModelForCausalLM.from_pretrained(model_name, revision=revision, cache_dir=cache, torch_dtype=dtype, attn_implementation="eager", trust_remote_code=False)
    model.to(device)
    model.eval()
    torch.set_num_threads(2)
    capture ∈ bool ← os.environ.get("PYTHIA_CAPTURE_PREFILL", "") == "1"
    save(output + "/identity.json", {"backend": "transformers-gpt-neox", "model": model_name, "model_revision": revision, "tokenizer_revision": revision, "torch": torch.__version__, "transformers": transformers.__version__, "huggingface_hub": huggingface_hub.__version__, "device": device, "dtype": str(dtype), "threads": 2, "prompt_format": "explicit role-labeled completion; not an instruction chat template", "prefill_capture": capture, "remote_code": False, "live_transfer": "NOT_RUN"})
    for job in jobs:
        started ∈ float ← time.monotonic()
        result ∈ dict[str, object] ← {"id": job["id"], "request_sha256": job["request_sha256"], "evidence": "live", "status": "FAILED", "text": ""}
        try:
            payload ∈ dict[str, object] ← job["payload"]
            prompt ∈ str ← prompt_text(payload["messages"])
            inputs ∈ object ← tokenizer(prompt, return_tensors="pt", truncation=False).to(device)
            input_count ∈ int ← inputs["input_ids"].size(-1)
            if input_count + payload["max_tokens"] > model.config.max_position_embeddings:
                raise ValueError("context would overflow; silent truncation is forbidden")
            torch.manual_seed(payload["seed"])
            with torch.inference_mode():
                generated ∈ object ← model.generate(**inputs, do_sample=True, temperature=payload["temperature"], max_new_tokens=payload["max_tokens"], pad_token_id=tokenizer.eos_token_id, return_dict_in_generate=True, output_scores=True)
                if capture:
                    prefill ∈ object ← model(**inputs, output_hidden_states=True, return_dict=True)
                    activations ∈ list[object] ← []
                    for layer in prefill.hidden_states:
                        activations.append(layer[0, -1].float().cpu().tolist())
                    save(output + "/raw/" + job["id"] + ".last-input-position-activations.json", activations)
            sequence ∈ object ← generated.sequences[0, input_count:]
            text ∈ str ← tokenizer.decode(sequence, skip_special_tokens=True)
            transitions ∈ object ← model.compute_transition_scores(generated.sequences, generated.scores, normalize_logits=True)
            save(output + "/raw/" + job["id"] + ".tokens.json", {"prompt": prompt, "input_ids": inputs["input_ids"].cpu().tolist(), "output_ids": sequence.cpu().tolist(), "token_log_probabilities": transitions.float().cpu().tolist()})
            if sequence.numel() >= payload["max_tokens"] and int(sequence[-1]) != tokenizer.eos_token_id:
                raise ValueError("generation exhausted the token budget")
            result["status"] ← "EXECUTED"
            result["text"] ← text
        except Exception as error:
            result["error"] ← type(error).__name__
        result["seconds"] ← time.monotonic() - started
        save(output + "/responses/" + job["id"] + ".json", result)
    save(output + "/inference.json", {"status": "EXECUTED", "requests_attempted": len(jobs), "model_revision": revision, "live_transfer": "NOT_RUN"})
    return 0


def main() → int:
    args ∈ list[str] ← sys.argv[1:]
    if args == ["check"]:
        if prompt_text([{"role": "user", "content": "move repository"}]) != "User:\nmove repository\n\nAssistant:\n":
            raise ValueError("Pythia completion serialization changed")
        print("PASS Pythia adapter frontend and prompt serialization; inference NOT_RUN")
        return 0
    if len(args) == 2 and args[0] == "run":
        return infer(args[1])
    raise ValueError("usage: infer-pythia.pi check | run PREPARED_DIRECTORY")

namespace ∈ dict[str, object] ← globals()
if namespace.get("__name__", "") == "__main__":
    sys.exit(main())
