#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'requires ADB SERIAL API APK INDEPENDENT_INPUTS NEW_EVIDENCE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var api = ARGV[2]
var apk = ARGV[3]
var input = ARGV[4]
var output = ARGV[5]
if test -e "$output" { echo 'refusing reused UI evidence' >&2; exit 2 }
mkdir -p "$output"
var grease = ENV.GREASE
"$grease" "$input/guards/observe-provenance.grease" "$input" "$apk" "$output"
var oracle = "$input/oracle/pasteboard-oracle"
var package = 'com.isomorphisms.pasteboard'
var component = 'com.isomorphisms.pasteboard/android.app.NativeActivity'
var fixture = 'org.isomorphisms.aici.clipboardfixture/android.app.NativeActivity'
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r' | rg -x -F "$api"
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
# API 29 reset the display override on the preceding real reboot. Restore and
# retain this stage's declared geometry before issuing any coordinate input.
"$adb" -s "$serial" shell wm size 480x960
"$adb" -s "$serial" shell wm density 160
"$adb" -s "$serial" shell wm size | tr -d '\r' > "$output/display-size.txt"
"$adb" -s "$serial" shell wm density | tr -d '\r' > "$output/display-density.txt"
rg -q -x '(Physical|Override) size: 480x960' "$output/display-size.txt"
rg -q -x '(Physical|Override) density: 160' "$output/display-density.txt"
"$adb" -s "$serial" shell getprop ro.build.fingerprint > "$output/fingerprint.txt"
sha256sum "$apk" > "$output/apk.sha256"
cp "$input/observer-commit.txt" "$output/"
proc snapshot(label) {
  "$adb" -s "$serial" exec-out run-as "$package" cat files/history.v2 > "$output/$label.bin"
  "$oracle" validate "$output/$label.bin" > "$output/$label.integrity.txt"
}
proc tap(x, y) { "$adb" -s "$serial" shell input tap "$x" "$y"; sleep 0.35 }
proc start_app(label) {
  "$adb" -s "$serial" shell am start -W -n "$component" > "$output/$label.launch.txt"
  sleep 1
}
proc menu(row) { tap 450 60; var y = 215 + int(row) * 76; tap 240 "$y" }
proc card_menu(index) {
  var x = 214
  if (int(index) % 2 !== 0) { setvar x = 450 }
  # Calibrated from actual 480x960 screenshots: API 29 has a 48px navigation
  # bar; API 34/35 has a 24px gesture bar. Keep every point inside its card.
  var y = 108 + (int(index) // 2) * 106
  if (int(api) === 29) { setvar y = 104 + (int(index) // 2) * 104 }
  tap "$x" "$y"
}
proc diagnose(label) {
  "$adb" -s "$serial" exec-out screencap -p > "$output/$label.png"
  "$adb" -s "$serial" logcat -d -v threadtime > "$output/$label.logcat.txt"
}
proc await_state(label, verb, ...arguments) {
  var matched = false
  for attempt in @(seq 1 30) {
    snapshot "$label"
    try { "$oracle" "$verb" "$output/$label.bin" @arguments > "$output/$label.expectation.txt" }
    if (_error.code === 0) {
      printf 'matched_after_attempts\t%s\n' "$attempt" > "$output/$label.settled.txt"
      setvar matched = true
      break
    }
    sleep 0.2
  }
  if (not matched) { diagnose "$label"; cat "$output/$label.expectation.txt"; exit 1 }
}
proc await_delivery(label, before, count) {
  var matched = false
  for attempt in @(seq 1 30) {
    snapshot "$label"
    try { "$oracle" added-deliveries "$before" "$output/$label.bin" "$count" > "$output/$label.deliveries.txt" }
    if (_error.code === 0) { setvar matched = true; break }
    sleep 0.2
  }
  if (not matched) { diagnose "$label"; cat "$output/$label.deliveries.txt"; exit 1 }
}
proc clipboard_readback(label, expected) {
  var matched = false
  for attempt in @(seq 1 15) {
    "$adb" -s "$serial" logcat -d -s PasteboardDiagnostic:I PasteboardObserver:I PasteboardHistory:I >> "$output/observer-boundary.logcat.txt"
    "$adb" -s "$serial" logcat -c
    "$adb" -s "$serial" shell input keyevent HOME
    "$adb" -s "$serial" shell am start -W -n "$fixture" > "$output/$label.fixture.txt"
    sleep 0.5
    "$adb" -s "$serial" logcat -d -s CopyFixture:I > "$output/$label.clipboard.txt"
    try { rg -q -F "$expected" "$output/$label.clipboard.txt" }
    if (_error.code === 0) { setvar matched = true; break }
    sleep 0.2
  }
  if (not matched) { diagnose "$label"; cat "$output/$label.clipboard.txt"; exit 1 }
}
proc numbered(number, label) {
  "$adb" -s "$serial" shell am force-stop org.isomorphisms.aici.clipboardfixture
  "$adb" -s "$serial" shell am start -W -n "$fixture" --ei fixture_index "$number" > "$output/$label.fixture.txt"
  sleep 0.5
  tap 240 700
  "$adb" -s "$serial" logcat -c
  tap 240 790
  "$adb" -s "$serial" logcat -d -s CopyFixture:I > "$output/$label.clipboard.txt"
  rg -q -F 'visible button 8 SDK clipboard effect PASS' "$output/$label.clipboard.txt"
  var expected = 100 + int(number)
  rg -q -F "present=1 items=1 text=1 sensitive=0 exact fixture=$expected origin=0" "$output/$label.clipboard.txt"
  sleep 0.7
}

# The previous stage reboots the verified emulator. Restart only the official
# shell server, then explicitly re-enable the retained application mode.
var starter = "/data/local/tmp/pasteboard-shizuku-$api/start"
var manager_path = $("$adb" -s "$serial" shell pm path moe.shizuku.privileged.api | tr -d '\r' | sed -n 's/^package://p')
"$adb" -s "$serial" shell "$starter" "--apk=$manager_path" > "$output/server-restart.txt" 2>&1
sleep 3
start_app initial
menu 0
tap 240 747
sleep 4
snapshot reset-order-before
"$adb" -s "$serial" shell am start -W -n "$fixture" > "$output/reset-order.fixture.txt"
sleep 1
for row in @(seq 0 2) {
  "$adb" -s "$serial" logcat -c
  var y = 70 + int(row) * 90
  tap 240 "$y"
  "$adb" -s "$serial" logcat -d -s CopyFixture:I > "$output/reset-order-$row.clipboard.txt"
  rg -q -F "visible button $row SDK clipboard effect PASS" "$output/reset-order-$row.clipboard.txt"
  rg -q -F "present=1 items=1 text=1 sensitive=0 exact fixture=$row origin=0" "$output/reset-order-$row.clipboard.txt"
}
await_delivery reset-order "$output/reset-order-before.bin" 3
start_app spatial
await_state spatial board 1 4 "$input/fixtures/textC.txt" "$input/fixtures/textB.txt" "$input/fixtures/textA.txt" "$input/fixtures/long.txt"
diagnose three-board-layout

# Tap-to-copy must set the actual SDK clipboard without promoting the card.
tap 100 135
clipboard_readback copied 'present=1 items=1 text=1 sensitive=0 exact fixture=2 origin=1'
await_delivery copied "$output/spatial.bin" 1
"$oracle" board "$output/copied.bin" 1 4 "$input/fixtures/textC.txt" "$input/fixtures/textB.txt" "$input/fixtures/textA.txt" "$input/fixtures/long.txt"
start_app copy-long-card
tap 350 240
clipboard_readback copied-long 'present=1 items=1 text=1 sensitive=0 exact fixture=3 origin=1'
await_delivery copied-long "$output/copied.bin" 1
"$oracle" board "$output/copied-long.bin" 1 4 "$input/fixtures/textC.txt" "$input/fixtures/textB.txt" "$input/fixtures/textA.txt" "$input/fixtures/long.txt"
start_app move-left
"$adb" -s "$serial" shell input swipe 110 135 20 135 300
await_state moved-left entry "$input/fixtures/textC.txt" 0 0
"$adb" -s "$serial" shell input swipe 60 50 400 50 300
await_state selected-left board 0 4 "$input/fixtures/textC.txt"
"$adb" -s "$serial" shell input swipe 110 135 350 135 300
"$adb" -s "$serial" shell input swipe 400 50 60 50 300
await_state moved-back board 1 4 "$input/fixtures/textC.txt" "$input/fixtures/textB.txt" "$input/fixtures/textA.txt" "$input/fixtures/long.txt"
"$adb" -s "$serial" shell input swipe 400 50 60 50 300
await_state selected-right board 2 4
tap 110 135
snapshot empty-slot
cmp "$output/selected-right.bin" "$output/empty-slot.bin"
"$adb" -s "$serial" shell input swipe 60 50 400 50 300
printf 'real_tap_to_SDK_clipboard_and_own_copy_order\tPASS\ncard_swipe_between_adjacent_boards\tPASS\nheader_swipe_all_three_boards\tPASS\nempty_slot_tap_preserves_history\tPASS\n' > "$output/result.tsv"

card_menu 0
tap 240 291
card_menu 0
tap 240 443
tap 240 215
await_state protected-delete entry "$input/fixtures/textC.txt" 1 1
card_menu 0
tap 240 291
await_state before-pending-delete entry "$input/fixtures/textC.txt" 1 0
# Reproduce a crash-left pending file from history already captured through
# actual SDK copies. This does not insert an entry into the history model.
"$adb" -s "$serial" shell -T run-as "$package" tee files/history.pending.999999.1 \
  < "$output/before-pending-delete.bin" > "$output/interrupted-snapshot-seed.bin"
cmp "$output/before-pending-delete.bin" "$output/interrupted-snapshot-seed.bin"
"$adb" -s "$serial" shell -T run-as "$package" /system/bin/chmod 600 files/history.pending.999999.1
"$adb" -s "$serial" shell -T run-as "$package" /system/bin/ls -ld files/history.pending.999999.1 > "$output/interrupted-snapshot-mode.txt"
for number in @(seq 1 4) { card_menu 0; tap 240 443; tap 240 215 }
await_state deleted count 0
"$adb" -s "$serial" exec-out run-as "$package" cat files/history.previous > "$output/deleted-backup.bin"
for name in textA textB textC long {
  "$oracle" forgotten "$output/deleted.bin" "$input/fixtures/$name.txt"
  "$oracle" forgotten "$output/deleted-backup.bin" "$input/fixtures/$name.txt"
}
try { "$adb" -s "$serial" shell -T run-as "$package" /system/bin/ls -ld files/history.pending.999999.1 > "$output/deleted-pending.txt" 2>&1 }
var pending_result = _error.code
if (pending_result === 0) { diagnose pending-delete; echo 'FAIL deletion retained an interrupted snapshot' >&2; exit 1 }
rg -q -F 'No such file or directory' "$output/deleted-pending.txt"
printf 'visible_protect_and_confirmed_delete_controls\tPASS\nprotected_delete_refused\tPASS\nacknowledged_deletion_absent_from_current_and_recovery\tPASS\nacknowledged_deletion_retires_interrupted_snapshot\tPASS\n' >> "$output/result.tsv"

for number in @(seq 0 17) { numbered "$number" "overflow-$number" }
await_state overflow count 18
var visible = []
for number in @(seq 17 -1 2) { call visible->append("$input/fixtures/overflow-$number.txt") }
"$oracle" positions "$output/overflow.bin" 1 @visible
"$oracle" positions "$output/overflow.bin" archive "$input/fixtures/overflow-1.txt" "$input/fixtures/overflow-0.txt"
start_app protect-full-board
for index in @(seq 0 15) {
  card_menu "$index"
  tap 240 291
  var number = 17 - int(index)
  await_state "pin-$index" entry "$input/fixtures/overflow-$number.txt" 1 1
}
numbered 18 protected-overflow-18
numbered 19 protected-overflow-19
await_state protected-overflow count 20
"$oracle" positions "$output/protected-overflow.bin" 1 @visible
"$oracle" positions "$output/protected-overflow.bin" archive "$input/fixtures/overflow-19.txt" "$input/fixtures/overflow-18.txt" "$input/fixtures/overflow-1.txt" "$input/fixtures/overflow-0.txt"
start_app archive-controls
menu 3
card_menu 0
tap 240 291
tap 450 60
menu 6
tap 240 215
await_state archive-cleared count 17
"$oracle" entry "$output/archive-cleared.bin" "$input/fixtures/overflow-19.txt" archive 1
menu 3
card_menu 0
tap 240 367
await_state full-restore-refused entry "$input/fixtures/overflow-19.txt" archive 1
tap 450 60
card_menu 15
tap 240 291
menu 3
card_menu 0
tap 240 367
await_state restored entry "$input/fixtures/overflow-19.txt" 1 1
"$oracle" entry "$output/restored.bin" "$input/fixtures/overflow-2.txt" archive 0
tap 450 60
menu 6
tap 240 215
await_state final count 16
"$oracle" absent "$output/final.bin" "$input/fixtures/overflow-2.txt"
printf 'ordinary_overflow_archives_without_text_loss\tPASS\nall_protected_visible_positions_preserved\tPASS\nnew_capture_into_protected_board_archived\tPASS\narchive_clear_preserves_protected_text\tPASS\nrestore_into_protected_full_board_refused\tPASS\nrestore_evicts_only_unprotected_card\tPASS\nphysical_C67\tNOT_VERIFIED\nphysical_TAB_P10\tNOT_VERIFIED\n' >> "$output/result.tsv"
diagnose final
cat "$output/result.tsv"
