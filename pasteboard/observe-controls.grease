#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'requires ADB SERIAL API APK INDEPENDENT_INPUTS NEW_EVIDENCE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var api = ARGV[2]
var apk = ARGV[3]
var input = ARGV[4]
var output = ARGV[5]
if test -e "$output" { echo 'refusing reused control evidence' >&2; exit 2 }
mkdir -p "$output"
var grease = ENV.GREASE
"$grease" "$input/guards/observe-provenance.grease" "$input" "$apk" "$output"
var oracle = "$input/oracle/pasteboard-oracle"
var package = 'com.isomorphisms.pasteboard'
var component = 'com.isomorphisms.pasteboard/android.app.NativeActivity'
var fixture = 'org.isomorphisms.aici.clipboardfixture/android.app.NativeActivity'
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r' | rg -x -F "$api"
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
"$adb" -s "$serial" shell getprop ro.build.fingerprint > "$output/fingerprint.txt"
sha256sum "$apk" "$input/guards/controls.apk" "$input/guards/exposed-provider.apk" "$input/guards/uid-bypass.apk" "$input/guards/capability-bypass.apk" > "$output/sha256.txt"
cp "$input/observer-commit.txt" "$output/"
proc snapshot(label) {
  "$adb" -s "$serial" exec-out run-as "$package" cat files/history.v2 > "$output/$label.bin"
  "$oracle" validate "$output/$label.bin" > "$output/$label.integrity.txt"
  "$adb" -s "$serial" logcat -d -s PasteboardDiagnostic:I PasteboardObserver:I PasteboardHistory:I >> "$output/observer-boundary.logcat.txt"
}
proc tap(x, y) { "$adb" -s "$serial" shell input tap "$x" "$y"; sleep 0.4 }
proc start_app(label) {
  "$adb" -s "$serial" shell am start -W -n "$component" > "$output/$label.launch.txt"
  sleep 1
}
proc automatic(label) { start_app "$label"; tap 450 60; tap 240 215; tap 240 747; sleep 4 }
proc diagnose(label) {
  try { "$adb" -s "$serial" exec-out screencap -p > "$output/$label.png" }
  try { "$adb" -s "$serial" logcat -d -v threadtime > "$output/$label.logcat.txt" }
  try { "$adb" -s "$serial" shell ps -A -o USER,PID,NAME > "$output/$label.ps.txt" }
}
proc guard(phase, label, expected, result_code) {
  # Raw mode retains the exact result code even when the controller supplies
  # REPORT_KEY_STREAMRESULT; Android's pretty mode prints only that stream.
  "$adb" -s "$serial" shell am instrument -r -w -e phase "$phase" \
    org.isomorphisms.aici.pasteboardcontrols/acceptance.pasteboard.GuardControls > "$output/$label.txt" 2>&1
  "$adb" -s "$serial" logcat -d -s AndroidRuntime:E > "$output/$label.runtime.txt"
  try { rg -q -F "$expected" "$output/$label.txt" }
  if (_error.code !== 0) { diagnose "$label"; cat "$output/$label.txt"; exit 1 }
  try { rg -q -x -F "INSTRUMENTATION_CODE: $result_code" "$output/$label.txt" }
  if (_error.code !== 0) { diagnose "$label"; cat "$output/$label.txt"; exit 1 }
}
proc shell_capability(label, accepted) {
  # Synthetic invalid credential only. The real private key never enters a
  # command argument or receipt. Android's shell command retains actual UID
  # 2000 and exercises the real provider, not a history-model injection.
  "$adb" -s "$serial" shell content call --uri content://com.isomorphisms.pasteboard.shizuku \
    --method observer_heartbeat --arg zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz \
    > "$output/$label.txt" 2>&1
  # Execute the identical refusal requirement against positive and mutant.
  # A different failure (including a framework exception) cannot reject it.
  try { rg -q -x -F 'Result: Bundle[{accepted=-1}]' "$output/$label.txt" }
  var refusal_result = _error.code
  var required_result = 0
  if (int(accepted) === 1) { setvar required_result = 1 }
  if (refusal_result !== required_result) { diagnose "$label"; cat "$output/$label.txt"; exit 1 }
  printf 'required_refusal_assertion_exit\t%s\nexpected_assertion_exit\t%s\n' "$refusal_result" "$required_result" > "$output/$label.verdict.tsv"
  try { rg -q -x -F "Result: Bundle[{accepted=$accepted}]" "$output/$label.txt" }
  if (_error.code !== 0) { diagnose "$label"; cat "$output/$label.txt"; exit 1 }
}
proc copy_three(label) {
  snapshot "$label-before"
  "$adb" -s "$serial" shell am start -W -n "$fixture" > "$output/$label.fixture.txt"
  sleep 1
  for row in @(seq 0 2) {
    "$adb" -s "$serial" logcat -c
    var y = 70 + int(row) * 90
    tap 240 "$y"
    "$adb" -s "$serial" logcat -d -s CopyFixture:I > "$output/$label-$row.clipboard.txt"
    rg -q -F "visible button $row SDK clipboard effect PASS" "$output/$label-$row.clipboard.txt"
    rg -q -F "present=1 items=1 text=1 sensitive=0 exact fixture=$row origin=0" "$output/$label-$row.clipboard.txt"
  }
  var accepted = false
  for attempt in @(seq 1 30) {
    snapshot "$label-after"
    try { "$oracle" added-deliveries "$output/$label-before.bin" "$output/$label-after.bin" 3 > "$output/$label.deliveries.txt" }
    if (_error.code === 0) { setvar accepted = true; break }
    sleep 1
  }
  if (not accepted) { diagnose "$label"; echo 'FAIL lifecycle callback delivery' >&2; exit 1 }
  "$oracle" board "$output/$label-after.bin" 1 4 "$input/fixtures/textC.txt" "$input/fixtures/textB.txt" "$input/fixtures/textA.txt" "$input/fixtures/long.txt"
}
proc observer_pid(label) {
  "$adb" -s "$serial" shell ps -A -o USER,PID,NAME > "$output/$label.processes.txt"
  awk '$1 == "shell" && $3 ~ /:pasteboard_observer$/ {print $2}' "$output/$label.processes.txt"
}
proc manager_node(field, value, label) {
  var found = false
  for attempt in @(seq 1 15) {
    timeout 30s "$adb" -s "$serial" shell uiautomator dump /data/local/tmp/pasteboard-manager.xml > "$output/$label.dump.txt" 2>&1
    "$adb" -s "$serial" pull /data/local/tmp/pasteboard-manager.xml "$output/$label.xml" > "$output/$label.pull.txt"
    try { "$oracle" ui-point "$output/$label.xml" "$field" "$value" > "$output/$label.point.txt" }
    if (_error.code === 0) { setvar found = true; break }
    sleep 0.5
  }
  if (not found) { diagnose "$label"; echo 'FAIL actual manager control unavailable' >&2; exit 1 }
  var point = $(cat "$output/$label.point.txt")
  "$adb" -s "$serial" shell input tap @[split(point)]
  sleep 2
}
snapshot initial
"$oracle" count "$output/initial.bin" 4
"$oracle" mode "$output/initial.bin" 1 1
"$adb" -s "$serial" install -r "$input/guards/controls.apk" > "$output/controls-install.txt"
guard external external-positive 'PASS independent external provider caller refused by Android' -1
"$adb" -s "$serial" install -r "$input/guards/exposed-provider.apk" > "$output/exposed-install.txt"
start_app exposed-provider
guard external exposed-mutant 'FAIL external observer call not rejected by Android permission' 0
"$adb" -s "$serial" install -r "$apk" > "$output/restore-provider.txt"
automatic restored-provider
guard uid uid-positive 'PASS independent real application UID refused with a valid controlled capability' -1
"$adb" -s "$serial" install -r "$input/guards/uid-bypass.apk" > "$output/uid-mutant-install.txt"
automatic uid-mutant
guard uid uid-mutant 'FAIL unprivileged observer heartbeat accepted' 0
"$adb" -s "$serial" install -r "$apk" > "$output/restore-uid.txt"
automatic restored-uid
snapshot wrong-capability-before
shell_capability wrong-capability-positive -1
snapshot wrong-capability-after
cmp "$output/wrong-capability-before.bin" "$output/wrong-capability-after.bin"
"$adb" -s "$serial" install -r "$input/guards/capability-bypass.apk" > "$output/capability-mutant-install.txt"
automatic capability-mutant
shell_capability capability-mutant 1
"$adb" -s "$serial" install -r "$apk" > "$output/restore-capability.txt"
automatic restored-capability
shell_capability restored-capability -1
copy_three restored-callbacks
printf 'real_external_provider_caller_refused\tPASS\ncompiled_exposed_provider_mutant_rejected\tPASS\nreal_application_UID_with_valid_capability_refused\tPASS\ncompiled_UID_bypass_mutant_rejected\tPASS\nreal_shell_UID_with_wrong_capability_refused\tPASS\ncompiled_capability_bypass_mutant_rejected\tPASS\n' > "$output/result.tsv"

# A real SDK value copied during Pause must not appear when capture resumes.
# Leave that value on Android's clipboard across listener re-registration.
start_app pause
"$adb" -s "$serial" shell -T run-as "$package" sha256sum files/observer.key > "$output/capture-session-before.sha256"
tap 450 60
tap 240 367
tap 240 747
snapshot paused-before
"$oracle" mode "$output/paused-before.bin" 0 1
"$adb" -s "$serial" shell am force-stop org.isomorphisms.aici.clipboardfixture
"$adb" -s "$serial" shell am start -W -n "$fixture" --ei fixture_index 17 > "$output/paused.fixture.txt"
sleep 1
"$adb" -s "$serial" logcat -c
tap 240 790
"$adb" -s "$serial" logcat -d -s CopyFixture:I > "$output/paused.clipboard.txt"
rg -q -F 'visible button 8 SDK clipboard effect PASS' "$output/paused.clipboard.txt"
rg -q -F 'present=1 items=1 text=1 sensitive=0 exact fixture=117 origin=0' "$output/paused.clipboard.txt"
sleep 3
snapshot paused-after
cmp "$output/paused-before.bin" "$output/paused-after.bin"
start_app resume
tap 450 60
tap 240 367
tap 240 747
sleep 4
snapshot resumed
"$adb" -s "$serial" shell -T run-as "$package" sha256sum files/observer.key > "$output/capture-session-after.sha256"
if cmp -s "$output/capture-session-before.sha256" "$output/capture-session-after.sha256" {
  diagnose resume-session; echo 'FAIL resume retained the paused capture credential' >&2; exit 1
}
"$oracle" mode "$output/resumed.bin" 1 1
"$oracle" count "$output/resumed.bin" 4
"$oracle" absent "$output/resumed.bin" "$input/fixtures/overflow-17.txt"
copy_three after-pause-resume
printf 'pause_excludes_actual_external_clipboard_value\tPASS\nresume_rotates_private_capture_session\tPASS\nresume_does_not_replay_paused_values\tPASS\nresume_restores_exact_callback_delivery\tPASS\n' >> "$output/result.tsv"

# Kill only the verified emulator's exact shell-owned companion process.
var old_pid = $(observer_pid observer-before-crash)
printf '%s\n' "$old_pid" | rg -x '[1-9][0-9]*'
"$adb" -s "$serial" shell kill -9 "$old_pid"
start_app observer-reconnect
var restarted = false
for attempt in @(seq 1 40) {
  var new_pid = $(observer_pid observer-reconnect)
  if (new_pid !== '' and new_pid !== old_pid) { setvar restarted = true; break }
  sleep 1
}
if (not restarted) { diagnose observer-reconnect; echo 'FAIL observer did not reconnect after crash' >&2; exit 1 }
copy_three after-observer-crash
printf 'observer_crash_and_reconnection\tPASS\nreconnection_has_exactly_one_delivery_per_copy\tPASS\n' >> "$output/result.tsv"

# Use the real manager's authorization switch. A pm runtime-permission change
# alone does not revoke Shizuku's cached authorization record.
"$adb" -s "$serial" shell am start -W \
  -n moe.shizuku.privileged.api/moe.shizuku.manager.MainActivity > "$output/manager.launch.txt"
manager_node text 'Tap to manage authorized apps' manage-apps
manager_node text "$package" revoke
snapshot revoked-before
"$adb" -s "$serial" shell am start -W -n "$fixture" > "$output/revoked.fixture.txt"
sleep 1
tap 240 70
tap 240 160
tap 240 250
sleep 3
snapshot revoked-after
cmp "$output/revoked-before.bin" "$output/revoked-after.bin"
"$adb" -s "$serial" shell am start -W \
  -n moe.shizuku.privileged.api/moe.shizuku.manager.MainActivity > "$output/regrant-manager.launch.txt"
manager_node text "$package" regrant
automatic reauthorized
copy_three after-regrant
printf 'actual_manager_revocation_stops_capture\tPASS\nactual_manager_regrant_restores_capture\tPASS\n' >> "$output/result.tsv"

"$adb" -s "$serial" shell killall shizuku_server
sleep 3
snapshot disconnected-before
"$adb" -s "$serial" shell am start -W -n "$fixture" > "$output/disconnected.fixture.txt"
sleep 1
tap 240 70
tap 240 160
tap 240 250
sleep 2
start_app disconnected
snapshot disconnected-after
cmp "$output/disconnected-before.bin" "$output/disconnected-after.bin"
tap 450 60
tap 240 291
tap 240 747
"$adb" -s "$serial" shell am start -W -n "$fixture" > "$output/foreground.fixture.txt"
sleep 1
"$adb" -s "$serial" logcat -c
tap 240 70
"$adb" -s "$serial" logcat -d -s CopyFixture:I > "$output/foreground.clipboard.txt"
rg -q -F 'visible button 0 SDK clipboard effect PASS' "$output/foreground.clipboard.txt"
rg -q -F 'present=1 items=1 text=1 sensitive=0 exact fixture=0 origin=0' "$output/foreground.clipboard.txt"
start_app foreground-fallback
snapshot foreground-fallback
"$oracle" mode "$output/foreground-fallback.bin" 1 0
var foreground_retained = false
for attempt in @(seq 1 30) {
  snapshot foreground-fallback
  try { "$oracle" board "$output/foreground-fallback.bin" 1 4 "$input/fixtures/textA.txt" "$input/fixtures/textC.txt" "$input/fixtures/textB.txt" "$input/fixtures/long.txt" > "$output/foreground-fallback.order.txt" }
  if (_error.code === 0) { setvar foreground_retained = true; break }
  sleep 0.2
}
if (not foreground_retained) {
  diagnose foreground-fallback
  # Separate a focus-event failure from a focused SDK-read or model failure.
  # The original assertion remains failed even if this manual diagnostic works.
  tap 450 60
  tap 240 519
  tap 240 747
  sleep 2
  snapshot foreground-manual-diagnostic
  try { "$oracle" board "$output/foreground-manual-diagnostic.bin" 1 4 "$input/fixtures/textA.txt" "$input/fixtures/textC.txt" "$input/fixtures/textB.txt" "$input/fixtures/long.txt" > "$output/foreground-manual-diagnostic.order.txt" }
  diagnose foreground-manual-diagnostic
  echo 'FAIL exact foreground fallback after actual external copy' >&2
  exit 1
}
"$oracle" added-deliveries "$output/disconnected-after.bin" "$output/foreground-fallback.bin" 1
# Verify the visible manual control against the same real SDK value, after the
# focus capture has actually committed. A duplicate must retain its position.
tap 450 60
tap 240 519
tap 240 747
var manual_retained = false
for attempt in @(seq 1 30) {
  snapshot foreground-manual
  try { "$oracle" added-deliveries "$output/foreground-fallback.bin" "$output/foreground-manual.bin" 1 > "$output/foreground-manual.deliveries.txt" }
  if (_error.code === 0) { setvar manual_retained = true; break }
  sleep 0.2
}
if (not manual_retained) { diagnose foreground-manual; echo 'FAIL actual visible manual capture' >&2; exit 1 }
"$oracle" board "$output/foreground-manual.bin" 1 4 "$input/fixtures/textA.txt" "$input/fixtures/textC.txt" "$input/fixtures/textB.txt" "$input/fixtures/long.txt"
var starter = "/data/local/tmp/pasteboard-shizuku-$api/start"
var manager_path = $("$adb" -s "$serial" shell pm path moe.shizuku.privileged.api | tr -d '\r' | sed -n 's/^package://p')
"$adb" -s "$serial" shell "$starter" "--apk=$manager_path" > "$output/server-restart.txt" 2>&1
sleep 3
automatic server-restored
copy_three after-server-restored
printf 'server_disconnect_does_not_fabricate_automatic_history\tPASS\nexplicit_foreground_mode_still_operates\tPASS\nvisible_manual_capture_uses_actual_SDK_value\tPASS\nserver_restart_restores_authorized_observer\tPASS\n' >> "$output/result.tsv"

# Expiration belongs to Android 13+. Shorten the real framework timeout only in
# this verified emulator, then restore its prior DeviceConfig value.
if (int(api) >= 33) {
  var timeout_before = $("$adb" -s "$serial" shell device_config get clipboard auto_clear_timeout | tr -d '\r')
  "$adb" -s "$serial" shell device_config put clipboard auto_clear_timeout 1500
  "$adb" -s "$serial" shell am start -W -n "$fixture" > "$output/expiry.fixture.txt"
  sleep 1
  tap 240 70
  sleep 5
  "$adb" -s "$serial" logcat -c
  "$adb" -s "$serial" shell input keyevent HOME
  "$adb" -s "$serial" shell am start -W -n "$fixture" > "$output/expiry-readback.fixture.txt"
  sleep 1
  "$adb" -s "$serial" logcat -d -s CopyFixture:I > "$output/expiry.clipboard.txt"
  if (timeout_before === 'null') { "$adb" -s "$serial" shell device_config delete clipboard auto_clear_timeout } else { "$adb" -s "$serial" shell device_config put clipboard auto_clear_timeout "$timeout_before" }
  rg -q -F 'present=0 items=0 text=0 sensitive=0 exact fixture=-1 origin=0' "$output/expiry.clipboard.txt"
  snapshot expired
  "$oracle" count "$output/expired.bin" 4
  "$oracle" entry "$output/expired.bin" "$input/fixtures/textA.txt" 1 0
  printf 'framework_clipboard_expiration_preserves_history\tPASS\n' >> "$output/result.tsv"
} else { printf 'framework_auto_expiration\tNOT_APPLICABLE_API_29\n' >> "$output/result.tsv" }

snapshot before-reboot
"$adb" -s "$serial" reboot
"$adb" -s "$serial" wait-for-device
var booted = false
for attempt in @(seq 1 60) {
  var state = $("$adb" -s "$serial" shell getprop sys.boot_completed | tr -d '\r')
  if (state === '1') { setvar booted = true; break }
  sleep 1
}
if (not booted) { echo 'FAIL emulator did not reboot' >&2; exit 1 }
"$adb" -s "$serial" shell input keyevent 82
start_app after-reboot
snapshot after-reboot
cmp "$output/before-reboot.bin" "$output/after-reboot.bin"
printf 'device_restart_preserves_acknowledged_history\tPASS\nphysical_C67\tNOT_VERIFIED\nphysical_TAB_P10\tNOT_VERIFIED\n' >> "$output/result.tsv"
diagnose final
cat "$output/result.tsv"
