#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 9) { echo 'requires AICI INPUT SMALI BAKSMALI SDK KEYSTORE ADB SERIAL NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var smali = ARGV[2]
var baksmali = ARGV[3]
var sdk = ARGV[4]
var keystore = ARGV[5]
var adb = ARGV[6]
var serial = ARGV[7]
var evidence = ARGV[8]
var api = ENV.AICI_EXPECTED_ANDROID_API
if (api !== '29' and api !== '34') { exit 2 }
if test -e "$evidence" { echo 'FAIL reused lifecycle evidence' >&2; exit 2 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
test "$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')" = "$api"
printf '32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a  %s\n37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f  %s\n' "$smali" "$baksmali" | sha256sum -c -
sha256sum -c "$input/sha256.txt"
var controls = "$repository/dex/activity-lifecycle"
var tools = "$sdk/build-tools/35.0.0"
var certificate = 'de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9'
for package in org.isomorphisms.idric.lifecycle.qual org.isomorphisms.idric.lifecycle.oracle {
  "$adb" -s "$serial" shell pm list packages "$package" > "$evidence/$package.before.txt"
  if rg -x -F "package:$package" "$evidence/$package.before.txt" { echo 'FAIL lifecycle fixture namespace already installed' >&2; exit 1 }
}
java -jar "$smali" assemble "$controls/instrumentation" -o "$evidence/observer.dex"
proc package_dex(manifest, dex, directory) {
  mkdir -p "$directory"
  "$tools/aapt2" link -I "$sdk/platforms/android-34/android.jar" --manifest "$manifest" -o "$directory/base.apk"
  cp "$directory/base.apk" "$directory/unaligned.apk"
  cp "$dex" "$directory/classes.dex"
  forkwait {
    cd "$directory"
    zip -q unaligned.apk classes.dex
  }
  "$tools/zipalign" -f -p 4 "$directory/unaligned.apk" "$directory/aligned.apk"
  "$tools/apksigner" sign --ks "$keystore" --ks-key-alias wegert-debug \
    --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --out "$directory/fixture.apk" "$directory/aligned.apk"
  "$tools/apksigner" verify --print-certs "$directory/fixture.apk" > "$directory/signer.txt"
  rg -x -F "Signer #1 certificate SHA-256 digest: $certificate" "$directory/signer.txt"
  unzip -p "$directory/fixture.apk" classes.dex > "$directory/packaged.dex"
  cmp "$dex" "$directory/packaged.dex"
}
package_dex "$controls/oracle-manifest.xml" "$evidence/observer.dex" "$evidence/oracle"
"$adb" -s "$serial" install "$evidence/oracle/fixture.apk" > "$evidence/oracle/install.txt" 2>&1
rg -x -F Success "$evidence/oracle/install.txt"
var original_uid = ''
for lane in positive resume-mutant destroy-mutant recovery {
  var candidate_lane = lane
  if (lane === 'recovery') { setvar candidate_lane = 'positive' }
  var candidate = "$input/$candidate_lane/candidate.dex"
  var directory = "$evidence/$lane"
  mkdir -p "$directory"
  java -jar "$baksmali" disassemble "$candidate" -o "$directory/decoded"
  # Decode the candidate's actual bytes here; do not trust producer plan text.
  for event in onResume onDestroy {
    var checked = 'resume_lifecycle_reader'
    if (event === 'onDestroy') { setvar checked = 'destroy_lifecycle_reader' }
    awk -v event="$event" -v checked="$checked" '
      $0==".method public " event "()V" {inside=1; parent=0; source=0}
      inside && /invoke-super/ {
        if(index($0,"Landroid/app/Activity;->" event "()V")==0 || source!=0) exit 1
        parent++
      }
      inside && /invoke-static/ {
        if(index($0,"LIdric/Generated;->" checked "(Landroid/app/Activity;)V")==0 || parent!=1) exit 1
        source++
      }
      inside && $0==".end method" {if(parent!=1 || source!=1) exit 1; inside=0; seen++}
      END {if(seen!=1 || inside) exit 1}
    ' "$directory/decoded/Idric/Generated.smali"
  }
  package_dex "$controls/target-manifest.xml" "$candidate" "$directory"
  if (lane === 'positive') {
    "$adb" -s "$serial" install "$directory/fixture.apk" > "$directory/install.txt" 2>&1
  } else {
    "$adb" -s "$serial" install -r "$directory/fixture.apk" > "$directory/install.txt" 2>&1
  }
  rg -x -F Success "$directory/install.txt"
  var uid = $("$adb" -s "$serial" shell pm list packages -U org.isomorphisms.idric.lifecycle.qual | tr -d '\r')
  if (lane === 'positive') { setvar original_uid = uid }
  if (uid !== original_uid) { echo 'FAIL lifecycle replacement changed UID' >&2; exit 1 }
  var installed = $("$adb" -s "$serial" shell pm path org.isomorphisms.idric.lifecycle.qual | tr -d '\r' | sed -n 's/^package://p')
  printf '%s\n' "$installed" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
  "$adb" -s "$serial" pull "$installed" "$directory/installed.apk"
  cmp "$directory/fixture.apk" "$directory/installed.apk"
  "$adb" -s "$serial" shell am force-stop org.isomorphisms.idric.lifecycle.qual
  try {
    timeout 90 "$adb" -s "$serial" shell am instrument -w -r \
      org.isomorphisms.idric.lifecycle.oracle/acceptance.lifecycle.LifecycleInstrumentation > "$directory/runtime.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$directory/runtime.exit"
  cat "$directory/runtime.txt"
  "$adb" -s "$serial" logcat -d -v threadtime > "$directory/logcat.txt"
  if (status !== 0) { echo 'FAIL lifecycle observer process' >&2; exit 1 }
  if (lane === 'positive' or lane === 'recovery') {
    rg -x -F 'INSTRUMENTATION_CODE: -1' "$directory/runtime.txt"
    rg -x -F 'INSTRUMENTATION_RESULT: stream=PASS framework create resume destroy and return to the original checked Activity' "$directory/runtime.txt"
  } else {
    rg -x -F 'INSTRUMENTATION_CODE: 0' "$directory/runtime.txt"
    if (lane === 'resume-mutant') {
      rg -x -F 'INSTRUMENTATION_RESULT: stream=java.lang.AssertionError: FAIL checked onResume framework title' "$directory/runtime.txt"
    } else {
      rg -x -F 'INSTRUMENTATION_RESULT: stream=java.lang.AssertionError: FAIL checked onDestroy framework title' "$directory/runtime.txt"
    }
  }
  sha256sum "$candidate" "$directory/fixture.apk" "$directory/installed.apk" > "$directory/sha256.txt"
}
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$controls/instrumentation/LifecycleAction.smali" "$controls/instrumentation/LifecycleInstrumentation.smali" \
  "$controls/target-manifest.xml" "$controls/oracle-manifest.xml" "$evidence/observer.dex" > "$evidence/observer.sha256"
printf 'schema\tchecked-Activity-resume-destroy-v1\napi\t%s\nabi\tx86_64\nframework_automatic_lifecycle\tPASS\nsecond_Activity_and_original_return\tPASS\ncompiled_resume_mutant\tREJECTED\ncompiled_destroy_mutant\tREJECTED\nrecovery\tPASS\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
