#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'requires ROOT SOURCE ARTIFACTS SOURCE_SHA RUN_ID NEW_EVIDENCE' >&2; exit 2 }
var root = ARGV[0]
var source = ARGV[1]
var input = ARGV[2]
var revision = ARGV[3]
var run_id = ARGV[4]
var evidence = ARGV[5]
var android_home = ENV.ANDROID_HOME
test ! -e "$evidence"
mkdir -p "$evidence"
test "$(git -C "$source" rev-parse HEAD)" = "$revision"
curl --fail --location --retry 3 "https://api.github.com/repos/dilapidated-shed/tablature/actions/runs/$run_id" -o "$evidence/producer-run.json"
jq -e --arg revision "$revision" '.head_sha == $revision and .status == "completed" and .conclusion == "success" and .name == "Checked Idric core and signed Android candidates"' "$evidence/producer-run.json"
for abi in armeabi-v7a arm64-v8a x86_64 {
  var apk = "$input/android/chordreader-$abi.apk"
  var receipt = "$input/android/chordreader-$abi.receipt.tsv"
  rg -x -F "$(printf 'source_commit\t%s' "$revision")" "$receipt"
  rg -x -F "$(printf 'package\torg.isomorphisms.chordreader.dev')" "$receipt"
  rg -x -F "$(printf 'version_code\t1002')" "$receipt"
  var digest = $(sha256sum "$apk" | cut -d ' ' -f 1)
  rg -x -F "$(printf 'apk_sha256\t%s' "$digest")" "$receipt"
  "$android_home/build-tools/36.0.0/apksigner" verify --verbose --print-certs "$apk" > "$evidence/$abi.signer.txt"
  rg -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/$abi.signer.txt"
  "$android_home/build-tools/36.0.0/aapt2" dump badging "$apk" > "$evidence/$abi.badging.txt"
  rg -F "package: name='org.isomorphisms.chordreader.dev' versionCode='1002' versionName='0.2-dev'" "$evidence/$abi.badging.txt"
  unzip -p "$apk" assets/chordreader-pitch.dex > "$evidence/$abi.dex"
  cmp "$evidence/$abi.dex" "$input/exec/chordreader-pitch.dex"
  unzip -p "$apk" assets/music.lua > "$evidence/$abi.music.lua"
  cmp "$evidence/$abi.music.lua" "$source/contingency/managed-music.lua"
}
make -C "$root/.tools/dex" build/oracles/smali-3.0.10.jar build/oracles/baksmali-3.0.10.jar
sha256sum "$source/examples/autogenerated/chordreader/Music.idric" "$input/exec/chordreader-pitch.dex" "$input/exec/chordreader-mutant.dex" "$root/chordreader-managed/oracle/ChordReaderObserver.smali" "$root/chordreader-managed/observe.grease" > "$evidence/inputs.sha256"
printf 'source_commit\t%s\nproducer_run\t%s\nAPK_signer_identity\tPASS\nAPK_managed_asset_identity\tPASS\npackaged_music_transport_only\tPASS\n' "$revision" "$run_id" > "$evidence/receipt.tsv"
