"""Independent compilation, recapture, judgment and typed receipt admission."""
import sys
import os
import time
import subprocess
from pathlib import Path
from builtins import ValueError
import rhs_findings

SOURCE_PATH ∈ str ← "examples/autogenerated/behavior-evaluation/relation-observer.c"
CLAIMS ∈ dict[str, str] ← {"counts/bytes-elements": "The reported byte count equals element count times bytes per element.", "calls/count-order-effects": "The recorded calls follow the required order, with the declared count and effect delta.", "dimensions/scalar-vector": "The array explicitly encodes one real vector whose dimension equals the number of stored scalar coordinates.", "dimensions/row-vectors": "Each row of this rank-two array explicitly encodes a real vector with the declared dimension.", "transform/reflection": "For the recorded input and nonzero normal, the output is the Euclidean hyperplane reflection.", "transform/rotation": "The declared rational matrix is a proper Euclidean rotation and produces the recorded output.", "transform/linear": "The declared rational matrix applied to the recorded input produces the recorded output.", "repeat/idempotent": "After the first call, the second call preserves both the recorded state and serialized output.", "repeat/pure": "Both recorded calls preserve the input state and produce identical serialized output.", "serialization/state-canonical-int": "Two recorded calls advance integer state by the declared increment and serialize each state as canonical decimal UTF-8."}

def run(argv ∈ list[str], root ∈ str, destination ∈ str) → bytes:
    Path(destination).mkdir(parents=True, exist_ok=False)
    Path(destination + "/argv.txt").write_text(str("\n".join(argv)) + "\n")
    result ∈ object ← subprocess.run(argv, cwd=root, capture_output=True, timeout=120)
    Path(destination + "/stdout.bin").write_bytes(result.stdout)
    Path(destination + "/stderr.bin").write_bytes(result.stderr)
    code ∈ int ← result.returncode
    Path(destination + "/exit.txt").write_text(str(code) + "\n")
    if code != 0:
        raise ValueError("Independent required execution failed: " + argv[0])
    stdout ∈ bytes ← result.stdout
    return stdout

def accept(root ∈ str, evidence ∈ str, compiler ∈ str, compiler_source ∈ str) → None:
    destination ∈ str ← evidence + "/independent"
    Path(destination).mkdir(parents=True, exist_ok=False)
    revision ∈ str ← run(["git", "rev-parse", "HEAD"], root, destination + "/source-identity").decode().strip()
    origin ∈ str ← run(["git", "remote", "get-url", "origin"], root, destination + "/source-owner").decode().strip()
    if not (origin in ["https://github.com/dilapidated-shed/rhs.git", "https://github.com/dilapidated-shed/rhs", "git@github.com:dilapidated-shed/rhs.git"]):
        raise ValueError("Native evidence source repository owner mismatch")
    compiler_revision ∈ str ← run(["git", "rev-parse", "HEAD"], compiler_source, destination + "/compiler-source").decode().strip()
    if compiler_revision != "c61e448251744a2f40ad743ebef1a027bdcd2f9d":
        raise ValueError("Independent native acceptance requires pinned ICK")
    source ∈ bytes ← run(["git", "show", "HEAD:" + SOURCE_PATH], root, destination + "/committed-source")
    worktree_source ∈ bytes ← Path(root + "/" + SOURCE_PATH).read_bytes()
    if source != worktree_source:
        raise ValueError("Source bytes differ from the reviewed repository commit")
    copy ∈ str ← destination + "/relation-observer.c"
    Path(copy).write_bytes(source)
    groups ∈ list[list[str]] ← [["counts", "counts/bytes-elements"], ["calls", "calls/count-order-effects"], ["scalar", "dimensions/scalar-vector"], ["rows", "dimensions/row-vectors"], ["reflection", "transform/reflection"], ["rotation", "transform/rotation"], ["linear", "transform/linear"], ["idempotent", "repeat/idempotent"], ["pure", "repeat/pure"], ["serialization", "serialization/state-canonical-int"]]
    receipt ∈ list[str] ← ["case\toptimization\tindependent_status\tadmission\tobservation_sha256\tclaimed_binary_sha256\tindependent_binary_sha256"]
    witnessed ∈ int ← 0
    passed ∈ int ← 0
    previous ∈ dict[str, bytes] ← {}
    for optimization in ["-O0", "-O2"]:
        binary ∈ str ← destination + "/native" + optimization
        run([compiler, "-fno-link-libatomic", "-std=c11", "-Wall", "-Wextra", "-Wpedantic", optimization, copy, "-o", binary], root, destination + "/compile" + optimization)
        claimed_binary ∈ str ← evidence + "/native" + optimization
        claimed_binary_hash ∈ str ← rhs_findings.digest(Path(claimed_binary).read_bytes())
        independent_binary_hash ∈ str ← rhs_findings.digest(Path(binary).read_bytes())
        for group in groups:
            for mutant in [0, 1]:
                identifier ∈ str ← group[0] + "-" + str(mutant)
                observed ∈ bytes ← run([binary, group[0], str(mutant)], root, destination + "/" + optimization + "/" + identifier)
                claimed ∈ str ← evidence + "/cases" + optimization + "/" + identifier
                claimed_stdout ∈ bytes ← Path(claimed + "/stdout.bin").read_bytes()
                claimed_stderr ∈ bytes ← Path(claimed + "/stderr.bin").read_bytes()
                claimed_exit ∈ str ← Path(claimed + "/exit.txt").read_text()
                if observed != claimed_stdout or claimed_stderr != b"" or claimed_exit != "0\n":
                    raise ValueError("RHS execution evidence differs from independent native recapture")
                if identifier in previous and previous[identifier] != observed:
                    raise ValueError("Optimization changed native observations")
                previous[identifier] ← observed
                judgment ∈ str ← rhs_findings.decide(group[1], observed.decode())
                required ∈ str ← "agreement-tested"
                if mutant == 1:
                    required ← "contradiction"
                if judgment != required:
                    raise ValueError("Independent positive control or deliberate counterexample failed")
                claim ∈ str ← CLAIMS[group[1]]
                claimed_text ∈ str ← Path(claimed + "/claim.txt").read_text()
                if claimed_text != claim:
                    raise ValueError("Claim identity differs from the independent contract")
                execution ∈ bytes ← Path(claimed + "/execution.tsv").read_bytes()
                execution_fields ∈ dict[str, str] ← rhs_findings.rows(execution.decode())
                argv ∈ bytes ← Path(claimed + "/argv.txt").read_bytes()
                decoded_argv ∈ str ← argv.decode()
                expected_argv ∈ str ← claimed_binary + "\n" + group[0] + "\n" + str(mutant) + "\n"
                if decoded_argv != expected_argv or execution_fields["state"] != "completed" or execution_fields["exit"] != "0" or execution_fields["argv.sha256"] != str(rhs_findings.digest(argv)):
                    raise ValueError("Forged invocation or execution receipt")
                observation_hash ∈ str ← rhs_findings.digest(observed)
                stderr_hash ∈ str ← rhs_findings.digest(claimed_stderr)
                if execution_fields["binary.sha256"] != claimed_binary_hash or execution_fields["stdout.sha256"] != observation_hash or execution_fields["stderr.sha256"] != stderr_hash:
                    raise ValueError("Execution receipt hash mismatch")
                authority ∈ dict[str, str] ← {"source.repository": "dilapidated-shed/rhs", "source.commit": revision, "source.path": SOURCE_PATH, "source.sha256": str(rhs_findings.digest(source)), "claim.id": group[1], "claim.sha256": str(rhs_findings.digest(claim.encode())), "observation.encoding": "utf8-tsv", "observation.sha256": observation_hash, "execution.target": "Ubuntu/x86_64", "execution.actor": "native-process", "execution.id": identifier, "execution.scope": "supplied-native-observation", "binary.sha256": claimed_binary_hash, "stdout.sha256": observation_hash, "stderr.sha256": stderr_hash, "execution.sha256": str(rhs_findings.digest(execution)), "evidence.kind": "exact-observed", "relation": group[1]}
                fields ∈ dict[str, str] ← rhs_findings.rows(Path(claimed + "/finding.tsv").read_text())
                now ∈ int ← int(time.time())
                admission ∈ str ← rhs_findings.verify(fields, authority, judgment, now)
                if admission != "EXACT_OBSERVED":
                    raise ValueError("Native exact evidence was not admitted")
                # Forged status retains every original evidence hash. It must still fail.
                forged ∈ dict[str, str] ← fields.copy()
                forged["status"] ← "contradiction"
                if mutant == 1:
                    forged["status"] ← "agreement-tested"
                rejected ∈ bool ← False
                try:
                    rhs_findings.verify(forged, authority, judgment, now)
                except ValueError:
                    rejected ← True
                if not rejected:
                    raise ValueError("Real native receipt accepted a forged success/verdict")
                passed ← passed + 1
                if mutant == 1:
                    witnessed ← witnessed + 1
                receipt.append(identifier + "\t" + optimization + "\t" + judgment + "\t" + admission + "\t" + observation_hash + "\t" + claimed_binary_hash + "\t" + independent_binary_hash)
    if passed != 40 or witnessed != 20:
        raise ValueError("Incomplete independent native integration")
    Path(destination + "/acceptance.tsv").write_text(str("\n".join(receipt)) + "\n")
    cc1 ∈ str ← run([compiler, "-print-prog-name=cc1"], root, destination + "/compiler-frontend").decode().strip()
    Path(destination + "/compiler-hashes.tsv").write_text("ick_commit\t" + compiler_revision + "\ncompiler.sha256\t" + str(rhs_findings.digest(Path(compiler).read_bytes())) + "\ncc1.sha256\t" + str(rhs_findings.digest(Path(cc1).read_bytes())) + "\n")
    print("PASS 40 independently recaptured native cases, 20 counterexamples and 40 forged-verdict rejections; no universal or physical claim")

arguments ∈ list[str] ← sys.argv
environment ∈ dict[str, str] ← os.environ
accept(arguments[1], arguments[2], environment["ICK"], environment["ICK_SOURCE_ROOT"])
