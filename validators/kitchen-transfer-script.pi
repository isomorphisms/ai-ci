"""Retained CLI; independent observations, never child PASS text, decide."""
import sys
import json
import hashlib
import kitchen_transfer
import acceptance_state
from pathlib import Path
from builtins import dict, list, ValueError, Exception

argv ∈ list[str] ← sys.argv
if len(argv) != 6:
    raise ValueError("usage: kitchen-transfer-script.pi CONFIG OBSERVATIONS EXECUTION ARTIFACT RESULT")
result ∈ str ← argv[5]
acceptance_state.write(result, "PENDING", {"check_id": "kitchen-api-observation"})
try:
    config ∈ dict[str, object] ← json.loads(Path(argv[1]).read_bytes())
    raw_observations ∈ bytes ← Path(argv[2]).read_bytes()
    observed ∈ dict[str, object] ← json.loads(raw_observations)
    execution ∈ dict[str, object] ← json.loads(Path(argv[3]).read_bytes())
    artifact ∈ bytes ← Path(argv[4]).read_bytes()
    decision ∈ dict[str, object] ← kitchen_transfer.check(config, observed, execution, artifact)
    decision["observations_sha256"] ← hashlib.sha256(raw_observations).hexdigest()
    acceptance_state.write(result, "VERIFIED", decision)
except Exception as failure:
    acceptance_state.write(result, "FAILED", {"check_id": "kitchen-api-observation", "first_failure": str(failure)})
    raise
