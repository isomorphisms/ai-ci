"""Enforce actual output satisfaction using Flexible Pipes' artifact contract.

Transport observations must come from the trusted controller. This gate does
not attest arbitrary caller-provided files as real ChatGPT messages.
"""
import handoff
import hashlib
import json
import sys
import re
import io
import zipfile
from pathlib import Path
from builtins import dict, list, ValueError, KeyError, RuntimeError, OSError, isinstance

def check(stage ∈ dict[str, object], payload ∈ bytes, response ∈ bytes, complete ∈ bool) → None:
    record ∈ dict[str, object] ← handoff.identity(stage, payload)
    if int(record["version"]) != 1:
        raise ValueError("JOB-TRANSPORT")
    requested ∈ str ← handoff.validate_request(dict(record["request"]))
    mode ∈ str ← str(record["delivery_mode"])
    events ∈ list[dict[str, object]] ← list(record["events"])
    visible ∈ bool ← False
    dispatched ∈ bool ← False
    recovery ∈ bool ← False
    sequence ∈ int ← 0
    latest_response ∈ bytes ← b""
    for event in events:
        sequence ← sequence + 1
        if event["sequence"] != sequence or event["payload_sha256"] != record["payload_sha256"]:
            raise ValueError("JOB-EVENT-IDENTITY")
        kind ∈ str ← str(event["kind"])
        if kind == "delivery-failed":
            handoff.plain(event["correction"])
            visible ← False
            recovery ← True
        elif kind == "visible":
            if mode == "dispatch-only":
                raise ValueError("JOB-UNREQUESTED-SURFACE")
            captured ∈ bytes ← str(event["response_text"]).encode()
            if event["response_sha256"] != str(handoff.digest(captured)):
                raise ValueError("JOB-RESPONSE-IDENTITY")
            if bytes(handoff.extract(captured, payload)) != payload:
                raise ValueError("JOB-VISIBLE-IDENTITY")
            handoff.plain(event["message_id"])
            handoff.plain(event["surface"])
            visible ← True
            latest_response ← captured
        elif kind == "dispatch":
            if requested == "display-only":
                raise ValueError("JOB-UNAUTHORIZED-DISPATCH")
            if requested != "dispatch-only" and not visible:
                raise ValueError("JOB-DISPATCH-BEFORE-VISIBLE")
            if dispatched:
                raise ValueError("JOB-DUPLICATE-DISPATCH")
            handoff.plain(event["dispatch_id"])
            dispatched ← True
        else:
            raise ValueError("JOB-UNKNOWN-EVENT")
    if mode != requested:
        if not recovery or mode != "display-only" or not dispatched:
            raise ValueError("JOB-MODE-IDENTITY")
    request ∈ dict[str, object] ← dict(record["request"])
    text ∈ str ← str(request["text"]).lower().replace("’", "'")
    if bool(re.search(r"where(?:'s| is| is the| was).*\b(?:text|job|assignment)\b", text)) and not recovery:
        raise ValueError("JOB-RECOVERY-CONTEXT-MISSING")
    if mode != "dispatch-only":
        if not visible or record["visible_state"] != "OBSERVED":
            raise ValueError("JOB-VISIBLE-MISSING")
        if bytes(handoff.extract(response, payload)) != payload:
            raise ValueError("JOB-VISIBLE-IDENTITY")
        if latest_response != response:
            raise ValueError("JOB-RESPONSE-IDENTITY")
    elif response != b"" or record["visible_state"] != "NOT_REQUESTED":
        raise ValueError("JOB-DISPATCH-ONLY-SURFACE")
    if complete and requested != "display-only":
        if not dispatched or record["dispatch_state"] != "ACCEPTED":
            raise ValueError("JOB-DISPATCH-MISSING")
    if record["dispatch_state"] == "ACCEPTED" and not dispatched:
        raise ValueError("JOB-DISPATCH-UNOBSERVED")
    if requested == "display-only" and record["dispatch_state"] != "NOT_REQUESTED":
        raise ValueError("JOB-UNAUTHORIZED-DISPATCH")

def check_attachment(stage ∈ dict[str, object], source ∈ bytes, complete ∈ bool) → None:
    record ∈ dict[str, object] ← handoff.identity(stage, source)
    if int(record["version"]) != 2 or str(record.get("transport")) != "attachment":
        raise ValueError("JOB-TRANSPORT")
    payload ∈ bytes ← handoff.materialize(stage, source)
    attachment ∈ dict[str, object] ← dict(record["attachment"])
    requested ∈ str ← handoff.validate_request(dict(record["request"]))
    mode ∈ str ← str(record["delivery_mode"])
    events ∈ list[dict[str, object]] ← list(record["events"])
    visible ∈ bool ← False
    dispatched ∈ bool ← False
    recovery ∈ bool ← False
    sequence ∈ int ← 0
    for event in events:
        sequence ← sequence + 1
        if int(event["sequence"]) != sequence or str(event["payload_sha256"]) != str(record["payload_sha256"]):
            raise ValueError("JOB-EVENT-IDENTITY")
        kind ∈ str ← str(event["kind"])
        if kind == "delivery-failed":
            handoff.plain(event["correction"])
            visible ← False
            recovery ← True
        elif kind == "attachment":
            if mode == "dispatch-only":
                raise ValueError("JOB-UNREQUESTED-SURFACE")
            if visible:
                raise ValueError("JOB-DUPLICATE-ATTACHMENT")
            if int(event["payload_size"]) != len(payload):
                raise ValueError("JOB-ATTACHMENT-IDENTITY")
            if str(event["file_name"]) != str(attachment["file_name"]):
                raise ValueError("JOB-ATTACHMENT-NAME")
            if str(event["mime_type"]) != str(attachment["mime_type"]):
                raise ValueError("JOB-ATTACHMENT-MIME")
            handoff.plain(event["file_id"])
            handoff.plain(event["surface"])
            visible ← True
        elif kind == "dispatch":
            if requested == "display-only":
                raise ValueError("JOB-UNAUTHORIZED-DISPATCH")
            if requested != "dispatch-only" and not visible:
                raise ValueError("JOB-DISPATCH-BEFORE-VISIBLE")
            if dispatched:
                raise ValueError("JOB-DUPLICATE-DISPATCH")
            handoff.plain(event["dispatch_id"])
            dispatched ← True
        else:
            raise ValueError("JOB-UNKNOWN-EVENT")
    if mode != requested:
        if not recovery or mode != "display-only" or not dispatched:
            raise ValueError("JOB-MODE-IDENTITY")
    if mode != "dispatch-only":
        if not visible or record["visible_state"] != "OBSERVED":
            raise ValueError("JOB-VISIBLE-MISSING")
    elif record["visible_state"] != "NOT_REQUESTED":
        raise ValueError("JOB-DISPATCH-ONLY-SURFACE")
    if complete and requested != "display-only":
        if not dispatched or record["dispatch_state"] != "ACCEPTED":
            raise ValueError("JOB-DISPATCH-MISSING")
    if record["dispatch_state"] == "ACCEPTED" and not dispatched:
        raise ValueError("JOB-DISPATCH-UNOBSERVED")
    if requested == "display-only" and record["dispatch_state"] != "NOT_REQUESTED":
        raise ValueError("JOB-UNAUTHORIZED-DISPATCH")

def check_authority(stage ∈ dict[str, object], source ∈ bytes, expected ∈ dict[str, object], required_text ∈ list[str]) → None:
    """Compare with the supervisor's admission, not a worker's recomputed hashes."""
    record ∈ dict[str, object] ← handoff.identity(stage, source)
    handoff.validate_spec(expected)
    for field in ["audience", "model", "source_context", "execution_target", "request", "attachment"]:
        observed_value ∈ str ← json.dumps(record.get(field), sort_keys=True)
        expected_value ∈ str ← json.dumps(expected.get(field), sort_keys=True)
        if observed_value != expected_value:
            raise ValueError("JOB-AUTHORITY-" + str(field.upper().replace("_", "-")))
    if int(record["version"]) == 1:
        text ∈ str ← source.decode("utf-8")
        for requirement in required_text:
            if not isinstance(requirement, str) or requirement == "" or not text.__contains__(requirement):
                raise ValueError("JOB-CORRECTION-MISSING")
    elif len(required_text) != 0:
        raise ValueError("JOB-BINARY-TEXT-REQUIREMENT")

def reference_attachment(source ∈ bytes, attachment ∈ dict[str, object]) → bytes:
    """Independent byte oracle: do not call the producer's extractor."""
    limit ∈ int ← 134217728
    if len(source) == 0 or len(source) > limit or str(hashlib.sha256(source).hexdigest()) != str(attachment["source_sha256"]):
        raise ValueError("JOB-SOURCE-BYTES")
    name ∈ str ← str(attachment["file_name"])
    if name == "" or name == "." or name == ".." or name.__contains__("/") or name.__contains__("\\"):
        raise ValueError("JOB-SOURCE-NAME")
    selected ∈ bytes ← source
    if attachment.__contains__("archive_member"):
        member ∈ str ← str(attachment["archive_member"])
        parts ∈ list[str] ← member.split("/")
        if member.startswith("/") or member.__contains__("\\") or parts.__contains__("") or parts.__contains__(".") or parts.__contains__("..") or parts[-1] != name:
            raise ValueError("JOB-SOURCE-MEMBER")
        try:
            archive ∈ object ← zipfile.ZipFile(io.BytesIO(source), "r")
            matches ∈ list[object] ← []
            entries ∈ list[object] ← list(archive.infolist())
            for entry in entries:
                if str(entry.filename) == member:
                    matches.append(entry)
            if len(matches) != 1 or matches[0].is_dir() or int(matches[0].flag_bits) & 1 != 0 or int(matches[0].file_size) <= 0 or int(matches[0].file_size) > limit:
                raise ValueError("JOB-SOURCE-MEMBER")
            selected ← archive.read(matches[0])
            archive.close()
        except (zipfile.BadZipFile, KeyError, RuntimeError, OSError):
            raise ValueError("JOB-SOURCE-ARCHIVE")
    elif str(attachment["source_name"]) != name:
        raise ValueError("JOB-SOURCE-NAME")
    if len(selected) == 0 or len(selected) > limit or str(hashlib.sha256(selected).hexdigest()) != str(attachment["sha256"]):
        raise ValueError("JOB-SOURCE-PAYLOAD")
    return selected

def check_actual(stage ∈ dict[str, object], source ∈ bytes, delivered ∈ bytes, metadata ∈ dict[str, object], expected ∈ dict[str, object], required_text ∈ list[str], complete ∈ bool) → None:
    """Inspect delivered bytes. This does not authenticate arbitrary input files."""
    check_authority(stage, source, expected, required_text)
    evidence ∈ str ← str(metadata.get("evidence_class", ""))
    # No deployed platform verifier exists. A caller cannot enable one with a
    # string, file ID, signature made by that caller, or 'trusted=true'.
    if evidence != "fixture" and evidence != "service-readback":
        raise ValueError("JOB-PLATFORM-ADAPTER-UNAVAILABLE")
    record ∈ dict[str, object] ← dict(stage["handoff"])
    events ∈ list[dict[str, object]] ← list(record["events"])
    latest ∈ dict[str, object] ← {}
    for event in events:
        if str(event["kind"]) == "visible" or str(event["kind"]) == "attachment":
            latest ← event
        elif str(event["kind"]) == "delivery-failed":
            latest ← {}
    if int(record["version"]) == 1:
        check(stage, source, delivered, complete)
        if str(record["delivery_mode"]) != "dispatch-only":
            if str(latest.get("message_id")) != str(metadata.get("message_id")) or str(latest.get("surface")) != str(metadata.get("surface")):
                raise ValueError("JOB-READBACK-MESSAGE")
    else:
        check_attachment(stage, source, complete)
        selected ∈ bytes ← reference_attachment(source, dict(record["attachment"]))
        if str(record["delivery_mode"]) != "dispatch-only":
            if delivered != selected:
                raise ValueError("JOB-READBACK-BYTES")
            attachment ∈ dict[str, object] ← dict(record["attachment"])
            if str(metadata.get("file_name")) != str(attachment["file_name"]) or str(metadata.get("mime_type")) != str(attachment["mime_type"]):
                raise ValueError("JOB-READBACK-METADATA")
            if str(latest.get("file_id")) != str(metadata.get("file_id")) or str(latest.get("surface")) != str(metadata.get("surface")):
                raise ValueError("JOB-READBACK-FILE")

def main() → None:
    args ∈ list[str] ← sys.argv
    if len(args) == 8 and args[1] == "actual":
        stage ∈ dict[str, object] ← json.loads(Path(args[2]).read_bytes())
        source ∈ bytes ← Path(args[3]).read_bytes()
        delivered ∈ bytes ← Path(args[4]).read_bytes()
        metadata ∈ dict[str, object] ← json.loads(Path(args[5]).read_bytes())
        admission ∈ dict[str, object] ← json.loads(Path(args[6]).read_bytes())
        expected ∈ dict[str, object] ← dict(admission["spec"])
        required ∈ list[str] ← []
        if admission.__contains__("required_text"):
            required ← list(admission["required_text"])
        check_actual(stage, source, delivered, metadata, expected, required, True)
        result ∈ dict[str, object] ← {"status": "CONTRACT_PASS", "platform_delivery_status": "NOT_VERIFIED", "evidence_class": metadata["evidence_class"], "stage_sha256": hashlib.sha256(Path(args[2]).read_bytes()).hexdigest(), "source_sha256": hashlib.sha256(source).hexdigest(), "delivered_sha256": hashlib.sha256(delivered).hexdigest(), "admission_sha256": hashlib.sha256(Path(args[6]).read_bytes()).hexdigest()}
        Path(args[7]).write_text(str(json.dumps(result, sort_keys=True)) + "\n")
        return
    if len(args) != 5:
        raise ValueError("usage: job_delivery.pi STAGE_JSON PAYLOAD RESPONSE RESULT")
    stage ∈ dict[str, object] ← json.loads(Path(args[1]).read_bytes())
    payload ∈ bytes ← Path(args[2]).read_bytes()
    response ∈ bytes ← Path(args[3]).read_bytes()
    record ∈ dict[str, object] ← handoff.identity(stage, payload)
    if int(record["version"]) == 2:
        if response != b"":
            raise ValueError("JOB-ATTACHMENT-LINK-SUBSTITUTE")
        check_attachment(stage, payload, True)
    else:
        check(stage, payload, response, True)
    encoded ∈ str ← json.dumps({"status": "PASS", "check_id": "job-delivery-v2", "stage_sha256": handoff.digest(Path(args[1]).read_bytes()), "payload_sha256": str(record["payload_sha256"]), "response_sha256": handoff.digest(response)}, sort_keys=True)
    Path(args[4]).write_text(encoded + "\n")
