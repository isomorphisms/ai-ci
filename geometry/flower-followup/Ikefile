# AI-CI owns the independent verdicts. Ike executes every recipe through the
# absolute Grease runner supplied by Flexible Pipes; each recipe then enters
# Kitchen's checked absolute-path adapter before Ithon runs an oracle.
accept depends on stitch metric topology realization
stitch depends on
    env ITHON_CHECK_RECEIPT="$FLOWER_WORKSPACE/build/ike-stitch-self-test-frontend.json" "$FLOWER_GREASE" "$FLOWER_KITCHEN_RECIPE" "$FLOWER_ITHON" "$FLOWER_STITCH_CHECKER" --self-test
    env ITHON_CHECK_RECEIPT="$FLOWER_WORKSPACE/build/ike-increasing-frontend.json" "$FLOWER_GREASE" "$FLOWER_KITCHEN_RECIPE" "$FLOWER_ITHON" "$FLOWER_STITCH_CHECKER" "$FLOWER_WORKSPACE/build" increasing "$FLOWER_WORKSPACE/build/flower-stitch-test"
    env ITHON_CHECK_RECEIPT="$FLOWER_WORKSPACE/build/ike-control-frontend.json" "$FLOWER_GREASE" "$FLOWER_KITCHEN_RECIPE" "$FLOWER_ITHON" "$FLOWER_STITCH_CHECKER" "$FLOWER_WORKSPACE/build" control "$FLOWER_WORKSPACE/build/flower-stitch-test"
metric depends on
    env ITHON_CHECK_RECEIPT="$FLOWER_WORKSPACE/build/ike-metric-frontend.json" "$FLOWER_GREASE" "$FLOWER_KITCHEN_RECIPE" "$FLOWER_ITHON" "$FLOWER_METRIC_CHECKER" "$FLOWER_WORKSPACE/build/metric.tsv" --self-test
topology depends on
    env ITHON_CHECK_RECEIPT="$FLOWER_WORKSPACE/build/ike-topology-self-test-frontend.json" "$FLOWER_GREASE" "$FLOWER_KITCHEN_RECIPE" "$FLOWER_ITHON" "$FLOWER_TOPOLOGY_CHECKER" --self-test
    env ITHON_CHECK_RECEIPT="$FLOWER_WORKSPACE/build/ike-coarse-topology-frontend.json" "$FLOWER_GREASE" "$FLOWER_KITCHEN_RECIPE" "$FLOWER_ITHON" "$FLOWER_TOPOLOGY_CHECKER" "$FLOWER_WORKSPACE/build/mesh.obj" annulus
    env ITHON_CHECK_RECEIPT="$FLOWER_WORKSPACE/build/ike-fine-topology-frontend.json" "$FLOWER_GREASE" "$FLOWER_KITCHEN_RECIPE" "$FLOWER_ITHON" "$FLOWER_TOPOLOGY_CHECKER" "$FLOWER_WORKSPACE/build/mesh-fine.obj" annulus
realization depends on
    env ITHON_CHECK_RECEIPT="$FLOWER_WORKSPACE/build/ike-realization-frontend.json" "$FLOWER_GREASE" "$FLOWER_KITCHEN_RECIPE" "$FLOWER_ITHON" "$FLOWER_REALIZATION_CHECKER" "$FLOWER_WORKSPACE/build/markers.tsv" "$FLOWER_WORKSPACE/build/mesh.obj" "$FLOWER_WORKSPACE/build/mesh-fine.obj" "$FLOWER_WORKSPACE/build/material-edges.tsv"
