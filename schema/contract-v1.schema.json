{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isomorphisms/ai-ci/schema/contract-v1.schema.json",
  "title": "AI CI acceptance contract version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "required_checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "artifact_required"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
          },
          "artifact_required": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
