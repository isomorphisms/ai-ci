module Accept

import Data.List
import Data.List1
import Data.Text
import System
import System.File

record Candidate where
  constructor Observe
  executable : Text
  materials : Text
  work_directory : Text

record Observation where
  constructor Observed
  process_status : Int
  standard_output : Text

covering
capture : List Text → IO Observation
capture command = do
  opened ← Escaped.popen command Read
  case opened of
    Left error ⇒ die ("cannot launch acceptance process: " ++ show error)
    Right stream ⇒ do
      contents ← fRead stream
      status ← pclose stream
      case contents of
        Left error ⇒ die ("cannot read acceptance process: " ++ show error)
        Right output ⇒ pure (Observed status output)

require : Text → Bool → IO ()
require name True = putStrLn ("PASS\t" ++ name)
require name False = die ("FAIL\t" ++ name)

write_required : Text → Text → IO ()
write_required destination contents = do
  result ← writeFile destination contents
  case result of
    Left error ⇒ die ("cannot write acceptance input: " ++ show error)
    Right () ⇒ pure ()

covering
read_required : Text → IO Text
read_required source = do
  result ← readFile source
  case result of
    Left error ⇒ die ("cannot read acceptance output: " ++ show error)
    Right contents ⇒ pure contents

covering
isolated_candidate : Text → Text → IO Candidate
isolated_candidate executable materials = do
  created ← capture ["mktemp", "-d", "/tmp/yente-aici-XXXXXX"]
  case lines created.standard_output of
    [directory] ⇒ do
      require "isolated acceptance directory" (created.process_status ≟ 0 && isPrefixOf "/tmp/yente-aici-" directory)
      pure (Observe executable materials directory)
    _ ⇒ die "FAIL\tmalformed temporary directory response"

covering
script : Candidate → Text → Text → IO Observation
script candidate name commands = do
  let command_file = candidate.work_directory ++ "/" ++ name ++ ".commands.tsv"
      state_root = candidate.work_directory ++ "/" ++ name ++ ".state"
  write_required command_file commands
  capture [candidate.executable, "script", state_root, candidate.materials, command_file]

exact_line : Text → Text → Bool
exact_line expected output = length (filter (≟ expected) (lines output)) ≟ 1

has_text : Text → Text → Bool
has_text needle haystack = isInfixOf needle haystack

joined : List Text → Text
joined commands = concat (intersperse "\n" commands) ++ "\n"

framed_row : List Text → Text
framed_row values = concat (map (\value ⇒ show (length (unpack value)) ++ ":" ++ value) values)

setup : Text
setup = joined
  [ "person\tAri"
  , "person\tZev"
  , "person\tMira"
  , "person\tFen"
  , "session\tprivateA\tpartner\tAri\tAri\tunderstand expectations"
  , "session\tprivateB\tpartner\tZev\tZev\tunderstand expectations"
  , "session\tparentA\tparent\tAri\tMira\tfamily participation"
  , "session\tfriendA\tfriend\tAri\tFen\tfirsthand observations"
  , "session\tsharedAB\tshared\tAri\tAri,Zev\tcompare authorized proposals"
  , "consent\tprivateA\tyes\tyes"
  , "consent\tprivateB\tyes\tyes"
  , "consent\tparentA\tyes\tyes"
  , "consent\tfriendA\tyes\tyes"
  , "consent\tsharedAB\tyes\tyes"
  , "topic\tprivateA\tfamily_visits"
  , "topic\tprivateB\tfamily_visits"
  , "topic\tparentA\tfamily_visits"
  , "topic\tfriendA\tfamily_visits"
  , "topic\tsharedAB\tfamily_visits"
  ]

covering
successful_script : Candidate → Text → Text → IO Text
successful_script candidate name commands = do
  observed ← script candidate name commands
  require (name ++ " process status") (observed.process_status ≟ 0)
  pure observed.standard_output

covering
check_accounts : Candidate → IO ()
check_accounts candidate = do
  output ← successful_script candidate "accounts" (setup ++ joined
    [ "say\tprivateA\tAri\treport\t2025-03-02\t2025-03-05\tI visited my aunt on Sunday."
    , "say\tprivateA\tAri\twish\t-\t2025-03-05\tI want a quiet home."
    , "say\tprivateA\tAri\thypothetical\t-\t2025-03-05\tI imagine I would share my savings."
    , "say\tprivateA\tAri\thearsay\t-\t2025-03-05\tA friend says Zev is dependable."
    , "say\tprivateA\tAri\tagreement-report\t-\t2025-03-05\tI think we agreed about visits."
    , "show\tprivateA"
    ])
  require "novel people and retained report identity" (exact_line "OK\tsay\tprivateA-e1" output)
  require "distinct report and event dates" (has_text "2025-03-02" output && has_text "2025-03-05" output)
  require "account kinds preserved" (all (\kind ⇒ has_text kind output)
    ["report", "wish", "hypothetical", "hearsay", "agreement-report"])
  require "hypothetical keeps its original passage" (has_text "I imagine I would share my savings." output)

covering
check_correction : Candidate → IO ()
check_correction candidate = do
  output ← successful_script candidate "correction" (setup ++ joined
    [ "say\tprivateA\tAri\treport\t2025-04-01\t2025-04-02\tI visit because my family requires it."
    , "say\tprivateA\tAri\treport\t2025-04-01\t2025-04-02\tI sometimes feel squeezed between plans."
    , "hypothesis\tprivateA\tpressure\tprivateA-e1\t-\tfamily-pressure-root"
    , "hypothesis\tprivateA\tobedience\tprivateA-e2\tpressure\tobedience-dependent"
    , "hypothesis\tprivateA\tresentment\tprivateA-e2\tobedience\tresentment-grandchild"
    , "say\tprivateB\tZev\treport\t2025-04-01\t2025-04-02\tI enjoy our shared meals."
    , "correct\tprivateA\tAri\tprivateA-e1\treport\t2025-04-01\t2025-04-03\tI enjoy visiting; they exert no pressure."
    , "show\tprivateA"
    ])
  require "correction creates a separately attributed replacement" (exact_line "OK\tcorrect\tprivateA-e3" output)
  require "transitive hypotheses withdrawn" (not (any (\claim ⇒ has_text claim output)
    ["family-pressure-root", "obedience-dependent", "resentment-grandchild"]))
  journal ← read_required (candidate.work_directory ++ "/correction.state/journal.tsv")
  require "original episode and correction retained in audit journal"
    (has_text "I visit because my family requires it." journal &&
     has_text "correct\tprivateA\tAri\tprivateA-e1" journal)
  require "replacement account retained" (has_text "I enjoy visiting; they exert no pressure." output)
  require "independent support survives transitive withdrawal"
    (has_text "I sometimes feel squeezed between plans." output)
  resumed ← successful_script candidate "correction" "show\tprivateA\nshow\tprivateB\n"
  require "restart preserves correction and unrelated evidence"
    (has_text "I enjoy visiting; they exert no pressure." resumed &&
     has_text "I enjoy our shared meals." resumed &&
     not (any (\claim ⇒ has_text claim resumed) ["family-pressure-root", "obedience-dependent", "resentment-grandchild"]))

covering
check_boundaries : Candidate → IO ()
check_boundaries candidate = do
  output ← successful_script candidate "boundaries" (setup ++ joined
    [ "say\tprivateA\tAri\treport\t-\tnow\tVisible account."
    , "say\tprivateB\tZev\treport\t-\tnow\tSecret from another session."
    , "hypothesis\tprivateA\tcross\tprivateB-e1\t-\tshould-not-enter"
    , "say\tprivateA\tMira\treport\t-\tnow\tI can speak for Ari."
    , "correct\tprivateA\tZev\tprivateA-e1\treport\t-\tnow\tI changed Ari's words."
    , "say\tprivateA\tAri\tnot-a-kind\t-\tnow\tInvalid kind."
    , "hypothesis\tprivateA\tcycle\tprivateA-e1\tcycle\tself-cycle"
    , "show\tprivateA"
    ])
  require "cross-session support rejected"
    (exact_line "ERR\thypothesis\tforbidden: hypothesis evidence outside current context" output)
  require "hypothesis self-dependency rejected"
    (exact_line "ERR\thypothesis\tforbidden: hypothesis dependency outside current context" output)
  require "outside speaker rejected"
    (exact_line "ERR\tsay\tforbidden: speaker outside session" output)
  require "another speaker cannot overwrite account" (has_text "ERR\tcorrect\t" output)
  require "rejected material never enters visible context"
    (not (any (\text ⇒ has_text text output)
      ["should-not-enter", "self-cycle", "Secret from another session.", "I can speak for Ari.", "I changed Ari's words."]))
  require "valid account survives rejected commands" (has_text "Visible account." output)

covering
check_agreement : Candidate → IO ()
check_agreement candidate = do
  output ← successful_script candidate "agreement" (setup ++ joined
    [ "agreement\tsharedAB\tAri\tvisits\tAri,Zev\tWe will visit once a month."
    , "confirm\tMira\tvisits\t1\tWe will visit once a month."
    , "confirm\tAri\tvisits\t1\tWe will visit once a month."
    , "confirm\tAri\tvisits\t1\tWe will visit once a month."
    , "show\tsharedAB"
    ])
  require "agreement proposal accepted" (exact_line "OK\tagreement\tvisits" output)
  require "parent cannot confirm for participant" (has_text "ERR\tconfirm\t" output)
  require "duplicate participant confirmation leaves agreement pending"
    (has_text (framed_row ["agreement", "visits", "1", "We will visit once a month.", "Ari,Zev", "Ari", "pending"]) output)
  completed ← successful_script candidate "agreement" (joined
    [ "confirm\tZev\tvisits\t2\tWe will visit once a month."
    , "confirm\tZev\tvisits\t1\tWe will visit twice a month."
    , "confirm\tZev\tvisits\t1\tWe will visit once a month."
    , "show\tsharedAB"
    ])
  require "stale and text-mismatched confirmations rejected"
    (length (filter (isPrefixOf "ERR\tconfirm\t") (lines completed)) ≟ 2)
  require "distinct participants confirm exact agreement"
    (has_text (framed_row ["agreement", "visits", "1", "We will visit once a month.", "Ari,Zev", "Ari,Zev", "confirmed"]) completed)
  edited ← successful_script candidate "agreement" (joined
    [ "agreement-edit\tAri\tvisits\t1\tWe will visit twice a month."
    , "confirm\tZev\tvisits\t1\tWe will visit once a month."
    , "show\tsharedAB"
    ])
  require "agreement edit withdraws previous confirmations"
    (has_text (framed_row ["agreement", "visits", "2", "We will visit twice a month.", "Ari,Zev", "", "pending"]) edited &&
     has_text "ERR\tconfirm\t" edited)

covering
check_disclosure : Candidate → IO ()
check_disclosure candidate = do
  output ← successful_script candidate "disclosure" (setup ++ joined
    [ "proposal\tprivateA\tAri\tvisits\tZev\tprivateB\tI prefer visits once a month."
    , "deliver\tAri\tvisits\t1\t2025-05-01"
    , "approve\tMira\tvisits\t1\tI prefer visits once a month."
    , "approve\tAri\tvisits\t1\tI prefer visits once a month."
    , "edit\tAri\tvisits\t1\tZev\tprivateB\tI prefer visits twice a month."
    , "deliver\tAri\tvisits\t2\t2025-05-02"
    , "approve\tAri\tvisits\t2\tI prefer visits twice a month."
    , "revoke\tAri\tvisits"
    , "deliver\tAri\tvisits\t2\t2025-05-03"
    , "show\tprivateB"
    ])
  require "approval holder enforced" (has_text "ERR\tapprove\t" output)
  require "unapproved, edited, and revoked deliveries rejected"
    (length (filter (isPrefixOf "ERR\tdeliver\t") (lines output)) ≟ 3)
  require "unauthorized retelling absent from recipient"
    (not (has_text "I prefer visits twice a month." output))
  delivered ← successful_script candidate "delivery-once" (setup ++ joined
    [ "session\totherB\tfriend\tAri\tZev\tanother purpose"
    , "consent\totherB\tyes\tyes"
    , "proposal\tprivateA\tAri\twrongScope\tZev\tparentA\tThis must not reach another listener."
    , "proposal\tsharedAB\tAri\tsharedScope\tZev\tprivateB\tI speak for both of us."
    , "proposal\tprivateA\tAri\tready\tZev\tprivateB\tPlease reserve one Sunday for us."
    , "approve\tAri\tready\t1\tPlease reserve one Sunday for us."
    , "deliver\tAri\tready\t1\t2025-05-04"
    , "deliver\tAri\tready\t1\t2025-05-04"
    , "show\tprivateB"
    , "show\totherB"
    , "show\tparentA"
    ])
  require "unapproved destination and multi-holder source scope rejected"
    (length (filter (isPrefixOf "ERR\tproposal\t") (lines delivered)) ≟ 2)
  require "authorized delivery succeeds and retry is idempotent"
    (length (filter (≟ "OK\tdeliver\tready") (lines delivered)) ≟ 2)
  require "retelling delivered exactly once to named recipient"
    (length (filter (isInfixOf "Please reserve one Sunday for us.") (lines delivered)) ≟ 1)
  require "delivered retelling retains author-approved account kind" (has_text "author-approved" delivered)
  restored ← successful_script candidate "delivery-once" "deliver\tAri\tready\t1\t2025-05-04\nshow\tprivateB\n"
  require "restart does not duplicate delivered text"
    (length (filter (isInfixOf "Please reserve one Sunday for us.") (lines restored)) ≟ 1)
  shared ← successful_script candidate "shared-delivery" (setup ++ joined
    [ "session\tsharedOutside\tshared\tAri\tAri,Zev,Mira\taudience includes outsider"
    , "consent\tsharedOutside\tyes\tyes"
    , "proposal\tprivateA\tAri\toutside\tZev\tsharedOutside\tAn outsider must not receive this."
    , "proposal\tprivateA\tAri\tholderOnly\tZev\tprivateA\tNo recipient participates here."
    , "proposal\tprivateA\tAri\tjoint\tZev\tsharedAB\tI can make one visit each month."
    , "approve\tAri\tjoint\t1\tI can make one visit each month."
    , "deliver\tAri\tjoint\t1\t2025-05-05"
    , "show\tsharedAB"
    , "show\tprivateB"
    , "show\tparentA"
    , "show\tfriendA"
    ])
  require "holder can approve exact retelling into shared couple session"
    (exact_line "OK\tdeliver\tjoint" shared)
  require "shared destination requires a recipient and excludes outsiders"
    (length (filter (isPrefixOf "ERR\tproposal\t") (lines shared)) ≟ 2)
  require "shared delivery stays within exact selected destination"
    (length (filter (isInfixOf "I can make one visit each month.") (lines shared)) ≟ 1)

covering
model_request : Candidate → Text → Text → IO Text
model_request candidate case_name session = do
  let request_file = candidate.work_directory ++ "/" ++ case_name ++ ".request.txt"
      state_root = candidate.work_directory ++ "/" ++ case_name ++ ".state"
  observed ← capture [candidate.executable, "request", state_root, candidate.materials, session, request_file]
  require (case_name ++ " model request construction") (observed.process_status ≟ 0)
  read_required request_file

covering
check_noninterference : Candidate → IO ()
check_noninterference candidate = do
  let common = setup ++ "say\tprivateA\tAri\treport\t-\tnow\tI like our Sunday meals.\n"
  ignore $ successful_script candidate "world-one" (common ++ "say\tprivateB\tZev\treport\t-\tnow\tUnshared hidden debt of nine.\n")
  ignore $ successful_script candidate "world-two" (common ++ "say\tprivateB\tZev\treport\t-\tnow\tUnshared private plans about moving.\n")
  first ← model_request candidate "world-one" "privateA"
  second ← model_request candidate "world-two" "privateA"
  require "hidden facts cannot influence recipient model request" (first ≟ second && not (first ≟ ""))
  require "model request contains only permitted source"
    (has_text "I like our Sunday meals." first &&
     not (has_text "Unshared" first))
  parent_request ← model_request candidate "world-one" "parentA"
  friend_request ← model_request candidate "world-one" "friendA"
  require "audience role changes the permitted model task"
    (not (parent_request ≟ friend_request) && has_text "parent" parent_request && has_text "friend" friend_request)
  ignore $ successful_script candidate "world-one" "defer\tprivateA\tfamily_visits\n"
  deferred ← model_request candidate "world-one" "privateA"
  require "deferral changes retained conversational state" (not (deferred ≟ first))
  restored ← model_request candidate "world-one" "privateA"
  require "deferral survives restart" (restored ≟ deferred)
  authorized ← model_request candidate "delivery-once" "privateB"
  require "approved delivery is available in its destination request"
    (has_text "Please reserve one Sunday for us." authorized)
  ignore $ successful_script candidate "delivery-once" "revoke\tAri\tready\n"
  revoked ← model_request candidate "delivery-once" "privateB"
  require "revoked retelling excluded from future model request"
    (not (has_text "Please reserve one Sunday for us." revoked))

grounded_answer : Text
grounded_answer = "plan\texpectation\tWhose time is promised?\tprivateA-e1\t-\tfamily-partner\tWhich Sundays would you want to reserve for the two of you?\n"

covering
accept_response : Candidate → Text → Text → IO Observation
accept_response candidate case_name response = do
  let request_file = candidate.work_directory ++ "/" ++ case_name ++ ".request.txt"
      response_file = candidate.work_directory ++ "/" ++ case_name ++ ".response.tsv"
      state_root = candidate.work_directory ++ "/" ++ case_name ++ ".state"
  write_required response_file response
  capture [candidate.executable, "accept", state_root, candidate.materials,
    "privateA", request_file, response_file]

covering
plan_case : Candidate → Text → Text → IO ()
plan_case candidate name extra = do
  ignore $ successful_script candidate name (setup ++
    "say\tprivateA\tAri\treport\t-\tnow\tI would like regular family visits.\n" ++ extra)
  ignore $ model_request candidate name "privateA"

covering
check_plan_acceptance : Candidate → IO ()
check_plan_acceptance candidate = do
  plan_case candidate "plan-good" ""
  good ← accept_response candidate "plan-good" grounded_answer
  require "grounded recorded response accepted" (good.process_status ≟ 0)
  shown ← successful_script candidate "plan-good" "show\tprivateA\n"
  require "accepted response becomes visible conversational history"
    (has_text "Which Sundays would you want to reserve for the two of you?" shown)
  repeated ← accept_response candidate "plan-good" grounded_answer
  require "reused stale request cannot duplicate model delivery" (not (repeated.process_status ≟ 0))
  plan_case candidate "plan-private-reference"
    "say\tprivateB\tZev\treport\t-\tnow\tAnother person's hidden history.\n"
  private_reference ← accept_response candidate "plan-private-reference"
    "plan\texpectation\tWhose time is promised?\tprivateB-e1\t-\tfamily-partner\tThis follows hidden evidence.\n"
  require "response cannot cite another session's private evidence" (not (private_reference.process_status ≟ 0))
  plan_case candidate "plan-corrected" ""
  ignore $ successful_script candidate "plan-corrected"
    "correct\tprivateA\tAri\tprivateA-e1\treport\t-\tlater\tI meant occasional visits.\n"
  stale ← accept_response candidate "plan-corrected" grounded_answer
  require "correction invalidates in-flight response" (not (stale.process_status ≟ 0))
  plan_case candidate "plan-deferred" "defer\tprivateA\tfamily_visits\n"
  deferred ← accept_response candidate "plan-deferred" grounded_answer
  require "deferred question remains ineligible even in fresh request" (not (deferred.process_status ≟ 0))
  plan_case candidate "plan-injected-operation" ""
  malformed ← accept_response candidate "plan-injected-operation"
    (grounded_answer ++ "approve\tAri\tready\t1\tInvented authorization.\n")
  require "model output cannot append an authorization command" (not (malformed.process_status ≟ 0))

covering
check_journal : Candidate → IO ()
check_journal candidate = do
  ignore $ successful_script candidate "corrupt-journal" setup
  write_required (candidate.work_directory ++ "/corrupt-journal.state/journal.tsv")
    "YENTE-JOURNAL\t1\nperson\tAri"
  corrupted ← script candidate "corrupt-journal" "show\tprivateA\n"
  require "truncated journal fails before replay" (not (corrupted.process_status ≟ 0))
  after_failure ← read_required (candidate.work_directory ++ "/corrupt-journal.state/journal.tsv")
  require "failed recovery preserves corrupt evidence bytes"
    (after_failure ≟ "YENTE-JOURNAL\t1\nperson\tAri")

covering
check_event_retry : Candidate → IO ()
check_event_retry candidate = do
  let event = "event\tturn-901\tsay\tprivateA\tAri\treport\t-\tnow\tA uniquely delivered account.\n"
  first ← successful_script candidate "event-retry" (setup ++ event ++ event ++ "show\tprivateA\n")
  require "event retry returns original receipt"
    (length (filter (≟ "OK\tsay\tprivateA-e1") (lines first)) ≟ 2)
  require "event retry creates one account"
    (length (filter (isInfixOf "A uniquely delivered account.") (lines first)) ≟ 1)
  restarted ← successful_script candidate "event-retry"
    (event ++ "event\tturn-901\tsay\tprivateA\tAri\treport\t-\tnow\tConflicting replacement event.\nshow\tprivateA\n")
  require "event receipt survives restart" (exact_line "OK\tsay\tprivateA-e1" restarted)
  require "reusing event identity for different content rejected"
    (has_text "ERR\tevent\t" restarted && not (has_text "Conflicting replacement event." restarted))

covering
check_reply_retry : Candidate → IO ()
check_reply_retry candidate = do
  let reply = "event\treply1\tanswer\tprivateA\tinterpretation\tWhat does this account mean?\tprivateA-e1\t-\t-\tCORRECTED-PRIVATE-REPLY-TEXT\n"
  initial ← successful_script candidate "reply-retry" (setup ++
    "say\tprivateA\tAri\treport\t-\tnow\tAn initial private account.\n" ++ reply)
  require "event delivers grounded response initially"
    (exact_line "YENTA\tprivateA\tinterpretation\tCORRECTED-PRIVATE-REPLY-TEXT" initial)
  ignore $ successful_script candidate "reply-retry"
    "correct\tprivateA\tAri\tprivateA-e1\treport\t-\tlater\tA corrected account.\n"
  repeated ← successful_script candidate "reply-retry" reply
  require "reply retry after correction returns opaque receipt"
    (exact_line "OK\treplayed\treply1" repeated &&
     not (any (isPrefixOf "YENTA\t") (lines repeated)) &&
     not (has_text "CORRECTED-PRIVATE-REPLY-TEXT" repeated))
  journal_before ← read_required (candidate.work_directory ++ "/reply-retry.state/journal.tsv")
  require "reply retry cannot duplicate recorded history"
    (length (filter (isPrefixOf "event\treply1\tanswer\t") (lines journal_before)) ≟ 1)
  read_event ← successful_script candidate "reply-retry" "event\tview1\tshow\tprivateA\n"
  require "event cannot cache a context read"
    (has_text "ERR\tevent\t" read_event && not (has_text "CONTEXT\t" read_event))
  journal_after ← read_required (candidate.work_directory ++ "/reply-retry.state/journal.tsv")
  require "rejected read event never enters journal" (journal_after ≟ journal_before)
  let approved_reply = "event\tapprovedReply\tanswer\tprivateB\texpectation\tWhat does this preference require?\tdisclosure:secret:1:privateB\t-\t-\tREVOKED-APPROVED-REPLY-TEXT\n"
  approved ← successful_script candidate "revoked-reply-retry" (setup ++ joined
    [ "proposal\tprivateA\tAri\tsecret\tZev\tprivateB\tI need more time."
    , "approve\tAri\tsecret\t1\tI need more time."
    , "deliver\tAri\tsecret\t1\tnow"
    ] ++ approved_reply)
  require "approved evidence supports initial response"
    (exact_line "YENTA\tprivateB\texpectation\tREVOKED-APPROVED-REPLY-TEXT" approved)
  ignore $ successful_script candidate "revoked-reply-retry" "revoke\tAri\tsecret\n"
  revoked_retry ← successful_script candidate "revoked-reply-retry" approved_reply
  require "reply retry cannot reemit revoked disclosure"
    (exact_line "OK\treplayed\tapprovedReply" revoked_retry &&
     not (any (isPrefixOf "YENTA\t") (lines revoked_retry)) &&
     not (has_text "REVOKED-APPROVED-REPLY-TEXT" revoked_retry))

covering
check_uncited_context : Candidate → IO ()
check_uncited_context candidate = do
  initial ← successful_script candidate "uncited-hypothesis" (setup ++ joined
    [ "say\tprivateA\tAri\treport\t-\tnow\tI visit on Sundays."
    , "say\tprivateB\tZev\treport\t-\tnow\tI enjoy cooking."
    , "hypothesis\tprivateA\tguess\tprivateA-e1\t-\tWITHDRAWN-TENTATIVE-CONTROL"
    , "answer\tprivateA\tsummarize\tWhat was understood\t-\t-\t-\tUNCITED-WITHDRAWN-REPLY"
    , "answer\tprivateB\tsummarize\tWhat was understood\t-\t-\t-\tUNRELATED-REPLY-CONTROL"
    ])
  require "uncited summaries are delivered before withdrawal"
    (not (has_text "ERR\t" initial) && exact_line "YENTA\tprivateA\tsummarize\tUNCITED-WITHDRAWN-REPLY" initial && exact_line "YENTA\tprivateB\tsummarize\tUNRELATED-REPLY-CONTROL" initial)
  withdrawn ← successful_script candidate "uncited-hypothesis"
    "withdraw\tprivateA\tAri\tguess\nshow\tprivateA\nshow\tprivateB\n"
  require "withdrawing a hypothesis removes uncited replies exposed to it"
    (exact_line "OK\twithdraw\tguess" withdrawn && not (has_text "UNCITED-WITHDRAWN-REPLY" withdrawn) && not (has_text "WITHDRAWN-TENTATIVE-CONTROL" withdrawn))
  require "withdrawal preserves underlying account and other session's reply"
    (has_text "I visit on Sundays." withdrawn && has_text "UNRELATED-REPLY-CONTROL" withdrawn)
  restarted ← successful_script candidate "uncited-hypothesis" "show\tprivateA\n"
  require "restart does not reintroduce uncited withdrawn wording"
    (not (has_text "UNCITED-WITHDRAWN-REPLY" restarted))
  let request_path = candidate.work_directory ++ "/uncited-after-withdrawal.request"
  requested ← capture [candidate.executable, "request", candidate.work_directory ++ "/uncited-hypothesis.state", candidate.materials, "privateA", request_path]
  require "withdrawn-input request succeeds" (requested.process_status ≟ 0)
  request ← read_required request_path
  require "uncited withdrawn wording cannot enter a later model conversation"
    (not (has_text "UNCITED-WITHDRAWN-REPLY" request) && not (has_text "WITHDRAWN-TENTATIVE-CONTROL" request))
  approved ← successful_script candidate "uncited-revocation" (setup ++ joined
    [ "proposal\tprivateA\tAri\tretelling\tZev\tprivateB\tAPPROVED-CONTROL-STATEMENT"
    , "approve\tAri\tretelling\t1\tAPPROVED-CONTROL-STATEMENT"
    , "deliver\tAri\tretelling\t1\tnow"
    , "answer\tprivateB\tsummarize\tWhat was understood\t-\t-\t-\tUNCITED-REVOKED-REPLY"
    ])
  require "uncited approved-context summary initially delivered"
    (not (has_text "ERR\t" approved) && exact_line "YENTA\tprivateB\tsummarize\tUNCITED-REVOKED-REPLY" approved)
  revoked ← successful_script candidate "uncited-revocation" "revoke\tAri\tretelling\nshow\tprivateB\n"
  require "revocation removes uncited replies exposed to the statement"
    (exact_line "OK\trevoke\tretelling" revoked && not (has_text "UNCITED-REVOKED-REPLY" revoked) && not (has_text "APPROVED-CONTROL-STATEMENT" revoked))

valid_transcript_line : Text → Bool
valid_transcript_line line =
  case forget $ split (≟ '\t') line of
    ["YENTA", session, move, wording] ⇒
      all (\value ⇒ not (trim value ≟ "")) [session, move, wording]
    _ ⇒ False

covering
check_demonstration : Candidate → Text → IO ()
check_demonstration candidate command_file = do
  require "absolute demonstration command path" (isPrefixOf "/" command_file)
  commands ← read_required command_file
  output ← successful_script candidate "demonstration" commands
  let transcript = filter (isPrefixOf "YENTA\t") (lines output)
  require "demonstration has no failed command receipts"
    (not (any (isPrefixOf "ERR\t") (lines output)))
  require "demonstration produces valid nonempty Yenta transcript"
    (not (null transcript) && all valid_transcript_line transcript)

covering
semantic_cases : Candidate → IO ()
semantic_cases candidate = do
  check_accounts candidate
  check_correction candidate
  check_boundaries candidate
  check_agreement candidate
  check_disclosure candidate
  check_noninterference candidate
  check_plan_acceptance candidate
  check_journal candidate
  check_event_retry candidate
  check_reply_retry candidate
  check_uncited_context candidate

covering
run : List Text → IO ()
run [executable, materials] = do
  require "absolute candidate and material paths" (isPrefixOf "/" executable && isPrefixOf "/" materials)
  candidate ← isolated_candidate executable materials
  semantic_cases candidate
  putStrLn "YENTE_AICI_ACCEPTANCE_OK"
run [executable, materials, commands] = do
  require "absolute candidate and material paths" (isPrefixOf "/" executable && isPrefixOf "/" materials)
  candidate ← isolated_candidate executable materials
  semantic_cases candidate
  check_demonstration candidate commands
  putStrLn "YENTE_AICI_ACCEPTANCE_OK"
run _ = die "usage: yente-accept ABS_CANDIDATE ABS_MATERIALS [ABS_COMMANDS]"

covering
main : IO ()
main = do
  arguments ← getArgs
  run (drop 1 arguments)
