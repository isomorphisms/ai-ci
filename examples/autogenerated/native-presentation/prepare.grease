#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) { echo 'requires AICI IB BACKEND FRONTEND SMALI_JAR GREASE NEW_OUTPUT' >&2; exit 2 }
var aici = ARGV[0]
var ib = ARGV[1]
var backend = ARGV[2]
var frontend = ARGV[3]
var smali = ARGV[4]
var grease = ARGV[5]
var output = ARGV[6]
test ! -e "$output"
mkdir -p "$output"
"$grease" "$aici/examples/autogenerated/native-presentation/verify-workbench.grease" \
  "$aici" "$ib" "$frontend" "$backend/dex/idric/build/exec/idric-dex" "$output/workbench"
"$grease" "$backend/examples/autogenerated/presentation-callback/verify.grease" \
  "$backend" "$frontend" "$backend/dex/idric/build/exec/idric-dex" "$output/callback"
java -jar "$smali" assemble --api 29 "$aici/examples/autogenerated/native-presentation" -o "$output/workbench/probe.dex"
sha256sum "$output/workbench/probe.dex" > "$output/probe.sha256"
