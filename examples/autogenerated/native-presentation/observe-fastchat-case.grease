#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 9) { echo 'requires AICI GREASE ADB SERIAL APK OBSERVER NEW_OUTPUT API EXPECTED' >&2; exit 2 }
var aici = ARGV[0]
var runtime = ARGV[1]
var adb = ARGV[2]
var serial = ARGV[3]
var candidate = ARGV[4]
var observer = ARGV[5]
var output = ARGV[6]
var api = ARGV[7]
var expected = ARGV[8]
if (expected === 'ime-pass' or expected === 'ime-refused' or expected === 'frame-refused') {
  "$runtime" "$aici/examples/autogenerated/native-presentation/observe-fastchat-ime.grease" \
    "$adb" "$serial" "$candidate" "$observer" "$output" "$api" "$expected"
  exit
}
if (expected !== 'pass' and expected !== 'refused' and expected !== 'secure-refused') { exit 2 }
try {
  "$runtime" "$aici/examples/autogenerated/native-presentation/observe-fastchat.grease" \
    "$adb" "$serial" "$candidate" "$observer" "$output" "$api" required-timeline
}
var status = _error.code
if (expected === 'pass') {
  test "$status" = 0
} elif (expected === 'refused') {
  test "$status" = 1
  rg -x -F 'INSTRUMENTATION_CODE: 0' "$output/ui.txt"
  rg -x -F 'INSTRUMENTATION_RESULT: stream=java.lang.AssertionError: FAIL native controls belong to the Activity content hierarchy' "$output/ui.txt"
  printf 'schema\tnative-content-owner-refusal-v1\nactual_signed_old_producer\tREJECTED\nintended_Activity_hierarchy_diagnostic\tPASS\nphysical\tNOT_RUN\n' > "$output/refusal.tsv"
} else {
  test "$status" = 1
  rg -x -F 'INSTRUMENTATION_CODE: -1' "$output/ui.txt"
  rg -x -F 'INSTRUMENTATION_CODE: 0' "$output/settings-ui.txt"
  rg -x -F 'INSTRUMENTATION_RESULT: stream=java.lang.AssertionError: FAIL provider settings Activity hierarchy and secure window' "$output/settings-ui.txt"
  printf 'schema\tnative-settings-window-refusal-v1\nactual_signed_unprotected_window_producer\tREJECTED\nintended_secure_window_diagnostic\tPASS\nphysical\tNOT_RUN\n' > "$output/refusal.tsv"
}
