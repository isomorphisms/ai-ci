#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) { echo 'requires AICI PRODUCT SOURCE ARTIFACT ZIP_SHA256 ICK SDK NEW_OUTPUT' >&2; exit 2 }
var aici = ARGV[0]
var product = ARGV[1]
var source = ARGV[2]
var artifact = ARGV[3]
var digest = ARGV[4]
var compiler = ARGV[5]
var sdk = ARGV[6]
var output = ARGV[7]
test ! -e "$output"
test $(git -C "$product" rev-parse HEAD) = "$source"
git -C "$product" diff --quiet HEAD -- native android examples/autogenerated/android-export-shell
mkdir -p "$output/input"
var observed = $(gh api "repos/dilapidated-shed/ChatGPTExporter/actions/artifacts/$artifact" --jq '.workflow_run.head_sha')
test "$observed" = "$source"
gh api "repos/dilapidated-shed/ChatGPTExporter/actions/artifacts/$artifact/zip" > "$output/producer.zip"
printf '%s  %s\n' "$digest" "$output/producer.zip" | sha256sum -c -
unzip -Z1 "$output/producer.zip" > "$output/entries.txt"
try { rg '(^/|(^|/)\.\.(/|$)|\\)' "$output/entries.txt" > "$output/unsafe-entries.txt" }
if (_error.code !== 1) { echo 'FAIL unsafe producer ZIP entry' >&2; exit 1 }
unzip -Z -l "$output/producer.zip" > "$output/entry-types.txt"
try { rg '^l' "$output/entry-types.txt" > "$output/symlinks.txt" }
if (_error.code !== 1) { echo 'FAIL producer ZIP symlink' >&2; exit 1 }
unzip -q "$output/producer.zip" -d "$output/input"
rg -x -F "$source" "$output/input/source-commit.txt"
var files = "$output/input/independent-reader/before/files"
test -d "$files"
chmod -R go-rwx "$files"
rg -x -F synthetic_interrupted_workspace "$files/selected-workspace.txt"
var workspace = $(printf synthetic_interrupted_workspace | sha256sum | cut -d ' ' -f 1)
var conversation = $(printf conversation-1 | sha256sum | cut -d ' ' -f 1)
var archive = "$files/archive-$workspace"
make -C "$product/native" verifier "CC=$compiler" \
  CFLAGS='-fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Werror -pedantic'
cp "$product/native/build/cgw-verify" "$output/independent-c1-verifier"
"$output/independent-c1-verifier" "$archive" > "$output/c1-reconstructed.txt"
rg -x -F b'disk_validation\tPASS_BOUNDED_MAIN_ARCHIVED' "$output/c1-reconstructed.txt"
rg -x -F b'expected\t1' "$output/c1-reconstructed.txt"
rg -x -F b'verified\t1' "$output/c1-reconstructed.txt"
rg -x -F b'full_account_export_complete\tfalse' "$output/c1-reconstructed.txt"
var tools = "$sdk/build-tools/36.0.0"
for name in chatgpt-exporter-arm64-development-candidate production-reader control-mutant {
  var apk = "$output/input/$name.apk"
  "$tools/apksigner" verify --verbose --print-certs "$apk" > "$output/$name.signer.txt"
  rg -x -F 'Number of signers: 1' "$output/$name.signer.txt"
  rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/$name.signer.txt"
  "$tools/aapt2" dump badging "$apk" > "$output/$name.manifest.txt"
}
rg -F "package: name='org.isomorphisms.chatgptexporter' versionCode='5'" "$output/chatgpt-exporter-arm64-development-candidate.manifest.txt"
rg -x -F "native-code: 'arm64-v8a'" "$output/chatgpt-exporter-arm64-development-candidate.manifest.txt"
rg -F "package: name='org.isomorphisms.chatgptexporter.e1fixture' versionCode='1'" "$output/production-reader.manifest.txt"
rg -x -F "native-code: 'x86_64'" "$output/production-reader.manifest.txt"
unzip -p "$output/input/production-reader.apk" lib/x86_64/libcgw_webview.so > "$output/production.so"
unzip -p "$output/input/chatgpt-exporter-arm64-development-candidate.apk" lib/arm64-v8a/libcgw_webview.so > "$output/arm64.so"
rg -a -l -F "$source" "$output/production.so" "$output/arm64.so" > "$output/native-source-bindings.txt"
test $(wc -l < "$output/native-source-bindings.txt") = 2
readelf -h "$output/production.so" > "$output/x86-ELF.txt"
readelf -h "$output/arm64.so" > "$output/arm64-ELF.txt"
rg -F 'Advanced Micro Devices X86-64' "$output/x86-ELF.txt"
rg -F AArch64 "$output/arm64-ELF.txt"
sha256sum "$compiler" "$output/independent-c1-verifier" "$archive/conversation-$conversation.json" \
  "$output/input/chatgpt-exporter-arm64-development-candidate.apk" "$output/input/production-reader.apk" \
  "$output/input/control-mutant.apk" > "$output/independent.sha256"
printf 'schema\tindependent-native-C1-input-v1\nsource\t%s\nartifact\t%s\narchive_sha256\t%s\nactual_disk_reconstruction\tPASS\nsource_bound_production_APKs\tPASS\nphysical\tNOT_RUN\n' \
  "$source" "$artifact" "$digest" > "$output/receipt.tsv"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
