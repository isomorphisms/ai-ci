#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'requires AICI FASTCHAT SDK SMALI_JAR KEYSTORE NEW_OUTPUT' >&2; exit 2 }
var aici = ARGV[0]
var fastchat = ARGV[1]
var sdk = ARGV[2]
var smali = ARGV[3]
var key = ARGV[4]
var output = ARGV[5]
test ! -e "$output"
mkdir -p "$output/source"
var tools = "$sdk/build-tools/34.0.0"
cp "$aici/examples/autogenerated/native-presentation/FastChatUi.smali" "$output/source/"
java -jar "$smali" assemble --api 29 "$output/source" -o "$output/classes.dex"
cat > "$output/AndroidManifest.xml" <<'EOF'
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.isomorphisms.fastchat.observer" android:versionCode="1" android:versionName="1">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
  <application android:hasCode="true" android:label="Independent FastChat observer" />
  <instrumentation android:name="acceptance.presentation.FastChatUi" android:targetPackage="org.isomorphisms.fastchat.diskstreaming.arena" />
</manifest>
EOF
"$tools/aapt2" link -I "$sdk/platforms/android-34/android.jar" --manifest "$output/AndroidManifest.xml" -o "$output/unsigned.apk"
zip -q -j "$output/unsigned.apk" "$output/classes.dex"
"$tools/zipalign" -f 4 "$output/unsigned.apk" "$output/aligned.apk"
"$tools/apksigner" sign --ks "$key" --ks-type JKS --ks-pass pass:fastchat-development \
  --key-pass pass:fastchat-development --ks-key-alias fastchat-material3-dev --out "$output/observer.apk" "$output/aligned.apk"
"$tools/apksigner" verify --verbose --print-certs "$output/observer.apk" > "$output/signer.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: aa9151e3922fa4795987c3655bc7aa4712620f1d94c24a2075acd7b29d8ac86e' "$output/signer.txt"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
git -C "$fastchat" rev-parse HEAD > "$output/producer-source.txt"
sha256sum "$output/observer.apk" "$output/classes.dex" > "$output/digests.txt"
