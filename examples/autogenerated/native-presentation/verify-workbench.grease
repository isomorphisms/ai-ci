#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'requires AICI IB FRONTEND DRIVER NEW_OUTPUT' >&2; exit 2 }
var aici = ARGV[0]
var ib = ARGV[1]
var frontend = ARGV[2]
var driver = ARGV[3]
var output = ARGV[4]
for path in "$aici" "$ib" "$frontend" "$driver" "$output" {
  if (path[0] !== '/') { echo 'absolute path required' >&2; exit 2 }
}
test ! -e "$output"
mkdir -p "$output/source" "$output/mutated"
cp -R "$ib/src/." "$output/source/"
cp "$aici/examples/autogenerated/native-presentation/WorkbenchAcceptance.idric" "$output/source/"
var prefix = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PREFIX = prefix
setglobal ENV.IDRIS2_PACKAGE_PATH = "$prefix/idris2-0.8.0"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
"$driver" --cg chez --source-dir "$output/source" --build-dir "$output/host-build" \
  --output-dir "$output" "$output/source/WorkbenchAcceptance.idric" -o observer > "$output/host-compile.txt" 2>&1
"$output/observer" > "$output/host-result.txt" 2>&1
cat "$output/host-result.txt"
"$driver" --cg dex --directive managed-exports --source-dir "$output/source" --build-dir "$output/dex-build" \
  --output-dir "$output" "$output/source/WorkbenchAcceptance.idric" -o observer > "$output/dex-compile.txt" 2>&1
test -s "$output/observer.dex"
cp -R "$output/source/." "$output/mutated/"
sed 's/if not (expected ≟ current)/if False/' "$output/source/IB/Reader/Workbench.idric" > "$output/mutated/IB/Reader/Workbench.idric"
"$driver" --cg chez --source-dir "$output/mutated" --build-dir "$output/mutated-build" \
  --output-dir "$output" "$output/mutated/WorkbenchAcceptance.idric" -o mutant > "$output/mutant-compile.txt" 2>&1
try { "$output/mutant" > "$output/mutant-result.txt" 2>&1 }
if (_error.code !== 1) { echo 'FAIL stale revision mutation was not rejected' >&2; exit 1 }
rg -x -F 'FAIL stale projection refused' "$output/mutant-result.txt"
"$driver" --cg dex --directive managed-exports --source-dir "$output/mutated" --build-dir "$output/mutant-dex-build" \
  --output-dir "$output" "$output/mutated/WorkbenchAcceptance.idric" -o mutant > "$output/mutant-dex-compile.txt" 2>&1
git -C "$ib" rev-parse HEAD > "$output/ib-source.txt"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
sha256sum "$output/source/IB/Reader/Workbench.idric" "$output/observer.dex" > "$output/digests.txt"
printf '\033[32mPASS\033[0m independent host workbench checks, direct DEX emission and rejecting producer mutation\n'
echo 'NOT_RUN ART and physical Android'
