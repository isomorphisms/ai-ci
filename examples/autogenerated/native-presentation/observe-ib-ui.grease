#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) { echo 'requires AICI INPUT SDK ADB SERIAL NEW_OUTPUT EXPECTED_API' >&2; exit 2 }
var aici = ARGV[0]
var input = ARGV[1]
var sdk = ARGV[2]
var adb = ARGV[3]
var serial = ARGV[4]
var output = ARGV[5]
var expected_api = ARGV[6]
test ! -e "$output"
mkdir -p "$output/source"
var tools = "$sdk/build-tools/35.0.0"
var package = 'org.isomorphisms.ib.prepaint'
var candidate = "$input/native-client/ib-native-boundary.apk"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
test "$api" = "$expected_api"
"$tools/apksigner" verify --verbose --print-certs "$candidate" > "$output/candidate-signer.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/candidate-signer.txt"
var before_uid = $("$adb" -s "$serial" shell pm list packages -U "$package" | tr -d '\r')
printf '%s\n' "$before_uid" | rg -x 'package:org\.isomorphisms\.ib\.prepaint uid:[1-9][0-9]{4,}'
"$adb" -s "$serial" install -r "$candidate" > "$output/candidate-install.txt"
var after_uid = $("$adb" -s "$serial" shell pm list packages -U "$package" | tr -d '\r')
test "$before_uid" = "$after_uid"
var installed = $("$adb" -s "$serial" shell pm path "$package" | tr -d '\r' | sed -n 's/^package://p')
printf '%s\n' "$installed" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
"$adb" -s "$serial" pull "$installed" "$output/installed.apk"
cmp "$candidate" "$output/installed.apk"
cp "$aici/examples/autogenerated/native-presentation/IbUi.smali" "$output/source/"
cp "$aici/examples/autogenerated/native-presentation/IbUiTask.smali" "$output/source/"
java -jar "$input/oracles/smali.jar" assemble --api 29 "$output/source" -o "$output/classes.dex"
cat > "$output/AndroidManifest.xml" <<'EOF'
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.isomorphisms.ib.presentation.observer" android:versionCode="1" android:versionName="1">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
  <application android:hasCode="true" android:label="Independent IB workbench observer" />
  <instrumentation android:name="acceptance.presentation.IbUi" android:targetPackage="org.isomorphisms.ib.prepaint" />
</manifest>
EOF
"$tools/aapt2" link -I "$sdk/platforms/android-34/android.jar" -M "$output/AndroidManifest.xml" -o "$output/unsigned.apk"
zip -q -j "$output/unsigned.apk" "$output/classes.dex"
"$tools/zipalign" -f 4 "$output/unsigned.apk" "$output/aligned.apk"
"$tools/apksigner" sign --ks "$input/platform-inputs/public-test-keystore" --ks-key-alias wegert-debug \
  --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --out "$output/observer.apk" "$output/aligned.apk"
"$tools/apksigner" verify --verbose --print-certs "$output/observer.apk" > "$output/observer-signer.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/observer-signer.txt"
"$adb" -s "$serial" install -r "$output/observer.apk" > "$output/install.txt"
proc snapshot(label) {
  "$adb" -s "$serial" shell am force-stop "$package"
  "$adb" -s "$serial" root > "$output/$label.root.txt"
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 0
  "$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/files/arena/last-source "$output/$label.index"
  "$adb" -s "$serial" unroot > "$output/$label.unroot.txt"
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
}
snapshot before
test "$(sed -n '1p' "$output/before.index")" = IBLAST2
test "$(sed -n '4p' "$output/before.index")" = IBH1
var source = $(sed -n '6p' "$output/before.index" | cut -f 1)
var generation = $(sed -n '6p' "$output/before.index" | cut -f 2)
printf '%s\n' "$source" | rg -x '[0-9a-f]{48}'
printf '%s\n' "$generation" | rg -x '[1-9][0-9]*'
"$adb" -s "$serial" logcat -c
try {
  timeout 90 "$adb" -s "$serial" shell am instrument -w -r \
    org.isomorphisms.ib.presentation.observer/acceptance.presentation.IbUi > "$output/ui.txt" 2>&1
}
var status = _error.code
cat "$output/ui.txt"
"$adb" -s "$serial" logcat -d -v threadtime > "$output/runtime.txt"
"$adb" -s "$serial" exec-out screencap -p > "$output/workbench-reader.png"
if (status !== 0) { exit 1 }
rg -x -F 'INSTRUMENTATION_CODE: -1' "$output/ui.txt"
rg -x -F 'INSTRUMENTATION_RESULT: stream=PASS actual IB History Reader preserves View text selection scroll and selects retained source' "$output/ui.txt"
snapshot after
for label in before after {
  sed '$d' "$output/$label.index" > "$output/$label.prefix"
  var observed_digest = $(sha256sum "$output/$label.prefix" | cut -d ' ' -f 1)
  test "$observed_digest" = "$(tail -n 1 "$output/$label.index")"
}
test "$(sed -n '2p' "$output/after.index")" = "$source"
test "$(sed -n '3p' "$output/after.index")" = "$generation"
test "$(sed -n '5p' "$output/after.index")" = 0
sed '1,5d;$d' "$output/before.index" > "$output/before.history"
sed '1,5d;$d' "$output/after.index" > "$output/after.history"
cmp "$output/before.history" "$output/after.history"
sha256sum "$candidate" "$output/observer.apk" "$output/before.index" "$output/after.index" > "$output/digests.txt"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
printf 'schema\tib-native-history-UI-v1\napi\t%s\nabi\tx86_64\nreader_history_roundtrip\tPASS\nreader_View_text_selection_scroll\tPASS\nretained_source_selection\tPASS\ndurable_source_id\t%s\ndurable_generation\t%s\nhistory_no_append\tPASS\nphysical\tNOT_RUN\n' "$api" "$source" "$generation" > "$output/receipt.tsv"
