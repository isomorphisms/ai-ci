#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) { echo 'requires AICI IB_INPUT PREPARED SDK ICK API NEW_OUTPUT GREASE' >&2; exit 2 }
var aici = ARGV[0]
var input = ARGV[1]
var prepared = ARGV[2]
var sdk = ARGV[3]
var compiler = ARGV[4]
var api = ARGV[5]
var output = ARGV[6]
var grease = ARGV[7]
var adb = "$sdk/platform-tools/adb"
var expected_api = ENV.AICI_EXPECTED_ANDROID_API
test ! -e "$output"
mkdir -p "$output"
test "$api" = "$expected_api"
test "$api" = 29 || test "$api" = 34
test "$(git -C "$aici" rev-parse HEAD)" = "$(cat "$prepared/observer-source.txt")"
sha256sum -c "$prepared/runtime-inputs.sha256"
"$grease" "$aici/examples/autogenerated/native-presentation/observe-art.grease" \
  "$adb" emulator-5554 "$prepared/workbench" "$prepared/callback" "$output/presentation"
"$grease" "$aici/ib-source/shizuku/observe-installed.grease" \
  "$aici" "$input/native-client" "$input/oracles/smali.jar" "$sdk" \
  "$input/platform-inputs/public-test-keystore" "$input/platform-inputs/shizuku-official.apk" \
  "$adb" emulator-5554 "$output/installed" reader-v2
"$grease" "$aici/ib-source/shizuku/observe-link-shapes.grease" \
  "$aici" "$input" "$sdk" "$compiler" "$adb" emulator-5554 "$output/installed" "$output/link-shapes"
"$grease" "$aici/examples/autogenerated/native-presentation/observe-ib-ui.grease" \
  "$aici" "$input" "$sdk" "$adb" emulator-5554 "$output/workbench-ui" "$api"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
cp "$input/ib-commit.txt" "$output/product-source.txt"
sha256sum "$input/native-client/ib-native-boundary.apk" > "$output/product-apk.sha256"
printf 'schema\tindependent-IB-presentation-requalification-v1\napi\t%s\nabi\tx86_64\nproducer_recompilation\tNONE\nactual_source_revision_mutation\tREJECTED\nactual_callback_signature_mutation\tREJECTED\ninstalled_native_reader_and_capability_mutations\tPASS\nactual_link_acquisition_and_offline_source_history\tPASS\nHistory_Reader_View_selection_scroll_source_identity\tPASS\nphysical\tNOT_RUN\n' "$api" > "$output/receipt.tsv"
