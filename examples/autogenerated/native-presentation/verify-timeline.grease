#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires AICI FASTCHAT ICK NEW_OUTPUT' >&2; exit 2 }
var aici = ARGV[0]
var product = ARGV[1]
var compiler = ARGV[2]
var output = ARGV[3]
test ! -e "$output"
mkdir -p "$output"
var source = "$product/android/timeline_projection.h"
sha256sum "$source" > "$output/digests.txt"
for variant in good reversed stale {
  mkdir -p "$output/$variant"
  if (variant === 'reversed') {
    sed 's/focus - count + i/focus - 1 - i/' "$source" > "$output/$variant/timeline_projection.h"
  } elif (variant === 'stale') {
    sed 's/projection->requested == revision/revision != 0/' "$source" > "$output/$variant/timeline_projection.h"
  } else {
    cp "$source" "$output/$variant/timeline_projection.h"
  }
  if (variant !== 'good') { if cmp -s "$source" "$output/$variant/timeline_projection.h" { exit 1 } }
  "$compiler" -fno-link-libatomic -std=c11 -D_FILE_OFFSET_BITS=64 -O2 -Wall -Wextra -Werror -pthread \
    "-I$output/$variant" "-I$product/src" "-I$product/third-party/appendfat-arena" \
    "$aici/examples/autogenerated/native-presentation/TimelineAcceptance.c" \
    "$product/src/conversation.c" "$product/third-party/appendfat-arena/appendfat_arena.c" \
    -o "$output/$variant/observer" > "$output/$variant/build.txt" 2>&1
  sha256sum "$output/$variant/observer" >> "$output/digests.txt"
  try { "$output/$variant/observer" "$output/$variant/store" > "$output/$variant/result.txt" 2>&1 }
  var status = _error.code
  cat "$output/$variant/result.txt"
  if (variant === 'good') {
    test "$status" = 0
    rg -x -F 'PASS independent actual timeline worker order Unicode bounds source failure and stale owner refusal' "$output/$variant/result.txt"
  } else {
    test "$status" = 1
    if (variant === 'reversed') {
      rg -x -F 'FAIL timeline source identity order and exact Unicode prompt' "$output/$variant/result.txt"
    } else {
      rg -x -F 'FAIL superseded timeline projection refused' "$output/$variant/result.txt"
    }
  }
}
git -C "$product" rev-parse HEAD > "$output/product-source.txt"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
printf 'schema\tfastchat-timeline-worker-v1\nactual_worker\tPASS\nsource_order_mutation\tREJECTED\nstale_publication_mutation\tREJECTED\nAndroid_UI\tNOT_RUN\nphysical\tNOT_RUN\n' > "$output/receipt.tsv"
