#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 9) { echo 'requires AICI SDK ADB PRODUCTION_APK KEYSTORE SMALI NEW_OUTPUT API CONTROL_MUTANT_APK' >&2; exit 2 }
var aici = ARGV[0]
var sdk = ARGV[1]
var adb = ARGV[2]
var apk = ARGV[3]
var keystore = ARGV[4]
var smali = ARGV[5]
var output = ARGV[6]
var api = ARGV[7]
var mutant = ARGV[8]
var package = 'org.isomorphisms.chatgptexporter.e1fixture'
var private = "/data/user/0/$package/files"
var tools = "$sdk/build-tools/36.0.0"
test ! -e "$output"
mkdir -p "$output/source"
"$adb" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
test "$("$adb" shell getprop ro.build.version.sdk | tr -d '\r')" = "$api"
"$tools/apksigner" verify --verbose --print-certs "$apk" > "$output/signer.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/signer.txt"
var before_uid = $("$adb" shell pm list packages -U "$package" | tr -d '\r')
printf '%s\n' "$before_uid" | rg -x 'package:org\.isomorphisms\.chatgptexporter\.e1fixture uid:[1-9][0-9]{4,}'
var uid = $(printf '%s\n' "$before_uid" | sed 's/.* uid://')
"$adb" install -r "$apk" > "$output/install.txt"
test "$before_uid" = "$("$adb" shell pm list packages -U "$package" | tr -d '\r')"
var installed = $("$adb" shell pm path "$package" | tr -d '\r' | sed -n 's/^package://p')
"$adb" pull "$installed" "$output/installed.apk"
cmp "$apk" "$output/installed.apk"
unzip -p "$apk" lib/x86_64/libcgw_webview.so > "$output/production.so"
# Reject a synthetic transport disguised as the production read-only renderer.
try { rg -a -F 'https://chatgpt.com/e1-fixture' "$output/production.so" > "$output/synthetic-marker.txt" }
if (_error.code !== 1) { echo 'FAIL synthetic transport in production reader' >&2; exit 1 }
printf '32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a  %s\n' "$smali" | sha256sum -c -
for name in ArchiveUi ArchiveUiTask ArchiveFrameProbe FrameTask {
  cp "$aici/examples/autogenerated/native-presentation/$name.smali" "$output/source/"
}
java -jar "$smali" assemble --api 29 "$output/source" -o "$output/classes.dex"
cat > "$output/AndroidManifest.xml" <<'EOF'
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.isomorphisms.archive.observer" android:versionCode="1" android:versionName="1">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
  <application android:hasCode="true" android:label="Independent native archive observer" />
  <instrumentation android:name="acceptance.presentation.ArchiveUi" android:targetPackage="org.isomorphisms.chatgptexporter.e1fixture" />
</manifest>
EOF
"$tools/aapt2" link -I "$sdk/platforms/android-34/android.jar" --manifest "$output/AndroidManifest.xml" -o "$output/unsigned.apk"
zip -q -j "$output/unsigned.apk" "$output/classes.dex"
"$tools/zipalign" -f 4 "$output/unsigned.apk" "$output/aligned.apk"
"$tools/apksigner" sign --ks "$keystore" --ks-key-alias wegert-debug --ks-pass pass:wegert-debug \
  --key-pass pass:wegert-debug --out "$output/observer.apk" "$output/aligned.apk"
"$adb" install -r "$output/observer.apk" > "$output/observer-install.txt"
proc root_for_fixture(label) {
  "$adb" shell am force-stop "$package"
  "$adb" root > "$output/$label.root.txt"
  timeout 30 "$adb" wait-for-device
  "$adb" shell id -u | tr -d '\r' | rg -x 0
}
proc unroot_fixture(label) {
  "$adb" unroot > "$output/$label.unroot.txt"
  timeout 30 "$adb" wait-for-device
  "$adb" shell id -u | tr -d '\r' | rg -x 2000
}
proc snapshot(label) {
  root_for_fixture "$label"
  mkdir -p "$output/$label"
  "$adb" pull "$private" "$output/$label/"
  unroot_fixture "$label"
  cd "$output/$label/files"
  find . -type f -print0 | sort -z | xargs -0 sha256sum > "$output/$label.sha256"
  cd "$aici"
}
snapshot before
rg -x -F synthetic_interrupted_workspace "$output/before/files/selected-workspace.txt"
var workspace_hash = $(printf synthetic_interrupted_workspace | sha256sum | cut -d ' ' -f 1)
var conversation_hash = $(printf conversation-1 | sha256sum | cut -d ' ' -f 1)
var source_file = "$output/before/files/archive-$workspace_hash/conversation-$conversation_hash.json"
var source_digest = $(sha256sum "$source_file" | cut -d ' ' -f 1)
# The producer's canonical C1 index has already been reconstructed independently
# by the requalification stage; this reads that bounded, exact schema field.
var inventory_digest = $(sed -n 's/.*"inventorySha256":"\([0-9a-f]\{64\}\)".*/\1/p' "$output/before/files/archive-$workspace_hash/native-index.json")
printf '%s\n' "$inventory_digest" | rg -x '[0-9a-f]{64}'
proc observe(label) {
  "$adb" shell am force-stop "$package"
  "$adb" logcat -c
  timeout 90 "$adb" shell am instrument -w -r -e source "$source_digest" -e inventory "$inventory_digest" \
    org.isomorphisms.archive.observer/acceptance.presentation.ArchiveUi > "$output/$label.txt" 2>&1
  cat "$output/$label.txt"
  "$adb" logcat -d -v threadtime > "$output/$label.runtime.txt"
  rg -x -F 'INSTRUMENTATION_CODE: -1' "$output/$label.txt"
  rg -x -F 'INSTRUMENTATION_RESULT: stream=PASS actual production native archive view, source roles, branch mode, framework copy and offline entry' "$output/$label.txt"
  try { rg -F 'shell:interactive_sign_in_ready' "$output/$label.runtime.txt" }
  if (_error.code !== 1) { echo 'FAIL read-only entry initialized acquisition shell' >&2; exit 1 }
  "$adb" pull "/sdcard/Android/data/$package/files/acceptance-reader-frame.png" "$output/$label.frame.png"
}
observe first
observe reopened
snapshot after
cmp "$output/before.sha256" "$output/after.sha256"
# Compile-time deletion in the actual producer, not an oracle pretending to
# reject its own fake object. Require the specific admission assertion.
"$tools/apksigner" verify --verbose --print-certs "$mutant" > "$output/control-mutant-signer.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/control-mutant-signer.txt"
try { cmp -s "$apk" "$mutant" }
if (_error.code !== 1) { echo 'FAIL ineffective archive control mutation' >&2; exit 1 }
"$adb" install -r "$mutant" > "$output/control-mutant-install.txt"
test "$before_uid" = "$("$adb" shell pm list packages -U "$package" | tr -d '\r')"
"$adb" shell am force-stop "$package"
timeout 90 "$adb" shell am instrument -w -r -e source "$source_digest" -e inventory "$inventory_digest" \
  org.isomorphisms.archive.observer/acceptance.presentation.ArchiveUi > "$output/control-mutant-refused.txt" 2>&1
cat "$output/control-mutant-refused.txt"
"$adb" logcat -d -v threadtime > "$output/control-mutant.runtime.txt"
rg -x -F 'INSTRUMENTATION_CODE: 0' "$output/control-mutant-refused.txt"
rg -x -F 'INSTRUMENTATION_RESULT: stream=java.lang.AssertionError: FAIL same-ID archive control admitted' "$output/control-mutant-refused.txt"
snapshot after-control-negative
cmp "$output/before.sha256" "$output/after-control-negative.sha256"
"$adb" install -r "$apk" > "$output/production-restored.txt"
test "$before_uid" = "$("$adb" shell pm list packages -U "$package" | tr -d '\r')"
var restored = $("$adb" shell pm path "$package" | tr -d '\r' | sed -n 's/^package://p')
"$adb" pull "$restored" "$output/restored.apk"
cmp "$apk" "$output/restored.apk"
# Deliberately corrupt only the dedicated synthetic emulator namespace, keeping
# its original owner and mode. No private user archive is ever a mutation target.
var member = "$private/archive-$workspace_hash/conversation-$conversation_hash.json"
root_for_fixture corrupt
printf '{}' > "$output/corrupt.json"
"$adb" push "$output/corrupt.json" "$member"
"$adb" shell chmod 600 "$member"
"$adb" shell chown "$uid:$uid" "$member"
"$adb" pull "$member" "$output/corrupt-actual.json"
cmp "$output/corrupt.json" "$output/corrupt-actual.json"
unroot_fixture corrupt
timeout 90 "$adb" shell am instrument -w -r -e corrupt yes -e source "$source_digest" -e inventory "$inventory_digest" \
  org.isomorphisms.archive.observer/acceptance.presentation.ArchiveUi > "$output/corrupt-refused.txt" 2>&1
cat "$output/corrupt-refused.txt"
rg -x -F 'INSTRUMENTATION_CODE: -1' "$output/corrupt-refused.txt"
rg -x -F 'INSTRUMENTATION_RESULT: stream=PASS actual production native archive refused corrupt normalized source' "$output/corrupt-refused.txt"
sha256sum "$apk" "$mutant" "$output/installed.apk" "$output/production.so" "$output/observer.apk" > "$output/artifact.sha256"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
printf 'schema\tnative-C1-archive-UI-v1\napi\t%s\nabi\tx86_64\nnamespace\t%s\ntransport\tproduction\nfixture_data\tsynthetic-captured-C1\noffline_view\tPASS\nreopen\tPASS\nsource_roles\tPASS\nselection_copy\tPASS\nno_archive_writes\tPASS\nactual_control_guard_mutation\tREFUSED\ncorrupt_normalized_source\tREFUSED\nphysical\tNOT_RUN\nactual_user_archive\tNOT_RUN\n' "$api" "$package" > "$output/receipt.tsv"
