#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) { echo 'requires AICI GREASE APK SOURCE SDK NEW_OUTPUT EXPECTED_SHA256' >&2; exit 2 }
var aici = ARGV[0]
var grease = ARGV[1]
var apk = ARGV[2]
var source = ARGV[3]
var sdk = ARGV[4]
var output = ARGV[5]
var expected_sha = ARGV[6]
printf '%s\n' "$expected_sha" | rg -x '[0-9a-f]{64}'
test ! -e "$output"
mkdir -p "$output"
printf '%s  %s\n' "$expected_sha" "$apk" | sha256sum -c -
"$grease" "$aici/examples/autogenerated/native-presentation/verify-fastchat-input.grease" \
  "$apk" "$source" "$sdk" "$output/actual" arm64-v8a
readelf -h "$output/actual/libfastchat.so" > "$output/actual/ELF.txt"
rg 'Class:.*ELF64' "$output/actual/ELF.txt"
rg 'Machine:.*AArch64' "$output/actual/ELF.txt"
try {
  "$grease" "$aici/examples/autogenerated/native-presentation/verify-fastchat-input.grease" \
    "$apk" 0000000000000000000000000000000000000000 "$sdk" "$output/wrong-source" arm64-v8a \
    > "$output/wrong-source.txt" 2>&1
}
if (_error.code !== 1) { echo 'FAIL wrong source delivery control did not refuse' >&2; exit 1 }
rg -x -F 'FAIL FastChat embedded source identity' "$output/wrong-source.txt"
try {
  "$grease" "$aici/examples/autogenerated/native-presentation/verify-fastchat-input.grease" \
    "$apk" "$source" "$sdk" "$output/wrong-ABI" x86_64 > "$output/wrong-ABI.txt" 2>&1
}
if (_error.code !== 1) { echo 'FAIL wrong ABI delivery control did not refuse' >&2; exit 1 }
rg -x -F 'FAIL FastChat declared ABI' "$output/wrong-ABI.txt"
cp "$apk" "$output/tampered.apk"
# Change actual signed bytes without resigning: this is a signature control,
# not a source producer, archive fixture or replacement deliverable.
zip -q -d "$output/tampered.apk" classes.dex
try {
  "$grease" "$aici/examples/autogenerated/native-presentation/verify-fastchat-input.grease" \
    "$output/tampered.apk" "$source" "$sdk" "$output/tampered" arm64-v8a > "$output/tampered.txt" 2>&1
}
if (_error.code !== 1) { echo 'FAIL tampered delivery control did not refuse' >&2; exit 1 }
rg -x -F 'FAIL FastChat APK signature' "$output/tampered.txt"
sha256sum "$apk" "$output/tampered.apk" > "$output/APKs.sha256"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
printf 'schema\tindependent-FastChat-C67-delivery-v1\nsource\t%s\nabi\tarm64-v8a\nactual_APK_digest_manifest_signature_source_ELF\tPASS\nwrong_source\tREJECTED\nwrong_ABI\tREJECTED\nchanged_signed_bytes\tREJECTED\nARM64_ART\tNOT_RUN\nphysical_C67\tNOT_RUN\n' "$source" > "$output/receipt.tsv"
