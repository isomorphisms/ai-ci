#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires AICI IB_INPUT NEW_OUTPUT GREASE' >&2; exit 2 }
var aici = ARGV[0]
var input = ARGV[1]
var output = ARGV[2]
var grease = ARGV[3]
var scratch = ENV.RUNNER_TEMP
if (ENV.GITHUB_ACTIONS !== 'true' or input !== "$scratch/ib-reader" or
    output !== "$scratch/ib-presentation") { echo 'FAIL undeclared job-owned IB workspace' >&2; exit 2 }
if test -L "$input" { echo 'FAIL symlinked downloaded IB input' >&2; exit 2 }
if test -L "$scratch/ib-input/candidate.zip" { echo 'FAIL symlinked downloaded IB archive' >&2; exit 2 }
test ! -e "$output"
mkdir -p "$output"
cp -R "$input/presentation/workbench" "$output/workbench"
cp -R "$input/presentation/callback" "$output/callback"
sha256sum "$output/workbench/probe.dex" > "$output/original-probe.sha256"
# This independent test oracle changes; no application or generated producer
# DEX is rewritten. Record both probe identities and the exact observer source.
java -jar "$input/oracles/smali.jar" assemble --api 29 \
  "$aici/examples/autogenerated/native-presentation" -o "$output/workbench/probe.dex"
"$grease" -n "$aici/examples/autogenerated/native-presentation/observe-art.grease" > "$output/observe-art.syntax.txt"
"$grease" -n "$aici/ib-source/shizuku/observe-link-shapes.grease" > "$output/link-shapes.syntax.txt"
var retained = "$output/runtime-input"
mkdir -p "$retained/native-client" "$retained/platform-inputs" "$retained/oracles"
for lane in boundary uid-bypass death-noop strict-flags stale-authorization {
  var name = "native-client/ib-native-$lane.apk"
  cp "$input/$name" "$retained/$name"
  cmp "$input/$name" "$retained/$name"
  sha256sum "$retained/$name" >> "$output/selected-runtime.sha256"
}
for name in ib-commit.txt native-client/receipt.tsv native-client/ib-commit.txt \
  native-client/backend-commit.txt native-client/frontend-commit.txt native-client/observer-commit.txt \
  platform-inputs/public-test-keystore platform-inputs/shizuku-official.apk oracles/smali.jar {
  cp "$input/$name" "$retained/$name"
  cmp "$input/$name" "$retained/$name"
  sha256sum "$retained/$name" >> "$output/selected-runtime.sha256"
}
sha256sum "$output/workbench/observer.dex" "$output/workbench/mutant.dex" \
  "$output/workbench/probe.dex" "$output/callback/Action.dex" "$retained/native-client/ib-native-boundary.apk" \
  > "$output/runtime-inputs.sha256"
git -C "$aici" rev-parse HEAD > "$output/observer-source.txt"
sha256sum -c "$output/selected-runtime.sha256"
# The full producer archive was verified before selection. Its compiler trees
# and duplicate ZIP are reproducible job-owned inputs, not user data or evidence.
# Preserve the archive digest and selected-byte identities before reclaiming.
df -PB1 "$scratch" > "$output/before.capacity.txt"
printf '392f0be0989c649aa517c32a1a74191bf2a7ea0b9042adb8f085bb611c45c5b8  %s\n' \
  "$scratch/ib-input/candidate.zip" | sha256sum -c -
rm -rf -- "$input"
rm -- "$scratch/ib-input/candidate.zip"
df -PB1 "$scratch" > "$output/after.capacity.txt"
var available = $(awk 'NR==2 {print $4}' "$output/after.capacity.txt")
if (int(available) < 4294967296) { echo 'FAIL less than 4GiB remains for emulator execution' >&2; exit 1 }
