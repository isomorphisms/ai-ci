#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) { echo 'requires AICI PREPARED SDK KEYSTORE SMALI GREASE NEW_OUTPUT API' >&2; exit 2 }
var aici = ARGV[0]
var prepared = ARGV[1]
var sdk = ARGV[2]
var keystore = ARGV[3]
var smali = ARGV[4]
var grease = ARGV[5]
var output = ARGV[6]
var api = ARGV[7]
var adb = "$sdk/platform-tools/adb"
var package = 'org.isomorphisms.chatgptexporter.e1fixture'
test ! -e "$output"
mkdir -p "$output"
"$adb" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
test "$("$adb" shell getprop ro.build.version.sdk | tr -d '\r')" = "$api"
"$adb" shell pm list packages "$package" > "$output/namespace-before.txt"
try { rg -x -F "package:$package" "$output/namespace-before.txt" }
if (_error.code !== 1) { echo 'FAIL fixture namespace already exists; never replace unrelated data' >&2; exit 1 }
"$adb" shell svc wifi disable
"$adb" shell svc data disable
"$adb" shell wm size 720x1600
"$adb" shell wm density 160
"$adb" install "$prepared/input/production-reader.apk" > "$output/seed-install.txt"
var identity = $("$adb" shell pm list packages -U "$package" | tr -d '\r')
printf '%s\n' "$identity" | rg -x 'package:org\.isomorphisms\.chatgptexporter\.e1fixture uid:[1-9][0-9]{4,}'
var uid = $(printf '%s\n' "$identity" | sed 's/.* uid://')
"$adb" root > "$output/seed.root.txt"
timeout 30 "$adb" wait-for-device
"$adb" shell id -u | tr -d '\r' | rg -x 0
var private = "/data/user/0/$package/files"
"$adb" shell mkdir -p "$private"
"$adb" push "$prepared/input/independent-reader/before/files/." "$private/"
"$adb" shell chown -R "$uid:$uid" "$private"
"$adb" shell chmod -R go-rwx "$private"
"$adb" shell restorecon -RF "$private"
"$adb" unroot > "$output/seed.unroot.txt"
timeout 30 "$adb" wait-for-device
"$adb" shell id -u | tr -d '\r' | rg -x 2000
"$grease" "$aici/examples/autogenerated/native-presentation/observe-archive-ui.grease" \
  "$aici" "$sdk" "$adb" "$prepared/input/production-reader.apk" "$keystore" "$smali" \
  "$output/ui" "$api" "$prepared/input/control-mutant.apk"
cp "$output/ui/receipt.tsv" "$output/receipt.tsv"
printf 'producer_recompilation\tNONE\nactual_source_disk_reconstruction\tPASS\nseed\tindependently_verified_actual_capture\n' >> "$output/receipt.tsv"
