#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) { echo 'usage: grease replay-content-dom.grease AICI IB FRONTEND REQUESTED_URL LOCATION DOM NEW_EVIDENCE' >&2; exit 2 }
var acceptance = ARGV[0]
var producer = ARGV[1]
var frontend = ARGV[2]
var requested = ARGV[3]
var location = ARGV[4]
var dom = ARGV[5]
var evidence = ARGV[6]
if test -e "$evidence" { exit 2 }
umask 077
mkdir -p "$evidence/source"
cp -R "$producer/src/IB" "$evidence/source/IB"
cp "$acceptance/examples/autogenerated/google-browser-integration/ReplayContentDom.idric" "$evidence/source/"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
"$frontend/_/build/exec/idris2" --source-dir "$evidence/source" --build-dir "$evidence/build" \
  --output-dir "$evidence" "$evidence/source/ReplayContentDom.idric" -o replay > "$evidence/compiler.txt" 2>&1
sha256sum "$location" "$dom" > "$evidence/input.sha256"
var actual = $(cat "$location")
var lines = int($(wc -l < "$dom"))
var terminated = 'yes'
var last = $(tail -c 1 "$dom" | od -An -tu1 | tr -d ' ')
if (last !== '10') {
  setvar lines += 1
  setvar terminated = 'no'
}
var began = int($(date +%s))
timeout 120 \
  "$evidence/replay" "$requested" "$actual" "$lines" "$terminated" < "$dom" > "$evidence/receipt.tsv" 2> "$evidence/replay.stderr"
var elapsed = int($(date +%s)) - began
printf 'elapsed_seconds\t%s\nmaximum_RSS\tNOT_MEASURED\n' "$elapsed" > "$evidence/host-cost.txt"
cat "$evidence/receipt.tsv" "$evidence/host-cost.txt"
