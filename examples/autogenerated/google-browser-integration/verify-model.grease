#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: grease verify-model.grease AICI IB FRONTEND NEW_EVIDENCE' >&2; exit 2 }
var acceptance = ARGV[0]
var producer = ARGV[1]
var frontend = ARGV[2]
var evidence = ARGV[3]
if test -e "$evidence" { exit 2 }
mkdir -p "$evidence/positive/source"
cp -R "$producer/src/IB" "$evidence/positive/source/IB"
cp "$acceptance/examples/autogenerated/google-browser-integration/BrowserResultsObserver.idric" "$evidence/positive/source/"
cp "$acceptance/examples/autogenerated/google-browser-integration/BrowserLayoutObserver.idric" "$evidence/positive/source/"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
proc compile(lane) {
  try {
    "$frontend/_/build/exec/idris2" --source-dir "$evidence/$lane/source" \
      --build-dir "$evidence/$lane/build" --output-dir "$evidence/$lane" \
      "$evidence/$lane/source/BrowserResultsObserver.idric" -o observer > "$evidence/$lane/compiler.txt" 2>&1
  }
  if (_error.code !== 0) { cat "$evidence/$lane/compiler.txt"; echo 'FAIL independent browser semantic control did not compile' >&2; exit 1 }
  if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/$lane/compiler.txt" { cat "$evidence/$lane/compiler.txt"; exit 1 }
}
compile positive
"$evidence/positive/observer" > "$evidence/positive/actual.txt" 2>&1
cat "$evidence/positive/actual.txt"
for lane in generation requested parent snippet layout heading-count heading-scope unresolved {
  mkdir -p "$evidence/$lane"
  cp -R "$evidence/positive/source" "$evidence/$lane/source"
  var original = "$evidence/positive/source/IB/WebSearch/Results.idric"
  var changed = "$evidence/$lane/source/IB/WebSearch/Results.idric"
  var assertion = ''
  if (lane === 'generation') {
    sed 's/response.source_generation \/= source.evidence.source_generation/False/' "$original" > "$changed"
    setvar assertion = 'FAIL independent resolved result generation correspondence'
  } elif (lane === 'requested') {
    sed 's/response.requested_url \/= candidate.acquisition_url/False/' "$original" > "$changed"
    setvar assertion = 'FAIL independent resolved result original request correspondence'
  } elif (lane === 'parent') {
    setvar original = "$evidence/positive/source/IB/HtmlPrepaint.idric"
    setvar changed = "$evidence/$lane/source/IB/HtmlPrepaint.idric"
    sed 's/evidence.source_generation \/= evidence.parent_source_generation/False/' "$original" > "$changed"
    setvar assertion = 'FAIL independent DOM parent generation correspondence'
  } elif (lane === 'snippet') {
    setvar original = "$evidence/positive/source/IB/WebSearch/Snippets.idric"
    setvar changed = "$evidence/$lane/source/IB/WebSearch/Snippets.idric"
    sed 's/eligible ≟ \[occurrence\]/eligible ≟ eligible/' "$original" > "$changed"
    setvar assertion = 'FAIL independent ambiguous snippet group refusal'
  } elif (lane === 'layout') {
    setvar original = "$evidence/positive/source/IB/Prepaint/Reflow.idric"
    setvar changed = "$evidence/$lane/source/IB/Prepaint/Reflow.idric"
    sed 's/else reflow_emergency_advances request advance text/else reflow_source_advances request advance text/' "$original" > "$changed"
    setvar assertion = 'FAIL independent weighted title emergency wrapping'
  } elif (lane === 'heading-count') {
    sed 's/candidate.heading_count \/= 1/False/' "$original" > "$changed"
    setvar assertion = 'FAIL independent ambiguous multiple result headings refusal'
  } elif (lane === 'heading-scope') {
    sed 's/if null value.heading_path then value/if False then value/' "$original" > "$changed"
    setvar assertion = 'FAIL independent heading title excludes anchor labels while retaining the public ICU target'
  } else {
    sed 's/RenderedBrowserDom _ ⇒ Nothing/RenderedBrowserDom _ ⇒ candidate_result evidence (Just candidate)/' "$original" > "$changed"
    setvar assertion = 'FAIL independent unresolved browser direct links require corresponding original ICU acquisition'
  }
  if cmp -s "$original" "$changed" { echo 'FAIL unchanged independent semantic mutant' >&2; exit 1 }
  compile "$lane"
  try { "$evidence/$lane/observer" > "$evidence/$lane/actual.txt" 2>&1 }
  if (_error.code !== 1) { cat "$evidence/$lane/actual.txt"; echo 'FAIL compiled browser model mutant missed its semantic assertion' >&2; exit 1 }
  rg -x -F "$assertion" "$evidence/$lane/actual.txt"
}
printf 'independent_checked_browser_model\tPASS\nindependent_heading_title_scope_and_ambiguity\tPASS\nindependent_weighted_layout_and_exact_copy\tPASS\ncompiled_source_request_parent_snippet_layout_heading_controls\tREJECTED\nGoogle_live_results\tNOT_RUN\nAndroid_ART\tNOT_RUN\n' > "$evidence/receipt.tsv"
