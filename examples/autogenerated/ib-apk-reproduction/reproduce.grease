#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'requires SDK FROZEN_IB_SOURCE FIXED_BACKEND BASELINE_BACKEND NEW_EVIDENCE' >&2; exit 2 }
var sdk = ARGV[0]
var source = ARGV[1]
var backend = ARGV[2]
var baseline = ARGV[3]
var evidence = ARGV[4]
var grease = ENV.IB_GREASE
for path in "$sdk" "$source" "$backend" "$baseline" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
test "$(git -C "$source" rev-parse HEAD)" = d02fe516833d0941e8ff1ab2b84369c1661aee6c
test "$(git -C "$backend" rev-parse HEAD)" = 153e7fc8053ba4072954a5e77d4efa3609d829e4
test "$(git -C "$baseline" rev-parse HEAD)" = 9861b303a7e6d989125d80cee552a46cb2503555
if test -e "$evidence" { echo 'FAIL reused APK reproduction evidence' >&2; exit 2 }
mkdir -p "$evidence/input" "$evidence/payload"
var archive = "$evidence/input.zip"
var authorization = ENV.GITHUB_TOKEN
curl --fail --location --silent --show-error --max-time 300 --max-filesize 2147483648 \
  --header "Authorization: Bearer $authorization" \
  https://api.github.com/repos/isomorphisms/ib/actions/artifacts/13101964714/zip --output "$archive"
test "$(wc -c < "$archive")" = 957726728
printf '9c8c5ffd9f764f3f4c3a3b7c70c2724554cc140a95fe9fdd4cb6e9ceca49546f  %s\n' "$archive" | sha256sum -c -
unzip -Z1 "$archive" > "$evidence/source-entries.txt"
awk 'substr($0,1,1)=="/" || $0~/(^|\/)\.\.(\/|$)/ {exit 1}' "$evidence/source-entries.txt"
unzip -q "$archive" -d "$evidence/input" ib-commit.txt native-client/ib-commit.txt \
  native-client/ib-native-boundary.apk native-client/activity.dex native-client/platform.dex \
  native-client/sha256.txt platform-inputs/public-test-keystore
rm "$archive"
test "$(cat "$evidence/input/ib-commit.txt")" = d02fe516833d0941e8ff1ab2b84369c1661aee6c
test "$(cat "$evidence/input/native-client/ib-commit.txt")" = d02fe516833d0941e8ff1ab2b84369c1661aee6c
var apk = "$evidence/input/native-client/ib-native-boundary.apk"
var expected = $(awk '$2~/\/ib-native-boundary[.]apk$/ {print $1}' "$evidence/input/native-client/sha256.txt")
printf '%s\n' "$expected" | rg -x '[0-9a-f]{64}'
printf '%s  %s\n' "$expected" "$apk" | sha256sum -c -
var tools = "$sdk/build-tools/35.0.0"
var certificate = 'de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9'
"$tools/apksigner" verify --verbose --print-certs "$apk" > "$evidence/original-signature.txt"
rg -x -F "Signer #1 certificate SHA-256 digest: $certificate" "$evidence/original-signature.txt"
"$tools/aapt2" dump badging "$apk" > "$evidence/original-badging.txt"
rg -F "package: name='org.isomorphisms.ib.prepaint' versionCode='3' versionName='0.3.0'" "$evidence/original-badging.txt"
unzip -Z1 "$apk" > "$evidence/APK-entries.txt"
awk 'substr($0,1,1)=="/" || $0~/(^|\/)\.\.(\/|$)/ {exit 1}' "$evidence/APK-entries.txt"
unzip -p "$apk" classes.dex > "$evidence/original-activity.dex"
unzip -p "$apk" classes2.dex > "$evidence/original-platform.dex"
cmp "$evidence/input/native-client/activity.dex" "$evidence/original-activity.dex"
cmp "$evidence/input/native-client/platform.dex" "$evidence/original-platform.dex"
awk '/^(classes([2-9]|[1-9][0-9]+)[.]dex|lib\/(armeabi-v7a|arm64-v8a|x86|x86_64)\/lib[A-Za-z0-9_]+[.]so|assets\/[A-Za-z0-9_\/-]+([.][A-Za-z0-9_]+)?)$/ {print}' \
  "$evidence/APK-entries.txt" > "$evidence/payload-entries.txt"
test -s "$evidence/payload-entries.txt"
for entry in @(cat "$evidence/payload-entries.txt") {
  unzip -q "$apk" "$entry" -d "$evidence/payload"
}
var keystore = "$evidence/input/platform-inputs/public-test-keystore"
# Reads may affect atime; the content, modes and mtime contract is exact.
find "$source/android-native/res" "$evidence/payload" -type f -printf '%p\t%m\t%T@\n' | LC_ALL=C sort > "$evidence/before-metadata.txt"
stat --printf='%n\t%a\t%y\n' "$source/android-native/AndroidManifest.xml" "$evidence/input/native-client/activity.dex" "$keystore" >> "$evidence/before-metadata.txt"
find "$source/android-native/res" "$evidence/payload" -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum > "$evidence/before-inputs.sha256"
sha256sum "$source/android-native/AndroidManifest.xml" "$evidence/input/native-client/activity.dex" "$keystore" >> "$evidence/before-inputs.sha256"
for producer in baseline fixed {
  var implementation = "$backend"
  if (producer === 'baseline') { setvar implementation = "$baseline" }
  for packaging_attempt in first second {
    if (packaging_attempt === 'second') { sleep 3 }
    var destination = "$evidence/$producer-$packaging_attempt"
    "$grease" "$implementation/apk/build-direct-dex-activity.grease" "$sdk" \
      "$source/android-native/AndroidManifest.xml" "$source/android-native/res" \
      "$evidence/input/native-client/activity.dex" "$keystore" org.isomorphisms.ib.prepaint \
      "$certificate" "$destination" "$evidence/payload" > "$evidence/$producer-$packaging_attempt-packager.txt" 2>&1
    cat "$evidence/$producer-$packaging_attempt-packager.txt"
    sha256sum "$destination/ib-material-reader.apk" >> "$evidence/rebuilt-sha256.txt"
    zipinfo -T -l "$destination/ib-material-reader.apk" > "$evidence/$producer-$packaging_attempt-zip-entries.txt"
  }
  try { cmp -s "$evidence/$producer-first/ib-material-reader.apk" "$evidence/$producer-second/ib-material-reader.apk" }
  var comparison = _error.code
  printf '%s\n' "$comparison" > "$evidence/$producer-comparison.exit"
  if (producer === 'baseline') {
    if (comparison !== 1) { echo 'FAIL old packager did not expose the timestamp counterexample' >&2; exit 1 }
  } elif (comparison !== 0) {
    echo 'FAIL fixed producer changed signed bytes for identical inputs' >&2
    exit 1
  }
}
find "$source/android-native/res" "$evidence/payload" -type f -printf '%p\t%m\t%T@\n' | LC_ALL=C sort > "$evidence/after-metadata.txt"
stat --printf='%n\t%a\t%y\n' "$source/android-native/AndroidManifest.xml" "$evidence/input/native-client/activity.dex" "$keystore" >> "$evidence/after-metadata.txt"
find "$source/android-native/res" "$evidence/payload" -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum > "$evidence/after-inputs.sha256"
sha256sum "$source/android-native/AndroidManifest.xml" "$evidence/input/native-client/activity.dex" "$keystore" >> "$evidence/after-inputs.sha256"
cmp "$evidence/before-metadata.txt" "$evidence/after-metadata.txt"
cmp "$evidence/before-inputs.sha256" "$evidence/after-inputs.sha256"
sha256sum "$backend/apk/build-direct-dex-activity.grease" "$baseline/apk/build-direct-dex-activity.grease" > "$evidence/producers.sha256"
printf 'schema\tib-signed-APK-packaging-reproduction-v2\nfixture_source\td02fe516833d0941e8ff1ab2b84369c1661aee6c\nbackend_source\t153e7fc8053ba4072954a5e77d4efa3609d829e4\nbaseline_source\t9861b303a7e6d989125d80cee552a46cb2503555\nsource_artifact\t13101964714\nsource_archive_sha256\t9c8c5ffd9f764f3f4c3a3b7c70c2724554cc140a95fe9fdd4cb6e9ceca49546f\nsame_frozen_payload_DEX_resources_key\tYES\nseparated_wall_clock_packaging\tYES\nold_producer_timestamp_control\tREJECTED\ncaller_bytes_modes_mtimes_unchanged\tPASS\nsigned_APK_byte_reproduction\tPASS\nnew_reader_0d2_runtime\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' > "$evidence/receipt.tsv"
cat "$evidence/rebuilt-sha256.txt" "$evidence/receipt.tsv"
