#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { exit 2 }
var root = ARGV[0]
var grease = ARGV[1]
var output = ARGV[2]
var process_path = ENV.PATH
test ! -e "$output"
mkdir -p "$output"
var here = "$root/examples/autogenerated/pasteboard-listener-readiness"
var helper = "$root/pasteboard/await-adb-after-reboot.grease"
var kernel = '22222222-2222-4222-8222-222222222222'
printf '%s\n' "$kernel" > "$output/boot-id.txt"
proc sample(name, number, kind) {
  var directory = "$output/$name"
  mkdir -p "$directory"
  printf 'device\n' > "$directory/state-$number.txt"
  printf '0\n' > "$directory/state-$number.status"
  printf '0\n' > "$directory/probe-$number.status"
  var qemu = '1'
  var api = '35'
  var uid = '2000'
  var boot = '1'
  var identity = kernel
  if (kind === 'wrong-api') { setvar api = '34' }
  if (kind === 'physical') { setvar qemu = '0' }
  if (kind === 'root') { setvar uid = '0' }
  if (kind === 'locked-boot') { setvar boot = '0' }
  if (kind === 'new-kernel') { setvar identity = '33333333-3333-4333-8333-333333333333' }
  printf 'qemu=%s\napi=%s\nuid=%s\nboot=%s\nkernel=%s\n' "$qemu" "$api" "$uid" "$boot" "$identity" > "$directory/probe-$number.txt"
  if (kind === 'duplicate') { printf 'uid=2000\n' >> "$directory/probe-$number.txt" }
  if (kind === 'probe-error') { printf '1\n' > "$directory/probe-$number.status" }
  if (kind === 'state-error') { printf '1\n' > "$directory/state-$number.status" }
  if (kind === 'state-mixed') { printf 'offline\n' >> "$directory/state-$number.txt" }
  if (kind === 'offline') {
    printf 'offline\n' > "$directory/state-$number.txt"
    printf '1\n' > "$directory/state-$number.status"
  }
}
proc run_case(name, limit, expected_status, attempts) {
  try {
    env PB_REBOOT_FIXTURE="$output/$name" PATH="$(dirname "$grease"):$process_path" \
      "$grease" "$helper" "$here/fake-adb.grease" emulator-test 35 \
      "$output/boot-id.txt" "$output/$name/evidence" "$limit" > "$output/$name/log.txt" 2>&1
  }
  if (_error.code !== int(expected_status)) { cat "$output/$name/log.txt" >&2; echo "FAIL transport case $name" >&2; exit 1 }
  printf 'attempts\t%s\n' "$attempts" > "$output/$name/expected-attempts.tsv"
  rg '^attempts' "$output/$name/evidence/result.tsv" > "$output/$name/actual-attempts.tsv"
  cmp "$output/$name/expected-attempts.tsv" "$output/$name/actual-attempts.tsv"
  if (int(expected_status) === 1) { rg -q -F 'FAIL post-reboot ADB transport and same-kernel emulator identity readiness' "$output/$name/log.txt" }
  printf '%s\tPASS\n' "$name" >> "$output/result.tsv"
}
sample ready 1 good
sample ready 2 good
run_case ready 2 0 2
sample recovered 1 good
sample recovered 2 offline
sample recovered 3 good
sample recovered 4 good
run_case recovered 4 0 4
sample not-consecutive 1 good
sample not-consecutive 2 offline
sample not-consecutive 3 good
run_case not-consecutive 3 1 3
for name in wrong-api physical root locked-boot new-kernel duplicate probe-error state-error state-mixed offline {
  sample "$name" 1 "$name"
  sample "$name" 2 "$name"
  run_case "$name" 2 1 2
}
cat "$output/result.tsv"
echo 'PASS bounded ADB transport fixtures; actual emulator and physical-device acceptance are separate'
