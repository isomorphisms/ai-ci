#!/usr/bin/env grease
set -eu -o pipefail
test "$#" -eq 3
var root = ARGV[0]
var grease = ARGV[1]
var output = ARGV[2]
test ! -e "$output"
mkdir -p "$output"
cat > "$output/processes.txt" <<'EOF'
USER PID NAME
u0_a209 321 com.isomorphisms.pasteboard
shell 654 com.isomorphisms.pasteboard:pasteboard_observer
EOF
printf 'package:com.isomorphisms.pasteboard uid:10209\n' > "$output/uid.txt"
cat > "$output/native.log" <<'EOF'
11-05 12:00:00.000 321 322 I PasteboardObserver: worker connection callback code=1 flags=17 uid=2000 current=1 bytes=128 accepted=1
11-05 12:00:00.050 654 654 I PasteboardObserver: companion initialize uid=2000 owner=10209 shell_uid=2000 package=1 operation=1 bridge=0 exception=0 accepted=1
11-05 12:00:00.100 654 655 I PasteboardObserver: clipboard listener registration accepted=1 caller_uid=2000
EOF
var helper = "$root/pasteboard/require-listener-ready.grease"
try { "$grease" "$helper" "$output/processes.txt" "$output/uid.txt" "$output/native.log" > "$output/positive.txt" }
if (_error.code !== 0) { cat "$output/processes.txt" "$output/uid.txt" "$output/native.log" >&2; echo 'FAIL generated positive readiness fixture' >&2; exit 1 }
sed 's/clipboard listener registration accepted=1/clipboard listener configuration retained=1/' "$output/native.log" > "$output/retained.log"
"$grease" "$helper" "$output/processes.txt" "$output/uid.txt" "$output/retained.log" > "$output/retained.txt"
sed 's/owner=10209/owner=10208/' "$output/native.log" > "$output/wrong-owner.log"
sed 's/654 655/999 655/' "$output/native.log" > "$output/stale-worker.log"
sed 's/registration accepted=1/registration accepted=0/' "$output/native.log" > "$output/refused-listener.log"
sed '/worker connection callback/d' "$output/native.log" > "$output/no-connection.log"
sed 's/uid=2000 current=1/uid=2000 current=0/' "$output/native.log" > "$output/stale-epoch.log"
sed 's/321 322/320 322/' "$output/native.log" > "$output/stale-app.log"
sed 's/caller_uid=2000/caller_uid=10209/' "$output/native.log" > "$output/wrong-caller.log"
sed 's/companion initialize uid=2000/companion initialize uid=10209/' "$output/native.log" > "$output/wrong-worker-uid.log"
sed '/companion initialize/d' "$output/native.log" > "$output/no-initialize.log"
sed 's/exception=0 accepted=1/exception=0 accepted=0/' "$output/native.log" > "$output/refused-initialize.log"
sed 's/worker connection callback code=1/worker connection callback code=2/' "$output/native.log" > "$output/disconnected.log"
for name in wrong-owner stale-worker refused-listener no-connection stale-epoch stale-app wrong-caller wrong-worker-uid no-initialize refused-initialize disconnected {
  try { "$grease" "$helper" "$output/processes.txt" "$output/uid.txt" "$output/$name.log" > "$output/$name.txt" }
  if (_error.code !== 1) { echo "FAIL readiness negative $name" >&2; exit 1 }
}
cp "$output/processes.txt" "$output/two-workers.txt"
printf 'shell 777 other:pasteboard_observer\n' >> "$output/two-workers.txt"
try { "$grease" "$helper" "$output/two-workers.txt" "$output/uid.txt" "$output/native.log" > "$output/two-workers.result.txt" }
if (_error.code !== 1) { echo 'FAIL multiple workers accepted' >&2; exit 1 }
printf 'listener_ready_parser\tPASS\nregistered_and_retained\tPASS\nwrong_owner_stale_worker_refused_missing_connection_stale_epoch_stale_app_multiple_workers\tREJECTED\n' > "$output/receipt.tsv"
printf 'wrong_caller_wrong_worker_UID_missing_or_refused_initialization_disconnected_callback\tREJECTED\n' >> "$output/receipt.tsv"
cat "$output/receipt.tsv"
