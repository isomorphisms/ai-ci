"""Independent polyhedral metric on the fixed 16-band, 64-sector Flower Net."""
import math
import pathlib
import sys
from builtins import ValueError, float, int, str, list, max

def require(condition ∈ bool, reason ∈ str) → None:
    if not condition:
        raise ValueError(reason)

def absolute(number ∈ float) → float:
    if number < 0:
        return -number
    return number

def node(ring ∈ int, sector ∈ int) → int:
    return 64*ring + sector % 64

def lengths(first ∈ list[float], second ∈ list[float]) → list[float]:
    dx ∈ float ← first[0] - second[0]
    dy ∈ float ← first[1] - second[1]
    dz ∈ float ← first[2] - second[2]
    mx ∈ float ← first[0] + second[0]
    mz ∈ float ← first[2] + second[2]
    # Project the reference displacement onto the material hoop tangent.
    midpoint_radius ∈ float ← math.hypot(mx,mz)
    hoop ∈ float ← (dz*mx-dx*mz) / midpoint_radius
    radial_squared ∈ float ← max(0., dx*dx+dy*dy+dz*dz-hoop*hoop)
    hoop_scale ∈ float ← 1+(first[6]+second[6])/2
    radial_scale ∈ float ← 1+(first[7]+second[7])/2
    radial ∈ float ← math.sqrt(radial_squared)
    preferred ∈ float ← math.hypot(hoop*hoop_scale, radial*radial_scale)
    realized ∈ float ← math.hypot(first[3]-second[3], first[4]-second[4], first[5]-second[5])
    return [preferred,realized]

def check_state(rows ∈ list[list[float]], step ∈ int) → None:
    angles ∈ list[list[float]] ← []
    for index in range(1088):
        pi ∈ float ← math.pi
        angle ∈ float ← 2*pi
        if index < 64 or index >= 1024:
            angle ← math.pi
        angles.append([angle,angle])
    # Enumerate oriented faces globally. Each material corner receives its
    # opposite angle; the inner and outer rims both begin with a pi budget.
    for ring in range(16):
        for sector in range(64):
            a ∈ int ← node(ring,sector)
            b ∈ int ← node(ring,sector+1)
            c ∈ int ← node(ring+1,sector+1)
            d ∈ int ← node(ring+1,sector)
            for face in [[a,b,d],[b,c,d]]:
                sides ∈ list[list[float]] ← []
                for i in range(3):
                    sides.append(lengths(rows[face[(i+1)%3]],rows[face[(i+2)%3]]))
                for i in range(3):
                    for kind in range(2):
                        left ∈ float ← sides[(i+1)%3][kind]
                        right ∈ float ← sides[(i+2)%3][kind]
                        opposite ∈ float ← sides[i][kind]
                        cosine ∈ float ← (left*left+right*right-opposite*opposite)/(2*left*right)
                        require(-1 < cosine and cosine < 1, "invalid triangle")
                        corner ∈ float ← math.acos(cosine)
                        angles[face[i]][kind] ← angles[face[i]][kind] - corner
    separation ∈ float ← 0
    totals ∈ list[float] ← [0.,0.]
    for index in range(1088):
        row ∈ list[float] ← rows[index]
        row_ring ∈ int ← index // 64
        row_sector ∈ int ← index % 64
        boundary ∈ bool ← row_ring == 0 or row_ring == 16
        rim ∈ int ← int(boundary)
        require(row[8]==rim, "rim identifier")
        forward ∈ list[float] ← lengths(row,rows[node(row_ring,row_sector+1)])
        spoke_ring ∈ int ← row_ring+1
        if row_ring == 16:
            spoke_ring ← row_ring-1
        spoke ∈ list[float] ← lengths(row,rows[node(spoke_ring,row_sector)])
        for kind in range(2):
            require(absolute(forward[kind]-row[9+kind]) < 2e-6, "round length")
            require(absolute(spoke[kind]-row[11+kind]) < 2e-6, "spoke length")
            require(absolute(angles[index][kind]-row[13+kind]) < 2e-5, "local angle")
            totals[kind] ← totals[kind] + row[13+kind]
        separation ← max(separation,absolute(row[13]-row[14]))
    require(absolute(totals[0]) < 1e-7 and absolute(totals[1]) < 1e-7, "annulus total")
    if step == 24:
        require(rows[575][6]>0.02 and rows[575][7]>0.005 and separation>0.002, "ineffective hold")

def read_states(path ∈ str) → list[list[list[float]]]:
    source ∈ pathlib.Path ← pathlib.Path(path)
    size ∈ int ← source.stat().st_size
    require(size < 1000000, "sample size")
    lines ∈ list[str] ← source.read_text().splitlines()
    require(len(lines)==2176, "two complete states")
    result ∈ list[list[list[float]]] ← [[],[]]
    for line_index in range(2176):
        fields ∈ list[str] ← lines[line_index].split()
        state ∈ int ← line_index // 1088
        require(len(fields)==17,"row width")
        observed_step ∈ int ← int(fields[0])
        observed_id ∈ int ← int(fields[1])
        require(observed_step==24*state and observed_id==line_index%1088, "row identity")
        numbers ∈ list[float] ← []
        for field in fields[2:]:
            number ∈ float ← float(field)
            require(math.isfinite(number), "nonfinite value")
            numbers.append(number)
        result[state].append(numbers)
    return result

def main() → None:
    args ∈ list[str] ← sys.argv
    states ∈ list[list[list[float]]] ← read_states(args[1])
    moved ∈ bool ← False
    for index in range(1088):
        initial ∈ list[float] ← states[0][index]
        grown ∈ list[float] ← states[1][index]
        require(initial[6]==0 and initial[7]==0, "initial growth")
        for axis in range(3):
            require(initial[axis]==initial[axis+3] and initial[axis]==grown[axis], "reference identity")
            if absolute(initial[axis+3]-grown[axis+3])>1e-6:
                moved ← True
    require(moved,"stationary output")
    check_state(states[0],0)
    check_state(states[1],24)
    # Each single-field corruption must fail at its own numerical comparison.
    columns ∈ list[int] ← [8,9,12,13,14]
    reasons ∈ list[str] ← ["rim identifier","round length","spoke length","local angle","local angle"]
    for index in range(5):
        column ∈ int ← columns[index]
        reason ∈ str ← reasons[index]
        saved ∈ float ← states[1][575][column]
        states[1][575][column] ← saved+0.05
        try:
            check_state(states[1],24)
            raise ValueError("accepted corrupted field")
        except ValueError as error:
            message ∈ str ← str(error)
            require(message==reason,"unexpected rejection: "+message)
        states[1][575][column] ← saved
        print("Rejected field",column,reason)
    print("PASS 2176 node observations; 2 metrics; 2048 triangles per state; 5 corrupted fields rejected")

main()
