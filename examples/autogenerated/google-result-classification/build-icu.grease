#!/usr/bin/env grease
# Build only the exact maintained command; this supplies no replacement parser.
set -eu -o pipefail
if (len(ARGV) !== 3) { exit 2 }
var repository = ARGV[0]
var compiler = ARGV[1]
var evidence = ARGV[2]
if test -e "$evidence" { exit 2 }
mkdir -p "$evidence"
var frontend = "$repository/.tools/Idric"
var client = "$repository/.tools/icu"
var net = "$repository/.tools/Idric-Net"
test "$(git -C "$client" rev-parse HEAD)" = 1068defb47e55fdcab29faa79b760011f8dcfbe1
test "$(git -C "$frontend" rev-parse HEAD)" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test "$(git -C "$net" rev-parse HEAD)" = b21801b72acb8ab835c297bbe298af8599550134
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
cd "$net"
"$frontend/_/build/exec/idris2" --install idric-net.ipkg > "$evidence/net-build.txt" 2>&1
cd "$client"
make "ICK=$compiler" "IDRIC=$frontend/_/build/exec/idris2" > "$evidence/icu-build.txt" 2>&1
mkdir -p "$evidence/command-source"
for input in @(rg --files "$client/src" -g '*.idric') { cp "$input" "$evidence/command-source/" }
cp "$client/examples/autogenerated/google-acquisition/CommandChecks.idric" "$evidence/command-source/"
"$frontend/_/build/exec/idris2" --source-dir "$evidence/command-source" --build-dir "$evidence/command-build" --output-dir "$evidence" "$evidence/command-source/CommandChecks.idric" -o command-checks > "$evidence/command-compiler.txt" 2>&1
"$evidence/command-checks" > "$evidence/command-checks.txt" 2>&1
cat "$evidence/command-checks.txt"
make check-native "ICK=$compiler" > "$evidence/native-checks.txt" 2>&1
sha256sum "$client/build/exec/icu" "$client/build/exec/icu_app/icu.so" "$client/libicu_transport.so" "$compiler" > "$evidence/inputs.sha256"
printf 'ICU_source\t1068defb47e55fdcab29faa79b760011f8dcfbe1\nfrontend\t740bbf2b1d9e811fd00c719c3473eede17ceea3b\nNet_source\tb21801b72acb8ab835c297bbe298af8599550134\ncommand_checks\tPASS\nnative_checks\tPASS\nAndroid_ART\tNOT_RUN\n' > "$evidence/receipt.tsv"
