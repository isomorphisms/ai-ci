#!/usr/bin/env grease
# Compile maintained IB with an independently owned observer, then require real
# compiled semantic mutants to fail at their designated assertion.
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'usage: grease verify-ib.grease AICI IB FRONTEND NEW_EVIDENCE' >&2; exit 2 }
var acceptance = ARGV[0]
var producer = ARGV[1]
var frontend = ARGV[2]
var evidence = ARGV[3]
if test -e "$evidence" { exit 2 }
mkdir -p "$evidence/positive/source"
cp -R "$producer/src/IB" "$evidence/positive/source/IB"
cp "$acceptance/examples/autogenerated/google-result-classification/ResultsObserver.idric" "$evidence/positive/source/"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/build/exec/idris2_app"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_CG = 'chez'
proc compile(lane) {
  try {
    "$frontend/_/build/exec/idris2" --source-dir "$evidence/$lane/source" \
      --build-dir "$evidence/$lane/build" --output-dir "$evidence/$lane" \
      "$evidence/$lane/source/ResultsObserver.idric" -o observer > "$evidence/$lane/compiler.txt" 2>&1
  }
  var result = _error.code
  if (result !== 0) { cat "$evidence/$lane/compiler.txt"; echo 'FAIL semantic control did not compile' >&2; exit 1 }
  if rg -n '(^Error:|INTERNAL ERROR|compiling hole)' "$evidence/$lane/compiler.txt" { cat "$evidence/$lane/compiler.txt"; exit 1 }
}
compile positive
"$evidence/positive/observer" > "$evidence/positive/actual.txt" 2>&1
cat "$evidence/positive/actual.txt"
for lane in headings public-host generation {
  mkdir -p "$evidence/$lane"
  cp -R "$evidence/positive/source" "$evidence/$lane/source"
  var original = "$evidence/positive/source/IB/WebSearch/Results.idric"
  var changed = "$evidence/$lane/source/IB/WebSearch/Results.idric"
  var assertion = ''
  if (lane === 'headings') {
    # Eligibility now has two independent barriers: one actual heading and
    # collection limited to its scope. Remove both in this compiled semantic
    # control so an arbitrary public anchor really reaches the assertion.
    sed -e 's/candidate.heading_count \/= 1/False/' \
      -e 's/if null value.heading_path then value/if False then value/' "$original" > "$changed"
    setvar assertion = 'FAIL independent arbitrary-anchor refusal'
  } elif (lane === 'public-host') {
    sed 's/if public_host origin \&\& safe_escapes/if True \&\& safe_escapes/' "$original" > "$changed"
    setvar assertion = 'FAIL independent first-party retry refusal'
  } else {
    sed 's/SourceBackedGoogleResult evidence.source_key evidence.source_generation/SourceBackedGoogleResult evidence.source_key "0"/' "$original" > "$changed"
    setvar assertion = 'FAIL independent result source generation'
  }
  if cmp -s "$original" "$changed" { echo 'FAIL semantic mutant did not change source' >&2; exit 1 }
  compile "$lane"
  try { "$evidence/$lane/observer" > "$evidence/$lane/actual.txt" 2>&1 }
  var status = _error.code
  if (status !== 1) { cat "$evidence/$lane/actual.txt"; echo 'FAIL compiled semantic mutant missed its assertion' >&2; exit 1 }
  rg -x -F "$assertion" "$evidence/$lane/actual.txt"
}
git -C "$producer" rev-parse HEAD > "$evidence/producer.commit"
git -C "$acceptance" rev-parse HEAD > "$evidence/observer.commit"
printf 'independent_checked_host_results\tPASS\ncompiled_semantic_controls\tREJECTED\nGoogle_live_results\tNOT_RUN\nAndroid_ART\tNOT_RUN\nphysical_ARM\tNOT_RUN\n' > "$evidence/receipt.tsv"
