#!/usr/bin/env grease
# Parse guards are syntax evidence only; real host/Android checks remain required.
set -eu -o pipefail
if (len(ARGV) !== 2) { echo 'usage: grease parse-orchestration.grease AICI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var evidence = ARGV[1]
var grease = ENV.IB_GREASE
if test -e "$evidence" { echo 'FAIL reused orchestration parse evidence' >&2; exit 2 }
mkdir -p "$evidence"
var programs = [
  'ib-source/reader/verify-decoder-original.grease',
  'ib-source/shizuku/observe-search-results.grease',
  'ib-source/shizuku/observe-fragments.grease',
  'ib-source/shizuku/observe-reader-lifecycle.grease',
  'ib-source/shizuku/observe-link-shapes.grease',
  'ib-source/shizuku/prepare-test-screen.grease',
  'dex/observe-activity-lifecycle.grease',
  'ib-source/reader/observe-installed-profile.grease',
  'ib-source/reader/prepare-installed-replay.grease',
  'ib-source/reader/prepare-fragment-replay.grease',
  'examples/autogenerated/ib-native-network/prepare-emulator-host.grease',
  'ib-source/reader/verify-google-href.grease',
  'ib-source/reader/test-google-href.grease'
]
for program in @programs {
  var name = $(basename "$program")
  try { "$grease" -n "$repository/$program" > "$evidence/$name.syntax.txt" 2> "$evidence/$name.stderr.txt" }
  var status = _error.code
  printf '%s\t%s\n' "$program" "$status" >> "$evidence/status.tsv"
  if (status !== 0) { cat "$evidence/$name.stderr.txt"; echo 'FAIL active reader orchestration syntax' >&2; exit 1 }
  sha256sum "$repository/$program" >> "$evidence/source.sha256"
}
printf 'schema\tib-active-orchestration-syntax-v1\nsyntax\tPASS\nruntime_semantics\tNOT_RUN\n' > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
