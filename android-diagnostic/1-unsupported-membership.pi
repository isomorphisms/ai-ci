"""Deterministic evidence bindings. Does not grade arbitrary causal prose."""
from argparse import ArgumentParser
from pathlib import Path
import hashlib
import json
import re
import sys

def require(record ∈ dict[str, object], key ∈ str) → str:
    value ∈ str ← record.get(key, "")
    if not isinstance(value, str):
        sys.exit("MISSING_INPUT:" + key)
    if not value:
        sys.exit("MISSING_INPUT:" + key)
    return value

def digest(path ∈ Path) → str:
    payload ∈ bytes ← path.read_bytes()
    answer ∈ str ← hashlib.sha256(payload).hexdigest()
    return answer

def main() → None:
    parser ∈ ArgumentParser ← ArgumentParser(description="Claim-specific Android diagnostic validation")
    parser.add_argument("--plan", required=True)
    parser.add_argument("--capture")
    parser.add_argument("--output", required=True)
    args ∈ object ← parser.parse_args()
    plan_name ∈ str ← args.plan
    output_name ∈ str ← args.output
    plan_path ∈ Path ← Path(plan_name)
    plan ∈ dict[str, object] ← json.loads(plan_path.read_text())
    for key in ["observed_symptom", "candidate_explanation", "required_observable", "observable_producer", "producer_scope", "experiment", "repository", "source_commit", "target", "device_instance", "package", "claim", "permitted_actions", "task_sha256"]:
        require(plan, key)
    package ∈ str ← require(plan, "package")
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z][A-Za-z0-9_]*)+", package):
        sys.exit("INVALID_PACKAGE")
    if "whatever" ∈ package:
        sys.exit("PLACEHOLDER_PACKAGE")
    scope ∈ str ← require(plan, "producer_scope")
    claim ∈ str ← require(plan, "claim")
    observable ∈ str ← require(plan, "required_observable")
    actions ∈ str ← require(plan, "permitted_actions")
    if actions != "observe":
        if actions != "observe,replay-input":
            sys.exit("ACTION_NOT_ADMITTED")
    if claim != "frame-observation":
        if claim != "crash-observation":
            if claim != "zoom-state-observation":
                sys.exit("UNSUPPORTED_CAUSAL_CLAIM:geometry and transforms require separate controls")
    if claim == "zoom-state-observation":
        if scope != "application-context":
            sys.exit("WRONG_EVIDENCE_SCOPE:application-context required")
        if observable != "crystal-state-v1":
            sys.exit("INSTRUMENTATION_GAP:crystal-state-v1 required for zoom state")
    if claim == "frame-observation":
        if observable != "frame":
            sys.exit("WRONG_OBSERVABLE:frame required")
    if claim == "crash-observation":
        if observable != "bounded-log":
            sys.exit("WRONG_OBSERVABLE:bounded-log required")
    decision ∈ dict[str, str] ← dict()
    decision.__setitem__("schema", "aici-android-diagnostic-v1")
    decision.__setitem__("plan_sha256", digest(plan_path))
    decision.__setitem__("result", "PREPARED")
    decision.__setitem__("acceptance_scope", "prepared-experiment")
    decision.__setitem__("remaining_uncertainty", "visual correctness, cause, and physical repair are not established")
    capture_name ∈ str ← args.capture
    if capture_name:
        capture_path ∈ Path ← Path(capture_name)
        capture ∈ dict[str, object] ← json.loads(capture_path.read_text())
        state ∈ str ← require(capture, "state")
        if state != "CAPTURED":
            sys.exit("CAPTURE_FAILURE:" + state)
        for key in ["source_commit", "target", "device_instance", "package", "task_sha256", "claim"]:
            expected ∈ str ← require(plan, key)
            observed ∈ str ← require(capture, key)
            if expected != observed:
                sys.exit("EVIDENCE_BINDING_MISMATCH:" + key)
        installed ∈ str ← require(capture, "installed_apk_sha256")
        expected_apk ∈ str ← require(plan, "apk_sha256")
        if installed != expected_apk:
            sys.exit("INSTALLED_ARTIFACT_MISMATCH")
        pid_before ∈ str ← require(capture, "pid_before")
        pid_after ∈ str ← require(capture, "pid_after")
        if not re.fullmatch(r"[1-9][0-9]*", pid_before):
            sys.exit("AMBIGUOUS_PID")
        if pid_before != pid_after:
            sys.exit("PROCESS_CHANGED")
        start_before ∈ str ← require(capture, "process_start_before")
        start_after ∈ str ← require(capture, "process_start_after")
        if start_before != start_after:
            sys.exit("PROCESS_CHANGED:pid reused")
        artifact_name ∈ str ← require(capture, "observation_path")
        artifact ∈ Path ← Path(artifact_name)
        if artifact.is_symlink():
            sys.exit("UNSAFE_CAPTURE_FILE")
        payload ∈ bytes ← artifact.read_bytes()
        if not payload:
            sys.exit("EMPTY_OBSERVATION")
        actual_digest ∈ str ← digest(artifact)
        asserted_digest ∈ str ← require(capture, "observation_sha256")
        if actual_digest != asserted_digest:
            sys.exit("SWAPPED_OBSERVATION")
        if claim == "frame-observation":
            if not payload.startswith(b"\x89PNG\r\n\x1a\n"):
                sys.exit("INVALID_FRAME_FORMAT")
            decision.__setitem__("supported_conclusion", "frame captured for the bound process; appearance requires review")
        elif claim == "crash-observation":
            producer ∈ str ← require(plan, "observable_producer")
            if producer.encode() ∉ payload:
                sys.exit("IRRELEVANT_LOG:no identified producer")
            decision.__setitem__("supported_conclusion", "identified producer emitted bounded log records")
        else:
            snapshot ∈ dict[str, object] ← json.loads(payload.decode())
            for key in ["source_commit", "package", "session", "replay_id", "gl_vendor", "gl_renderer", "gl_version", "render_path", "geometry_result", "camera_distance", "camera_min", "camera_max", "clip_near", "clip_far", "touch_count", "pointer_ids", "pinch_span", "applied_zoom"]:
                require(snapshot, key)
            snapshot_source ∈ str ← require(snapshot, "source_commit")
            if snapshot_source != require(plan, "source_commit"):
                sys.exit("SNAPSHOT_SOURCE_MISMATCH")
            if require(snapshot, "package") != package:
                sys.exit("SNAPSHOT_PACKAGE_MISMATCH")
            decision.__setitem__("supported_conclusion", "application state captured; geometry and transform causes remain separate")
        decision.__setitem__("capture_sha256", digest(capture_path))
        decision.__setitem__("observation_sha256", actual_digest)
        decision.__setitem__("result", "PASS")
        decision.__setitem__("acceptance_scope", "bounded-observation")
    destination ∈ Path ← Path(output_name)
    if destination.exists():
        sys.exit("OUTPUT_ALREADY_EXISTS")
    destination.write_text(json.dumps(decision, sort_keys=True, indent=2) + "\n")
    print(json.dumps(decision, sort_keys=True))

main()
