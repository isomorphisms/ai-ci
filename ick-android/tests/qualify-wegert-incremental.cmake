cmake_minimum_required(VERSION 3.22)

foreach(required WEGERT_SOURCE INTERFACE_ROOT STAGE NDK)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "qualify-wegert-incremental.cmake requires ${required}")
  endif()
endforeach()
foreach(directory WEGERT_SOURCE INTERFACE_ROOT STAGE NDK)
  if(NOT IS_DIRECTORY "${${directory}}")
    message(FATAL_ERROR "${directory} is not a directory: ${${directory}}")
  endif()
endforeach()
if(NOT DEFINED TEST_ROOT OR TEST_ROOT STREQUAL "")
  set(TEST_ROOT "${CMAKE_CURRENT_BINARY_DIR}/wegert-material-qualification")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")

set(toolchain "${NDK}/build/cmake/android.toolchain.cmake")
set(compiler "${STAGE}/bin/x86_64-linux-gnu-gcc")
set(compiler_record "${STAGE}/qualification/compiler.sha256")
set(ndk_record "${STAGE}/qualification/ndk.sha256")
set(closure_record "${STAGE}/qualification/artifacts.sha256")
set(policy_record "${STAGE}/qualification/receipt.tsv")
set(assembler_link "${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android26-clang")
file(REAL_PATH "${assembler_link}" assembler)
execute_process(COMMAND "${compiler}" -print-prog-name=cc1
  OUTPUT_VARIABLE cc1 OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE cc1_result)
if(NOT cc1_result EQUAL 0 OR NOT EXISTS "${cc1}")
  message(FATAL_ERROR "Cannot resolve the qualified cc1 child")
endif()
set(sysroot_header "${NDK}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/include/stdint.h")
execute_process(COMMAND "${compiler}" -print-file-name=include
  OUTPUT_VARIABLE builtin_root OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE builtin_result)
set(builtin_header "${builtin_root}/stddef.h")
if(NOT builtin_result EQUAL 0 OR NOT EXISTS "${builtin_header}")
  message(FATAL_ERROR "Cannot resolve the qualified builtin header")
endif()

function(run command_name)
  execute_process(COMMAND ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "${command_name} failed (${result}):\n${output}${error}")
  endif()
endfunction()

function(configure_wegert source build api)
  run("Wegert configure"
    "${CMAKE_COMMAND}" -S "${source}/_/build" -B "${build}" -G Ninja
    "-DCMAKE_TOOLCHAIN_FILE=${toolchain}"
    -DANDROID_ABI=x86_64 "-DANDROID_PLATFORM=android-${api}"
    -DCMAKE_BUILD_TYPE=Release
    -DWEGERT_USE_ICK_PREBUILT=OFF -DWEGERT_USE_ICK_COMPLEX_SOURCE=ON
    "-DWEGERT_ICK_SHARED=${INTERFACE_ROOT}" "-DWEGERT_ICK_STAGE=${STAGE}")
endfunction()

function(build_wegert build)
  run("Wegert build" "${CMAKE_COMMAND}" --build "${build}" --target wegert --verbose)
  if(NOT EXISTS "${build}/libwegert.so")
    message(FATAL_ERROR "Wegert build did not produce ${build}/libwegert.so")
  endif()
endfunction()

function(material_identity build output)
  file(GLOB receipts "${build}/ick/wegert/*.receipt.tsv")
  list(SORT receipts)
  if(NOT receipts)
    message(FATAL_ERROR "Wegert build retained no ICK object receipts")
  endif()
  set(combined)
  foreach(receipt IN LISTS receipts)
    file(STRINGS "${receipt}" lines)
    set(found)
    foreach(line IN LISTS lines)
      if(line MATCHES "^material_sha256\t([0-9a-f]+)$")
        set(material_sha "${CMAKE_MATCH_1}")
        string(LENGTH "${material_sha}" material_sha_length)
        if(material_sha_length EQUAL 64)
          string(APPEND combined "${material_sha}\n")
          set(found TRUE)
        endif()
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "Object receipt lacks material identity: ${receipt}")
    endif()
  endforeach()
  string(SHA256 identity "${combined}")
  set(${output} "${identity}" PARENT_SCOPE)
endfunction()

function(compare_incremental_with_clean label api)
  build_wegert("${incremental}")
  material_identity("${incremental}" observed_material)
  if(observed_material STREQUAL LAST_MATERIAL)
    message(FATAL_ERROR "${label} did not change the retained material identity")
  endif()
  set(clean "${TEST_ROOT}/clean-${label}")
  file(REMOVE_RECURSE "${clean}")
  configure_wegert("${WEGERT_SOURCE}" "${clean}" "${api}")
  build_wegert("${clean}")
  file(SHA256 "${incremental}/libwegert.so" incremental_sha)
  file(SHA256 "${clean}/libwegert.so" clean_sha)
  if(NOT incremental_sha STREQUAL clean_sha)
    message(FATAL_ERROR "${label} incremental libwegert.so differs from a clean build under the same material")
  endif()
  set(LAST_MATERIAL "${observed_material}" PARENT_SCOPE)
  message(STATUS "Wegert material case ${label}: PASS")
endfunction()

function(update_record record index material)
  file(STRINGS "${record}" lines)
  list(LENGTH lines line_count)
  if(line_count LESS_EQUAL index)
    message(FATAL_ERROR "Cannot update missing line ${index} in ${record}")
  endif()
  list(GET lines ${index} old_line)
  if(NOT old_line MATCHES "^([0-9a-f]+)([ \t]+.+)$")
    message(FATAL_ERROR "Cannot update malformed hash record: ${old_line}")
  endif()
  set(old_hash "${CMAKE_MATCH_1}")
  set(suffix "${CMAKE_MATCH_2}")
  string(LENGTH "${old_hash}" old_hash_length)
  if(NOT old_hash_length EQUAL 64)
    message(FATAL_ERROR "Cannot update non-SHA-256 record: ${old_line}")
  endif()
  file(SHA256 "${material}" material_sha)
  list(REMOVE_AT lines ${index})
  list(INSERT lines ${index} "${material_sha}${suffix}")
  list(JOIN lines "\n" content)
  file(WRITE "${record}" "${content}\n")
endfunction()

function(expect_build_failure label diagnostic)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${incremental}" --target wegert --verbose
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0)
    message(FATAL_ERROR "${label} unexpectedly reused the incremental object")
  endif()
  if(NOT "${output}${error}" MATCHES "${diagnostic}")
    message(FATAL_ERROR "${label} failed with the wrong diagnostic:\n${output}${error}")
  endif()
  message(STATUS "Wegert hostile case ${label}: PASS")
endfunction()

set(incremental "${TEST_ROOT}/incremental")
configure_wegert("${WEGERT_SOURCE}" "${incremental}" 26)
build_wegert("${incremental}")
material_identity("${incremental}" LAST_MATERIAL)
set(clean_baseline "${TEST_ROOT}/clean-baseline")
configure_wegert("${WEGERT_SOURCE}" "${clean_baseline}" 26)
build_wegert("${clean_baseline}")
file(SHA256 "${incremental}/libwegert.so" incremental_sha)
file(SHA256 "${clean_baseline}/libwegert.so" clean_sha)
if(NOT incremental_sha STREQUAL clean_sha)
  message(FATAL_ERROR "Baseline incremental and clean Wegert builds differ")
endif()

file(GLOB scene_objects "${incremental}/ick/wegert/wegert_scene.c-*.o")
list(GET scene_objects 0 scene_object)
file(TIMESTAMP "${scene_object}" unchanged_before "%s")
run("Timestamp separation" "${CMAKE_COMMAND}" -E sleep 1)
build_wegert("${incremental}")
file(TIMESTAMP "${scene_object}" unchanged_after "%s")
if(NOT unchanged_before STREQUAL unchanged_after)
  message(FATAL_ERROR "Unchanged Wegert material rebuilt an ICK object")
endif()
message(STATUS "Wegert unchanged object reuse: PASS")

file(APPEND "${WEGERT_SOURCE}/code/wegert_scene.c" "\n/* material source case */\n")
compare_incremental_with_clean(source 26)
file(APPEND "${WEGERT_SOURCE}/code/wegert_scene.h" "\n/* material user header case */\n")
compare_incremental_with_clean(user-header 26)
file(APPEND "${sysroot_header}" "\n/* material sysroot header case */\n")
compare_incremental_with_clean(sysroot-header 26)
file(APPEND "${builtin_header}" "\n/* material builtin header case */\n")
compare_incremental_with_clean(builtin-header 26)

file(APPEND "${cc1}" "\n")
run("Backdate cc1" touch -t 200001010000 "${cc1}")
expect_build_failure(backdated-cc1 "Qualified ICK material changed")
update_record("${compiler_record}" 1 "${cc1}")
compare_incremental_with_clean(cc1 26)

file(APPEND "${compiler}" "\n")
update_record("${compiler_record}" 0 "${compiler}")
compare_incremental_with_clean(compiler-driver 26)
file(APPEND "${assembler}" "\n")
update_record("${ndk_record}" 1 "${assembler}")
compare_incremental_with_clean(assembler-driver 26)
file(APPEND "${INTERFACE_ROOT}/ick-android/OwnedC.cmake" "\n# material recipe case\n")
compare_incremental_with_clean(recipe 26)
file(APPEND "${closure_record}" "material-closure-case\n")
compare_incremental_with_clean(qualification-closure 26)
file(APPEND "${policy_record}" "material_case\tpolicy\n")
compare_incremental_with_clean(policy 26)

configure_wegert("${WEGERT_SOURCE}" "${incremental}" 27)
compare_incremental_with_clean(api-profile 27)

file(GLOB scene_objects "${incremental}/ick/wegert/wegert_scene.c-*.o")
list(GET scene_objects 0 scene_object)
file(COPY_FILE "${scene_object}" "${TEST_ROOT}/scene-object-old")
file(APPEND "${WEGERT_SOURCE}/code/wegert_scene.c"
  "\nint ick_material_future_control = 1;\n")
compare_incremental_with_clean(future-control-source 27)
file(COPY_FILE "${scene_object}" "${TEST_ROOT}/scene-object-current")
file(COPY_FILE "${TEST_ROOT}/scene-object-old" "${scene_object}")
run("Future-date stale object" touch -t 203801010000 "${scene_object}")
expect_build_failure(future-object "object changed without recompilation")
file(COPY_FILE "${TEST_ROOT}/scene-object-current" "${scene_object}")
build_wegert("${incremental}")

set(relocated_source "${TEST_ROOT}/relocated-wegert")
file(MAKE_DIRECTORY "${relocated_source}")
file(COPY "${WEGERT_SOURCE}/" DESTINATION "${relocated_source}")
set(relocated_build "${TEST_ROOT}/relocated-build")
configure_wegert("${relocated_source}" "${relocated_build}" 27)
build_wegert("${relocated_build}")
material_identity("${relocated_build}" relocated_material)
material_identity("${incremental}" incremental_material)
if(NOT relocated_material STREQUAL incremental_material)
  message(FATAL_ERROR "Benign Wegert source/build relocation changed canonical material identity")
endif()
file(SHA256 "${relocated_build}/libwegert.so" relocated_sha)
file(SHA256 "${incremental}/libwegert.so" incremental_sha)
if(NOT relocated_sha STREQUAL incremental_sha)
  message(FATAL_ERROR "Benign Wegert source/build relocation changed libwegert.so")
endif()

message(STATUS "Real Wegert incremental material qualification: PASS")
