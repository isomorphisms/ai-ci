cmake_minimum_required(VERSION 3.22)

function(_ick_material_canonicalize input mappings output)
  set(canonical "${input}")
  foreach(mapping IN LISTS mappings)
    string(REPLACE "|" ";" mapping_parts "${mapping}")
    list(GET mapping_parts 0 mapping_root)
    list(GET mapping_parts 1 mapping_name)
    string(REPLACE "${mapping_root}" "${mapping_name}" canonical "${canonical}")
  endforeach()
  set(${output} "${canonical}" PARENT_SCOPE)
endfunction()

function(_ick_material_receipt_field receipt key output)
  file(STRINGS "${receipt}" receipt_lines)
  set(value)
  foreach(line IN LISTS receipt_lines)
    if(line MATCHES "^${key}\t([^\t]+)$")
      set(value "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(NOT value)
    message(FATAL_ERROR "ICK object receipt ${receipt} is missing ${key}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(ick_material_collect spec depfile output_manifest output_sha)
  if(NOT EXISTS "${spec}")
    message(FATAL_ERROR "ICK material specification is missing: ${spec}")
  endif()
  file(STRINGS "${spec}" spec_lines)
  list(POP_FRONT spec_lines schema_line)
  if(NOT schema_line STREQUAL "schema\tick-android-material-spec-v1")
    message(FATAL_ERROR "Unsupported ICK material specification: ${schema_line}")
  endif()

  set(mappings)
  set(manifest "schema\tick-android-material-v1\n")
  set(explicit_paths)
  foreach(line IN LISTS spec_lines)
    string(REPLACE "\t" ";" columns "${line}")
    list(GET columns 0 kind)
    if(kind STREQUAL "map")
      list(LENGTH columns column_count)
      if(NOT column_count EQUAL 3)
        message(FATAL_ERROR "Malformed ICK material map: ${line}")
      endif()
      list(GET columns 1 mapping_root)
      list(GET columns 2 mapping_name)
      list(APPEND mappings "${mapping_root}|${mapping_name}")
    elseif(kind STREQUAL "value")
      list(LENGTH columns column_count)
      if(NOT column_count EQUAL 3)
        message(FATAL_ERROR "Malformed ICK material value: ${line}")
      endif()
      list(GET columns 1 key)
      list(GET columns 2 value)
      string(APPEND manifest "value\t${key}\t${value}\n")
    elseif(kind STREQUAL "file")
      list(LENGTH columns column_count)
      if(NOT column_count EQUAL 6)
        message(FATAL_ERROR "Malformed ICK material file: ${line}")
      endif()
      list(GET columns 1 key)
      list(GET columns 2 canonical)
      list(GET columns 3 path)
      list(GET columns 4 expected)
      list(GET columns 5 guard)
      list(APPEND explicit_paths "${path}")
      if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
        file(SHA256 "${path}" observed)
      else()
        set(observed missing)
      endif()
      if(guard STREQUAL "qualified" AND NOT observed STREQUAL expected)
        message(FATAL_ERROR
          "Qualified ICK material changed without a matching qualification record: ${key}; expected ${expected}, observed ${observed}")
      elseif(NOT guard STREQUAL "qualified" AND NOT guard STREQUAL "tracked")
        message(FATAL_ERROR "Unknown ICK material guard ${guard} for ${key}")
      endif()
      string(APPEND manifest "file\t${key}\t${canonical}\t${observed}\n")
    elseif(NOT line STREQUAL "")
      message(FATAL_ERROR "Unknown ICK material specification row: ${line}")
    endif()
  endforeach()

  set(closure_lines)
  if(EXISTS "${depfile}")
    file(READ "${depfile}" depfile_text)
    string(REPLACE "\\\n" " " depfile_text "${depfile_text}")
    string(REGEX REPLACE "^[^:]*:[ \t]*" "" depfile_text "${depfile_text}")
    separate_arguments(dependencies NATIVE_COMMAND "${depfile_text}")
    foreach(dependency IN LISTS dependencies)
      if(dependency STREQUAL "")
        continue()
      endif()
      get_filename_component(dependency_absolute "${dependency}" ABSOLUTE)
      if(dependency_absolute IN_LIST explicit_paths)
        continue()
      endif()
      _ick_material_canonicalize("${dependency_absolute}" "${mappings}" dependency_canonical)
      if(EXISTS "${dependency_absolute}" AND NOT IS_DIRECTORY "${dependency_absolute}")
        file(SHA256 "${dependency_absolute}" dependency_sha)
      else()
        set(dependency_sha missing)
      endif()
      list(APPEND closure_lines "closure\t${dependency_canonical}\t${dependency_sha}\n")
    endforeach()
  endif()
  list(REMOVE_DUPLICATES closure_lines)
  list(SORT closure_lines)
  foreach(closure_line IN LISTS closure_lines)
    string(APPEND manifest "${closure_line}")
  endforeach()
  string(SHA256 material_sha "${manifest}")
  set(${output_manifest} "${manifest}" PARENT_SCOPE)
  set(${output_sha} "${material_sha}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  foreach(required SPEC DEPFILE OBJECT ASSEMBLY MANIFEST RECEIPT GUARD)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "VerifyMaterial.cmake requires ${required}")
    endif()
  endforeach()

  ick_material_collect("${SPEC}" "${DEPFILE}" current_manifest current_material_sha)
  set(guard_content "${current_material_sha}\n")
  set(guard_changed TRUE)
  if(EXISTS "${GUARD}")
    file(READ "${GUARD}" previous_guard)
    if(previous_guard STREQUAL guard_content)
      set(guard_changed FALSE)
    endif()
  endif()

  if(EXISTS "${OBJECT}")
    if(NOT EXISTS "${RECEIPT}" OR NOT EXISTS "${ASSEMBLY}" OR NOT EXISTS "${MANIFEST}")
      message(FATAL_ERROR "ICK object exists without its complete material receipt: ${OBJECT}")
    endif()
    _ick_material_receipt_field("${RECEIPT}" material_sha256 receipt_material_sha)
    if(NOT receipt_material_sha STREQUAL current_material_sha)
      file(REMOVE "${OBJECT}" "${ASSEMBLY}" "${DEPFILE}" "${MANIFEST}" "${RECEIPT}")
    else()
      file(READ "${MANIFEST}" recorded_manifest)
      if(NOT recorded_manifest STREQUAL current_manifest)
        message(FATAL_ERROR "ICK material manifest does not match its receipt: ${MANIFEST}")
      endif()
      _ick_material_receipt_field("${RECEIPT}" assembly_sha256 receipt_assembly_sha)
      _ick_material_receipt_field("${RECEIPT}" object_sha256 receipt_object_sha)
      file(SHA256 "${ASSEMBLY}" observed_assembly_sha)
      file(SHA256 "${OBJECT}" observed_object_sha)
      if(NOT observed_assembly_sha STREQUAL receipt_assembly_sha)
        message(FATAL_ERROR "ICK emitted assembly changed without recompilation: ${ASSEMBLY}")
      endif()
      if(NOT observed_object_sha STREQUAL receipt_object_sha)
        message(FATAL_ERROR "ICK object changed without recompilation: ${OBJECT}")
      endif()
    endif()
  else()
    file(REMOVE "${ASSEMBLY}" "${DEPFILE}" "${MANIFEST}" "${RECEIPT}")
  endif()

  if(guard_changed)
    get_filename_component(guard_directory "${GUARD}" DIRECTORY)
    file(MAKE_DIRECTORY "${guard_directory}")
    file(WRITE "${GUARD}" "${guard_content}")
  endif()
endif()
