#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { exit 2 }
var root = ARGV[0]
var grease = ARGV[1]
var output = ARGV[2]
var old = '11111111-1111-4111-8111-111111111111'
var next = '22222222-2222-4222-8222-222222222222'
test ! -e "$output"
mkdir -p "$output"
"$grease" "$root/android-reboot/validate.grease" "$old" "$next" 1 > "$output/positive.txt"
if "$grease" "$root/android-reboot/validate.grease" "$old" "$old" 1 > "$output/stale.txt" 2>&1 { echo 'FAIL old completed kernel accepted' >&2; exit 1 }
rg -q -F 'FAIL previous kernel is still answering' "$output/stale.txt"
if "$grease" "$root/android-reboot/validate.grease" "$old" "$next" 0 > "$output/incomplete.txt" 2>&1 { echo 'FAIL incomplete new boot accepted' >&2; exit 1 }
rg -q -F 'FAIL new kernel has not completed' "$output/incomplete.txt"
if "$grease" "$root/android-reboot/validate.grease" "$old" missing 1 > "$output/malformed.txt" 2>&1 { echo 'FAIL malformed identity accepted' >&2; exit 1 }
rg -q -F 'FAIL missing or malformed kernel boot identity' "$output/malformed.txt"
echo 'PASS boot identity controls; real Android reboot NOT_RUN by fixtures'
