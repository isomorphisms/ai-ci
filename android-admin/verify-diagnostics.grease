#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 2 and len(ARGV) !== 7) { echo 'usage: grease verify-diagnostics.grease RAW_TAG_LOG yes|no; or RAW_TAG_LOG http MAIN_PID SUBRESOURCE_PID COUNTS_BEFORE COUNTS_MAIN COUNTS_AFTER' >&2; exit 2 }
var log = ARGV[0]
var probes = ARGV[1]
var http = false
var main_pid = ''
var subresource_pid = ''
if (len(ARGV) === 7) {
  if (probes !== 'http') { echo 'FAIL unknown diagnostic contract' >&2; exit 2 }
  setvar http = true
  setvar probes = 'no'
  setvar main_pid = ARGV[2]
  setvar subresource_pid = ARGV[3]
  for pid in "$main_pid" "$subresource_pid" {
    try { printf '%s\n' "$pid" | rg -q -x '[1-9][0-9]{0,9}' }
    var numeric = _error.code
    if (numeric !== 0) { echo 'FAIL HTTP fixture host identities are invalid or reused' >&2; exit 1 }
    if (int(pid) > 2147483647) { echo 'FAIL HTTP fixture host identities are invalid or reused' >&2; exit 1 }
  }
  if (main_pid === subresource_pid) { echo 'FAIL HTTP fixture host identities are invalid or reused' >&2; exit 1 }
}
if (probes !== 'yes' and probes !== 'no') { echo 'FAIL unknown diagnostic contract' >&2; exit 2 }
test -f "$log"
test "$(stat -c %s "$log")" -le 1048576
# Both tags have closed numeric schemas. The observer-owned boundaries surround
# four synchronous UI-thread calls to the real product WebViewClient.
try { awk -v probes="$probes" '
  function fail(code) {failed=code;exit code}
  /^--------- beginning of (main|system|crash)$/ {next}
  {
    delete values
    for(i=1;i<=NF;i++) {
      if(split($i,pair,"=")!=2 || pair[2] !~ /^-?[0-9]+$/ || length(pair[2])>14 || pair[2]+0 < -1000000000000 || pair[2]+0 > 1000000000000 || pair[1] in values)fail(1)
      values[pair[1]]=pair[2]
    }
    if("observer_probe" in values) {
      if(NF!=3 || !("boundary" in values) || !("host_pid" in values) || values["host_pid"]+0<1 || values["observer_probe"]!=1)fail(1)
      if(values["boundary"]==1) {
        if(started || ended || active)fail(2)
        started=1;active=1;probe_pid=values["host_pid"]
      } else if(values["boundary"]==2) {
        if(!active || ended || values["host_pid"]!=probe_pid || probe_events!=4)fail(2)
        active=0;ended=1
      } else fail(2)
      next
    }
    if(!("event" in values) || !("host_pid" in values) || values["host_pid"]+0<1 || !("host_generation" in values) || !("activity_generation" in values) || !("renderer_generation" in values) || !("document_epoch" in values))fail(1)
    if(values["event"]+0<1 || values["event"]+0>12)fail(1)
    key=values["host_pid"] ":" values["host_generation"] ":" values["activity_generation"] ":" values["renderer_generation"]
    common="^(event|host_pid|host_generation|activity_generation|renderer_generation|document_epoch|"
    if("code" in values) {
      if(NF!=8 || !("elapsed_ms" in values))fail(1)
      allowed=common "code|elapsed_ms)$"
      if(values["event"]==10 && values["code"]==1 && values["elapsed_ms"]==-1)rejected++
      if(values["event"]==5 || values["event"]==6) {
        if(values["code"]==2) {
          if(values["document_epoch"]!=0 || values["elapsed_ms"]!=-1)fail(1)
        } else if(values["code"]==0) {
          if(values["document_epoch"]!=1 || values["elapsed_ms"]+0<0)fail(1)
          if(values["event"]==5)commits[key]++
          if(values["event"]==6)finishes[key]++
          if(ended && values["host_pid"]==probe_pid && values["host_generation"]==probe_host && values["activity_generation"]==probe_activity && values["renderer_generation"]+0>probe_renderer) {
            if(values["event"]==5)fresh_commits[key]++
            if(values["event"]==6)fresh_finishes[key]++
          }
        } else fail(1)
      }
    } else if(values["event"]==10) {
      if(NF!=14 || values["document_epoch"]!=1)fail(1)
      allowed=common "dns_ms|connect_ms|tls_ms|first_byte_ms|transfer_ms|dom_ms|load_ms|transfer_bytes)$"
      if(values["dns_ms"]==10001 && values["transfer_bytes"]==10008) {positive++;positive_key=key}
      if(values["dns_ms"]==20001 || values["dns_ms"]==30001)stale++
    } else if(values["event"]==11) {
      if(NF!=10 || values["document_epoch"]!=1)fail(1)
      allowed=common "first_paint_ms|first_contentful_paint_ms|observed_resource_count|observed_resource_transfer_bytes)$"
      if(values["first_paint_ms"]==10009 && values["observed_resource_transfer_bytes"]==10012) {paint++;paint_key=key}
      if(values["first_paint_ms"]==20009 || values["first_paint_ms"]==30009)stale++
    } else fail(1)
    for(field in values)if(field !~ allowed)fail(1)
    if(active) {
      if(values["host_pid"]!=probe_pid || values["event"]!=(5+probe_events%2) || values["code"]!=2 || values["document_epoch"]!=0 || values["elapsed_ms"]!=-1)fail(2)
      if(probe_events==0) {
        probe_key=key;probe_host=values["host_generation"];probe_activity=values["activity_generation"];probe_renderer=values["renderer_generation"]
      } else if(key!=probe_key)fail(2)
      probe_events++
      if(probe_events>4)fail(2)
    }
    events++
  }
  END {
    if(failed)exit failed
    if(events<1 || (probes=="yes" && (positive!=1 || paint!=1 || rejected<1 || stale>0)))exit 1
    if(active || (started && !ended))exit 2
    if(probes=="yes") {
      for(key in fresh_commits)if(fresh_commits[key]>0 && fresh_finishes[key]>0)fresh++
      if(!started || !ended || probe_events!=4 || positive_key!=probe_key || paint_key!=probe_key || commits[positive_key]<1 || finishes[positive_key]<1 || fresh<1)exit 2
    }
  }
' "$log" }
var result = _error.code
if (result === 2) { echo 'FAIL lifecycle attribution probe boundary or positive control' >&2; exit 1 }
if (result !== 0) { echo 'FAIL nonnumeric unknown missing or stale native diagnostics' >&2; exit 1 }
echo 'PASS closed numeric native diagnostics'
if (probes === 'yes') { echo 'PASS initial and fresh lifecycle positives with four bounded UNKNOWN callbacks and no checkpoint or measurement' }
if (http) {
  var counts_before = ARGV[4]
  var counts_main = ARGV[5]
  var counts_after = ARGV[6]
  for counts in "$counts_before" "$counts_main" "$counts_after" {
    test -f "$counts"
    test "$(stat -c %s "$counts")" -le 4096
  }
  try { awk -F '\t' '
    function fail(){failed=1;exit 1}
    FNR==1 {stage++}
    NF!=2 || $1!~/^(mainframe_503|subresource_page|subresource_404)$/ || $2!~/^[01]$/ {fail()}
    seen[stage SUBSEP $1]++ {fail()}
    {expected=stage==1?0:(stage==2?($1=="mainframe_503"?1:0):1);if($2!=expected)fail()}
    END {if(failed || stage!=3 || NR!=9)exit 1}
  ' "$counts_before" "$counts_main" "$counts_after" }
  var counters = _error.code
  if (counters !== 0) { echo 'FAIL HTTP fixture response counters did not follow selected requests' >&2; exit 1 }
  try { awk -v main_pid="$main_pid" -v sub_pid="$subresource_pid" '
    function fail(code){failed=code;exit code}
    /^--------- beginning of (main|system|crash)$/ {next}
    {
      delete values
      for(i=1;i<=NF;i++){split($i,pair,"=");values[pair[1]]=pair[2]}
      pid=values["host_pid"]
      if(pid!=main_pid && pid!=sub_pid)next
      if(values["host_generation"]+0<1 || values["activity_generation"]+0<1 || values["renderer_generation"]+0<1 || values["host_generation"]+0>2147483647 || values["activity_generation"]+0>2147483647 || values["renderer_generation"]+0>2147483647)fail(1)
      key=pid ":" values["host_generation"] ":" values["activity_generation"] ":" values["renderer_generation"]
      if(values["event"]==3 && values["code"]==0 && values["document_epoch"]==1 && values["elapsed_ms"]+0>=0)starts[key]=1
      if(pid==main_pid && values["event"]==7) {
        if(values["code"]!=503 || (values["document_epoch"]!=0 && values["document_epoch"]!=1))fail(1)
        if((values["document_epoch"]==0 && values["elapsed_ms"]!=-1) || (values["document_epoch"]==1 && values["elapsed_ms"]+0<0))fail(1)
        if(values["document_epoch"]==1 && !starts[key])fail(1)
        main_errors++;errors[key]++
      }
      if(pid==sub_pid && values["event"]==7)fail(2)
      if(pid==sub_pid && values["event"]==6 && values["code"]==0 && values["document_epoch"]==1) {
        if(!starts[key])fail(3)
        finishes[key]=1
      }
    }
    END {
      if(failed)exit failed
      if(main_errors<1)exit 1
      for(key in errors)if(!starts[key])exit 1
      for(key in finishes)if(starts[key])complete++
      if(complete<1)exit 3
    }
  ' "$log" }
  var observed = _error.code
  if (observed === 2) { echo 'FAIL subresource-only error became a main-frame failure' >&2; exit 1 }
  if (observed === 3) { echo 'FAIL subresource control did not complete its current main document' >&2; exit 1 }
  if (observed !== 0) { echo 'FAIL real main-frame HTTP 503 was not observed for selected host' >&2; exit 1 }
  echo 'PASS real main-frame HTTP 503 and ignored subresource 404 bound to selected hosts and server responses'
}
