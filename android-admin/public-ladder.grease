#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires AICI ADB SERIAL NEW_EVIDENCE' >&2; exit 2 }
var acceptance = ARGV[0]
var adb = ARGV[1]
var serial = ARGV[2]
var evidence = ARGV[3]
var grease = ENV.IB_GREASE
for path in "$acceptance" "$adb" "$evidence" "$grease" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused public ladder evidence' >&2; exit 2 }
umask 077
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -q -x 1
"$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r' | rg -q -x 34
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -q -x x86_64
"$adb" -s "$serial" shell nproc | tr -d '\r' | rg -q -x 1
printf 'phase\tstate\treason\n' > "$evidence/receipt.tsv"
var failed = false
trap --add EXIT { rm -f "$evidence/raw-events.private" }
for phase in public-search public-miwam {
  try {
    timeout 180 "$adb" -s "$serial" shell am instrument -w -r -e phase "$phase" \
      org.isomorphisms.ib.admin.acceptance/acceptance.admin.AdminInstrumentation > "$evidence/$phase.txt" 2>&1
  }
  var result = _error.code
  printf '%s\n' "$result" > "$evidence/$phase.exit"
  if rg -q 'IB_SYNTHETIC_ONLY_|IB_UNAPPROVED_INPUT|IBFixtureVerified' "$evidence/$phase.txt" {
    rm -f "$evidence/$phase.txt"
    echo 'FAIL protected value in public observer output' >&2; exit 1
  }
  var actor = $(sed -n 's/^INSTRUMENTATION_RESULT: observed_host_pid=//p' "$evidence/$phase.txt" | tr -d '\r')
  var state = 'UNKNOWN'
  var reason = 'observer_incomplete'
  var numeric = false
  if printf '%s\n' "$actor" | rg -q -x '[1-9][0-9]*' {
    "$adb" -s "$serial" logcat -d -v raw -s IBLongView:I '*:S' > "$evidence/raw-events.private"
    try { "$grease" "$acceptance/android-admin/verify-diagnostics.grease" "$evidence/raw-events.private" no > "$evidence/$phase.log-check.txt" 2>&1 }
    var valid = _error.code
    if (valid === 0) {
      awk -v wanted="host_pid=$actor" '{for(i=1;i<=NF;i++)if($i==wanted){print;break}}' \
        "$evidence/raw-events.private" > "$evidence/$phase.events.txt"
      setvar numeric = true
    }
    rm -f "$evidence/raw-events.private"
  }
  try { "$adb" -s "$serial" exec-out run-as org.isomorphisms.ib.prepaint cat "cache/$phase.png" > "$evidence/$phase.png" 2> /dev/null }
  var screenshot_status = _error.code
  if (screenshot_status !== 0) { rm -f "$evidence/$phase.png" }
  if (numeric) {
    var events = "$evidence/$phase.events.txt"
    if rg -q '^event=7 ' "$events" {
      if rg -q ' code=-(2|6|7|8|11) ' "$events" { setvar state = 'BLOCKED_NETWORK'; setvar reason = 'main_frame_network_or_tls_error' } else {
        setvar state = 'BLOCKED_SITE'; setvar reason = 'main_frame_rejected'
      }
    } elif rg -q -x -F 'INSTRUMENTATION_RESULT: public_state=-1' "$evidence/$phase.txt" {
      setvar state = 'BLOCKED_SITE'; setvar reason = 'public_verification_or_denial_page'
    } elif (result === 0 and screenshot_status === 0) {
      if rg -q -x -F 'INSTRUMENTATION_CODE: -1' "$evidence/$phase.txt" \
        && rg -q -x -F 'INSTRUMENTATION_RESULT: public_state=1' "$evidence/$phase.txt" \
        && rg -q '^event=3 .* code=0 ' "$events" \
        && rg -q '^event=5 .* code=0 ' "$events" \
        && rg -q '^event=6 .* code=0 ' "$events" \
        && rg -q '^event=10 .* dns_ms=' "$events" \
        && file "$evidence/$phase.png" | rg -q 'PNG image data, 480 x 800' {
        setvar state = 'PASS'; setvar reason = 'host_observed_started_committed_finished_timed_visible'
      } else { setvar reason = 'missing_start_commit_finish_timing_or_source_screenshot' }
    }
  }
  if (result === 124) {
    setvar reason = 'bounded_180_second_observer_timeout'
    "$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
  }
  printf '%s\t%s\t%s\n' "$phase" "$state" "$reason" >> "$evidence/receipt.tsv"
  if (state !== 'PASS') { setvar failed = true }
}
cat "$evidence/receipt.tsv"
if (failed) { echo 'FAIL public ladder has a separately classified incomplete boundary' >&2; exit 1 }
