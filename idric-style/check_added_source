#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "usage: $0 BASE [HEAD]" >&2
  exit 2
fi

base=$1
head=${2:-HEAD}

# This is deliberately a small drift detector, not an Idriç parser. It checks
# only lines added by the change so repositories can adopt it without first
# rewriting inherited Idris source.
git diff --unified=0 --no-color "$base" "$head" -- '*.idr' '*.idric' |
awk '
function annotation(level, message) {
  if (path == "") {
    print level ": " message > "/dev/stderr"
    return
  }

  if (ENVIRON["GITHUB_ACTIONS"] == "true")
    printf "::%s file=%s,line=%d::%s\n", level, path, line, message > "/dev/stderr"
  else
    printf "%s:%d: %s: %s\n", path, line, level, message > "/dev/stderr"
}

function source_code(added,   p) {
  # Remove ordinary line comments. Block comments and strings are left alone;
  # this check is intentionally conservative and should eventually defer to
  # the language parser when Idriç has a settled source-lint interface.
  p = index(added, "--")
  if (p > 0)
    return substr(added, 1, p - 1)
  return added
}

/^\+\+\+ b\// {
  path = substr($0, 7)
  next
}

/^@@ / {
  if (match($0, /\+[0-9]+/))
    line = substr($0, RSTART + 1, RLENGTH - 1) + 0
  next
}

/^\+/ && !/^\+\+\+/ {
  added = substr($0, 2)
  code = source_code(added)

  if (code ~ /(^|[^[:alnum:]_])Nat([^[:alnum:]_]|$)/) {
    annotation("error", "Idriç source must not introduce Nat. Use Number for an ordinary number/count; if nonnegativity or a range is meaningful, use a semantic restricted type.")
    errors++
  }

  if (code ~ /(^|[^[:alnum:]_])Vect([^[:alnum:]_]|$)/) {
    annotation("error", "Idriç source must not introduce Vect. Use List when length is not part of the meaning; if length matters, use a semantic collection/restriction rather than generic Vect.")
    errors++
  }

  if (code ~ /(^|[^[:alnum:]_])[a-z][[:alnum:]_]*[A-Z][[:alnum:]_]*([^[:alnum:]_]|$)/)
    annotation("warning", "lowerCamelCase is an Idriç style canary. Do not merely rename the token: re-read the canonical Idriç STYLE.md and the surrounding design, then reconsider the declaration as a whole.")

  if (code ~ /->|<-/)
    annotation("warning", "ASCII arrows are an Idriç style canary. Re-check the design rather than applying a blind replacement; Idriç-facing notation uses real arrows such as → and ←.")

  line++
  next
}

END {
  if (errors > 0)
    exit 1
}
'