#!/usr/bin/env grease
# Same-byte independent launch witness for the native sensor instruments.
set -eu -o pipefail
if (len(ARGV) !== 11) { echo 'requires ADB SERIAL SDK APK GREASE NEW_OUTPUT API PACKAGE SOURCE PRODUCER PROFILE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var sdk = ARGV[2]
var apk = ARGV[3]
var runtime = ARGV[4]
var output = ARGV[5]
var api = ARGV[6]
var package = ARGV[7]
var source = ARGV[8]
var producer = ARGV[9]
var profile = ARGV[10]
var suite = $(realpath "$(dirname "$0")")
var ffmpeg = $(command -v ffmpeg)
var component = "$package/android.app.NativeActivity"
test ! -e "$output"
mkdir -p "$output"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
test "$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')" = "$api"
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$sdk/build-tools/36.0.0/apksigner" verify --verbose --print-certs "$apk" > "$output/signer.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/signer.txt"
"$adb" -s "$serial" shell pm list packages "$package" > "$output/namespace-before.txt"
try { rg -x -F "package:$package" "$output/namespace-before.txt" }
if (_error.code !== 1) { echo 'FAIL independent instrument test requires a fresh namespace' >&2; exit 1 }
"$adb" -s "$serial" install "$apk" > "$output/install.txt"
"$adb" -s "$serial" shell wm size 480x960
"$adb" -s "$serial" shell wm density 160
for mode in no yes {
  "$adb" -s "$serial" shell cmd uimode night "$mode" > "$output/night-$mode.txt"
  "$adb" -s "$serial" shell am force-stop "$package"
  "$adb" -s "$serial" shell am start -W -n "$component" > "$output/start-$mode.txt"
  var ready = false
  for attempt in @(seq 1 20) {
    "$adb" -s "$serial" shell dumpsys activity activities > "$output/activity-$mode.txt"
    try { rg '(mResumedActivity|topResumedActivity)' "$output/activity-$mode.txt" | rg -F "$component" }
    if (_error.code === 0) { setvar ready = true; break }
    sleep 0.2
  }
  if (not ready) { echo 'FAIL instrument Activity did not resume' >&2; exit 1 }
  sleep 2
  "$adb" -s "$serial" shell pidof "$package" > "$output/pid-$mode.txt"
  rg -x '[1-9][0-9]*' "$output/pid-$mode.txt"
  "$adb" -s "$serial" exec-out screencap -p > "$output/instrument-$mode.png"
  "$runtime" "$suite/check-frame.grease" "$ffmpeg" "$output/instrument-$mode.png" "$output/instrument-$mode.frame.txt"
  "$ffmpeg" -nostdin -hide_banner -i "$output/instrument-$mode.png" \
    -vf 'crop=1:1:2:200,format=rgb24' -frames:v 1 -f rawvideo "$output/root-$mode.rgb" > "$output/root-$mode.decode.txt" 2>&1
  od -An -tu1 "$output/root-$mode.rgb" > "$output/root-$mode.txt"
  rg -x ' *3[1-5] +3[1-5] +3[1-5] *' "$output/root-$mode.txt"
  # Interior-only light ink excludes Android's status/navigation bar icons.
  # This rejects an empty charcoal launch window; it does not read sensor data.
  "$ffmpeg" -nostdin -hide_banner -i "$output/instrument-$mode.png" \
    -vf 'crop=440:780:20:80,signalstats,metadata=print' -frames:v 1 -f null - > "$output/ink-$mode.txt" 2>&1
  rg 'lavfi.signalstats.YMAX=(18[0-9]|19[0-9]|2[0-4][0-9]|25[0-5])$' "$output/ink-$mode.txt"
}
"$adb" -s "$serial" shell cmd uimode night no > "$output/night-restored.txt"
sha256sum "$apk" > "$output/apk.sha256"
printf 'source\t%s\nprofile\t%s\nAPI\t%s\nproducer_run\t%s\nboth_system_modes\tPASS\nreal_resumed_Activity\tPASS\nroot_pixel\tPASS\ninterior_light_ink\tPASS\nsensor_accuracy\tNOT_RUN\nstartup_transition_sequence\tNOT_RUN\nrotation\tNOT_RUN\nphysical_C67\tNOT_RUN\n' "$source" "$profile" "$api" "$producer" > "$output/receipt.tsv"
