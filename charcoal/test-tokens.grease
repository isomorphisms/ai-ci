#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'requires GREASE SHARED_PRESENTATION NEW_OUTPUT' >&2; exit 2 }
var runtime = ARGV[0]
var source = ARGV[1]
var output = ARGV[2]
var directory = $(dirname "$0")
test ! -e "$output"
mkdir -p "$output/bad-native/res/values" "$output/bad-xml/res/values"
"$runtime" "$directory/check-tokens.grease" "$source" > "$output/good.txt"
sed 's/CHARCOAL_TEXT 0xfff4f4f4u/CHARCOAL_TEXT 0xff858585u/' "$source/charcoal.h" > "$output/bad-native/charcoal.h"
cp "$source/res/values/charcoal.xml" "$output/bad-native/res/values/"
cp "$source/charcoal.h" "$output/bad-xml/"
sed 's/#F4F4F4/#858585/' "$source/res/values/charcoal.xml" > "$output/bad-xml/res/values/charcoal.xml"
try { "$runtime" "$directory/check-tokens.grease" "$output/bad-native" > "$output/bad-native.txt" 2>&1 }
if (_error.code !== 1) { echo 'FAIL native text-color mutation was not rejected' >&2; exit 1 }
rg -x -F 'FAIL charcoal native palette token: TEXT' "$output/bad-native.txt"
try { "$runtime" "$directory/check-tokens.grease" "$output/bad-xml" > "$output/bad-xml.txt" 2>&1 }
if (_error.code !== 1) { echo 'FAIL XML text-color mutation was not rejected' >&2; exit 1 }
rg -x -F 'FAIL charcoal XML palette token: TEXT' "$output/bad-xml.txt"
echo 'PASS matching palette and independent native/XML text mutations'
