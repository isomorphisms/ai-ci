#!/usr/bin/env grease
set -o errexit -o nounset -o pipefail
test "$#" -eq 2
var root = ARGV[0]
var output = ARGV[1]
mkdir -p "$output"
rg --files "$root" | sort > "$output/files.txt"
cat "$output/files.txt"
for relative in control-evidence/result.tsv control-evidence/after-server-restored.deliveries.txt control-evidence/after-server-restored.launch.txt control-evidence/after-server-restored.ps.txt control-evidence/server-restart.txt control-evidence/after-server-restored-0.clipboard.txt control-evidence/after-server-restored-1.clipboard.txt control-evidence/after-server-restored-2.clipboard.txt {
  var path = "$root/$relative"
  if test -f "$path" {
    printf '\nretained_file=%s\n' "$relative"
    if test "$relative" = control-evidence/after-server-restored.ps.txt {
      try { rg "pasteboard|shizuku|clipboardfixture" "$path" }
    } else { cat "$path" }
    cp "$path" "$output/$(basename "$path")"
  }
}
var log = "$root/control-evidence/after-server-restored.logcat.txt"
if test -f "$log" {
  try { rg -n -i 'pasteboard|shizuku|user.?service| 7053 ' "$log" > "$output/boundary.txt" }
  tail -n 180 "$output/boundary.txt"
}
printf 'archive_readback=COMPLETE product_acceptance=FAIL_UNCHANGED physical_C67=NOT_RUN\n'
