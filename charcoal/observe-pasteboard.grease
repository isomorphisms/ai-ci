#!/usr/bin/env grease
# Shared real-app launch sampler; the original seven-argument entry is Pasteboard.
set -eu -o pipefail
if (len(ARGV) < 7 or len(ARGV) > 8) { echo 'requires ADB SERIAL SDK APK GREASE NEW_OUTPUT API [chord]' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var sdk = ARGV[2]
var apk = ARGV[3]
var runtime = ARGV[4]
var output = ARGV[5]
var api = ARGV[6]
var suite = $(realpath "$(dirname "$0")")
var package = 'com.isomorphisms.pasteboard'
var activity = 'android.app.NativeActivity'
var source = 'e3b018bfa12cd1d33cfd8ee4934ef3ce688c2a66'
var functional_run = '41946125428'
var control_crop = 'crop=1:1:120:200,format=rgb24'
var control_rgb = ' *4[5-9] +4[5-9] +4[5-9] *'
var chord = false
if (len(ARGV) === 8) {
  if (ARGV[7] !== 'chord' and ARGV[7] !== 'pasteboard') { echo 'FAIL unknown launch profile' >&2; exit 2 }
}
if (len(ARGV) === 8 and ARGV[7] === 'chord') {
  setvar chord = true
  setvar package = 'org.isomorphisms.chordreader.dev'
  setvar activity = 'org.isomorphisms.NativeViewActivity'
  setvar source = '7255ad083a1c183c42f9766ca3548c256e090daa'
  setvar functional_run = '41950607269'
  setvar control_crop = 'crop=1:1:180:82,format=rgb24'
  setvar control_rgb = ' *5[4-8] +5[4-8] +5[4-8] *'
}
var component = "$package/$activity"
var ffmpeg = $(command -v ffmpeg)
test ! -e "$output"
mkdir -p "$output"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
test "$("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')" = "$api"
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$sdk/build-tools/36.0.0/apksigner" verify --verbose --print-certs "$apk" > "$output/signer.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/signer.txt"
"$adb" -s "$serial" shell pm list packages "$package" > "$output/namespace-before.txt"
try { rg -x -F "package:$package" "$output/namespace-before.txt" }
if (_error.code !== 1) { echo 'FAIL independent visual test requires a fresh namespace' >&2; exit 1 }
"$adb" -s "$serial" install "$apk" > "$output/install.txt"
# Fixed logical geometry makes the empty-board sample positions explicit.
"$adb" -s "$serial" shell wm size 480x960
"$adb" -s "$serial" shell wm density 160
for mode in no yes {
  "$adb" -s "$serial" shell cmd uimode night "$mode" > "$output/night-$mode.txt"
  "$adb" -s "$serial" shell am force-stop "$package"
  "$adb" -s "$serial" shell am start -W -n "$component" > "$output/start-$mode.txt"
  var resumed = false
  for attempt in @(seq 1 20) {
    "$adb" -s "$serial" shell dumpsys activity activities > "$output/activity-$mode.txt"
    try { rg '(mResumedActivity|topResumedActivity)' "$output/activity-$mode.txt" | rg -F "$component" }
    if (_error.code === 0) { setvar resumed = true; break }
    sleep 0.2
  }
  if (not resumed) { echo 'FAIL real application Activity did not resume' >&2; exit 1 }
  if (chord) {
    var ready = false
    for attempt in @(seq 1 6) {
      "$adb" -s "$serial" shell rm -f /sdcard/aici-charcoal-launch.xml
      try { timeout 20 "$adb" -s "$serial" shell uiautomator dump /sdcard/aici-charcoal-launch.xml > "$output/ui-dump-$mode.txt" 2>&1 }
      if (_error.code !== 0) { continue }
      try { rg -F 'dumped to:' "$output/ui-dump-$mode.txt" }
      if (_error.code !== 0) { continue }
      "$adb" -s "$serial" exec-out cat /sdcard/aici-charcoal-launch.xml > "$output/ui-$mode.xml"
      try { rg -q -F 'content-desc="settings"' "$output/ui-$mode.xml" }
      if (_error.code === 0) { setvar ready = true; break }
    }
    if (not ready) { echo 'FAIL fresh Chord Changes controls did not appear' >&2; exit 1 }
  }
  sleep 1
  "$adb" -s "$serial" shell pidof "$package" > "$output/pid-$mode.txt"
  rg -x '[1-9][0-9]*' "$output/pid-$mode.txt"
  "$adb" -s "$serial" exec-out screencap -p > "$output/canvas-$mode.png"
  "$runtime" "$suite/check-frame.grease" "$ffmpeg" "$output/canvas-$mode.png" "$output/canvas-$mode.frame.txt"
  "$ffmpeg" -nostdin -hide_banner -i "$output/canvas-$mode.png" \
    -vf 'crop=1:1:2:200,format=rgb24' -frames:v 1 -f rawvideo "$output/root-$mode.rgb" > "$output/root-$mode.decode.txt" 2>&1
  "$ffmpeg" -nostdin -hide_banner -i "$output/canvas-$mode.png" \
    -vf "$control_crop" -frames:v 1 -f rawvideo "$output/card-$mode.rgb" > "$output/card-$mode.decode.txt" 2>&1
  od -An -tu1 "$output/root-$mode.rgb" > "$output/root-$mode.txt"
  od -An -tu1 "$output/card-$mode.rgb" > "$output/card-$mode.txt"
  # The compositor can quantize by two channel values, as in the View observer.
  rg -x ' *3[1-5] +3[1-5] +3[1-5] *' "$output/root-$mode.txt"
  rg -x "$control_rgb" "$output/card-$mode.txt"
}
"$adb" -s "$serial" shell cmd uimode night no > "$output/night-restored.txt"
sha256sum "$apk" > "$output/apk.sha256"
printf 'source\t%s\nAPI\t%s\nboth_system_modes\tPASS\nreal_resumed_Activity\tPASS\nempty_scene_root_and_control_pixels\tPASS\nfunctional_suite_producer_run\t%s\nstartup_transition_sequence\tNOT_RUN\nrotation\tNOT_RUN\nphysical_C67\tNOT_RUN\n' "$source" "$api" "$functional_run" > "$output/receipt.tsv"
