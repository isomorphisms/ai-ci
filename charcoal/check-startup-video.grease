#!/usr/bin/env grease
# FFMPEG VIDEO FRESH_OUTPUT_PREFIX; native-reader entries with dark owned canvases.
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'requires ffmpeg, actual video and fresh evidence prefix' >&2; exit 2 }
var ffmpeg = ARGV[0]
var video = ARGV[1]
var prefix = ARGV[2]
test -s "$video"
test ! -e "$prefix.frames.txt"
"$ffmpeg" -nostdin -hide_banner -i "$video" \
  -vf 'crop=iw-40:ih-140:20:70,format=yuv444p,signalstats,metadata=print' \
  -an -f null - > "$prefix.frames.txt" 2>&1
var frames = $(rg -c 'lavfi.signalstats.YLOW=' "$prefix.frames.txt")
test "$frames" -ge 2
# Signalstats' low-luma quantile detects a nearly solid light canvas. Small
# icons, light text and the retained launcher artwork are not white screens.
if rg -n 'lavfi.signalstats.YLOW=2[0-9][0-9]([.]0+)?$' "$prefix.frames.txt" > "$prefix.light-frames.txt" {
  echo 'FAIL broad light canvas in captured startup sequence' >&2
  exit 1
}
sha256sum "$video" > "$prefix.video.sha256"
printf 'decoded_frames\t%s\nbroad_light_canvas_guard\tPASS\npartial_surfaces_dialogs\tNOT_QUALIFIED_BY_THIS_GUARD\nphysical_C67\tNOT_RUN\n' "$frames" > "$prefix.receipt.tsv"
echo "PASS captured startup sequence frames=$frames broad light-canvas guard"
