#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) { echo 'requires GREASE RETAINED_FRONTEND_PARTS SHARED_PRESENTATION NEW_OUTPUT' >&2; exit 2 }
var runtime = ARGV[0]
var parts = ARGV[1]
var presentation = ARGV[2]
var output = ARGV[3]
var suite = $(realpath "$(dirname "$0")/..")
test ! -e "$output"
mkdir -p "$output/frontend"
printf '%s  %s\n' fee3f3755e3316402c7fb5941b12a1d27f0ae97bf051fdbe8ddd7ae4ab1bfcfc "$parts/part-aa" \
  dea99b4bfff811949f5cd6a4a8aec5de3d735aca1fbd24da4ca1b2d420ee1678 "$parts/part-ab" \
  1f59b20ac1ac0c220bed0f3091e254a0d7a0d064a2841c4bc05d31ee110bffd7 "$parts/part-ac" \
  b7fa67b2db2fe0f2f7abf585023d748b822bf25083c1f7139c74c61c86706dd5 "$parts/part-ad" > "$output/frontend.sha256"
sha256sum -c "$output/frontend.sha256"
cat "$parts/part-aa" "$parts/part-ab" "$parts/part-ac" "$parts/part-ad" > "$output/frontend.tar.gz"
tar --no-same-owner -xzf "$output/frontend.tar.gz" -C "$output/frontend"
"$runtime" "$suite/examples/autogenerated/charcoal-contrast/replay.grease" "$output/frontend" "$output/contrast"
"$runtime" "$suite/charcoal/test-tokens.grease" "$runtime" "$presentation" "$output/palette"
var ffmpeg = $(command -v ffmpeg)
"$runtime" "$suite/charcoal/self-test.grease" "$runtime" "$ffmpeg" "$output/frames"
printf 'palette_and_mutations\tPASS\ninteger_contrast_and_negatives\tPASS\nframe_guard_and_white_negative\tPASS\nAndroid_execution\tNOT_RUN\nphysical_C67\tNOT_RUN\n' > "$output/receipt.tsv"
