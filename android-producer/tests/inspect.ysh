#!/usr/bin/env grease
set -eu -o pipefail
var script = $(/usr/bin/readlink -f "$0")
var tests = $(/usr/bin/dirname "$script")
var producer = $(/usr/bin/dirname "$tests")
source "$producer/release.ysh"
source "$producer/graph.ysh"
source "$producer/execution.ysh"
source "$producer/decision.ysh"
test "$#" = 5 || reject 'qualification requires RELEASE FIXTURE_ANCHOR DECISION APK FIXTURE_CURRENT_STATE'
no_overrides
verify_release "$1" "$2"
verify_current "$1" "$5" "$2"
var evidence = $(field "$1/release.tsv" evidence_class)
case "$evidence" in AUTHENTICATED_FIXTURE|HOST_OBSERVATION) ;; *) reject 'qualification evidence class required' ;; esac
var source_commit = $(field "$1/release.tsv" source_commit)
verify_decision "$1" "$3" "$4" "$source_commit" miro-a1 android-native-package
