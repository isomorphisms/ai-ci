# Finite, release-owned graph; no request-provided executable or argv.
proc verify_graph(release) {
  /usr/bin/awk -F '\t' '
    NR==1 {if($0!="id\tkind\tdepends_on\texecutable\texecutable_sha256\targv\targv_sha256\toutput")bad=1;next}
    {if(NF!=8||$1!~/^[a-z][a-z0-9-]*$/||seen[$1]++||$4!~/^[A-Za-z0-9_.\/-]+$/||$6!~/^[A-Za-z0-9_.\/-]+$/||$8!~/^[A-Za-z0-9_.\/-]+$/||length($5)!=64||$5!~/^[0-9a-f]+$/||length($7)!=64||$7!~/^[0-9a-f]+$/)bad=1
     for(i=4;i<=8;i+=2)if($i~/^\//||$i~/(^|\/)\.\.?($|\/)/)bad=1
     if(outputs[$8]++)bad=1
     rank["compile"]=1;rank["link"]=2;rank["strip"]=3;rank["package"]=4;rank["inspect"]=5;rank["build-toolchain"]=6;rank["signing"]=7
     if(!($2 in rank)||rank[$2]<previous)bad=1;previous=rank[$2];kinds[$2]++
     if($3!="-"){n=split($3,deps,",");previous_kind=0;for(i=1;i<=n;i++){if(!(deps[i] in completed)||deps[i]==$1)bad=1;if(completed[deps[i]]==rank[$2]-1)previous_kind=1};if(!previous_kind)bad=1}
     else if($2!="compile")bad=1
     completed[$1]=rank[$2]}
    END {for(k in rank)if(!kinds[k])bad=1;for(k in rank)if(k!="compile"&&kinds[k]!=1)bad=1;if(NR<8||NR>257||bad)exit 1}
  ' "$release/stages.tsv" || reject 'invalid finite stage graph'
  var tab = $(printf '\t')
  var header = true
  while IFS="$tab" read -r id kind deps executable executable_sha argv argv_sha output; do
    if test "$header" = true; then setvar header = false; continue; fi
    for path in "$executable" "$argv"; do
      if test "$path" = "$executable"; then
        test -f "$release/$path" || reject "missing executable material: $id"
      else
        regular "$release/$path"
      fi
      /usr/bin/awk -v p="$path" '$2==p{n++} END{if(n!=1)exit 1}' "$release/files.sha256" || reject "stage material not in release closure: $id"
    done
    var observed = $(sha "$release/$executable")
    test "$observed" = "$executable_sha" || reject "stage executable changed: $id"
    var args_digest = $(sha "$release/$argv")
    test "$args_digest" = "$argv_sha" || reject "stage arguments changed: $id"
    /usr/bin/awk 'length($0)>65536||index($0,"\r")||index($0,"\t"){bad=1} END{if(NR>256||bad)exit 1}' "$release/$argv" || reject "invalid stage arguments: $id"
  done < "$release/stages.tsv"
  # Every successful exec, including helpers/interpreters, is independently
  # declared with namespace path, host material path and actual-byte digest.
  /usr/bin/awk -F '\t' 'NF!=3||$1!~/^\/[A-Za-z0-9_.\/-]+$/||$2!~/^\/[A-Za-z0-9_.\/-]+$/||length($3)!=64||$3!~/^[0-9a-f]+$/||seen[$1]++{bad=1} END{if(NR==0||bad)exit 1}' "$release/exec-allowlist.tsv" || reject 'invalid execution allowlist'
  material "$release" exec-allowlist.tsv exec_allowlist_sha256
  while IFS="$tab" read -r observed_path host_path expected; do
    test -f "$host_path" || reject "missing execution material: $observed_path"
    var actual = $(sha "$host_path")
    test "$actual" = "$expected" || reject "execution material changed: $observed_path"
  done < "$release/exec-allowlist.tsv"
}
proc verify_coverage(release) {
  var group = $(field "$release/release.tsv" artifact_group)
  # This registered route qualifies one no-DEX NativeActivity payload per APK.
  # Wider shapes need their own qualified adapter; they are never silently reduced.
  /usr/bin/awk -F '\t' -v group="$group" '
    NR==1 {if($0!="target\tartifact_group\tabi\trequired\tstate\treason")bad=1;next}
    NF!=6||$1!~/^[a-z][a-z0-9-]*$/||seen[$1]++||$2!=group||$4!="required"||$5!="QUALIFIED"||!length($6){bad=1}
    $3!~/^(armeabi-v7a|arm64-v8a|x86|x86_64)$/{bad=1}
    END{if(NR<2||bad)exit 1}
  ' "$release/obligations.tsv" || reject 'required target coverage unavailable'
  /usr/bin/awk -F '\t' '
    NR==1{if($0!="abi\tlibrary\tsha256")bad=1;next}
    NF!=3||$1!~/^(armeabi-v7a|arm64-v8a|x86|x86_64)$/||$2!~/^lib[A-Za-z0-9_]+\.so$/||length($3)!=64||$3!~/^[0-9a-f]+$/{bad=1}
    END{if(NR!=2||bad)exit 1}
  ' "$release/payloads.tsv" || reject 'unqualified APK payload shape'
  var abi = $(/usr/bin/awk -F '\t' 'NR==2{print $1}' "$release/payloads.tsv")
  /usr/bin/awk -F '\t' -v abi="$abi" 'NR>1&&$3!=abi{bad=1} END{if(bad)exit 1}' "$release/obligations.tsv" || reject 'artifact does not cover required ABI'
}
