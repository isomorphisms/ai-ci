#!/usr/bin/env grease
set -eu -o pipefail
# Deployment identity is fixed outside request/application write authority.
var script = $(/usr/bin/readlink -f "$0")
var producer = $(/usr/bin/dirname "$script")
source "$producer/release.ysh"
no_overrides
var release = '/opt/aici/android-producer/current'
var anchor = '/opt/aici/keys/android-producer-release.pem'
test -f "$anchor" && test -f "$release/release.tsv" || {
  echo 'BLOCKED: trusted Android producer release is not deployed' >&2
  exit 1
}
verify_release "$release" "$anchor"
verify_current "$release" '/opt/aici/android-producer/authority/current.tsv' "$anchor"
var own_path = $(/usr/bin/readlink -f "$0")
var own_sha = $(/usr/bin/sha256sum "$own_path" | /usr/bin/awk '{print $1}')
var approved_sha = $(/usr/bin/awk -F '\t' '$1=="entrypoint_sha256" {print $2}' "$release/release.tsv")
test "$own_sha" = "$approved_sha" || { echo 'BLOCKED: executing policy bytes are not the active policy' >&2; exit 1; }
# The manifest is included in the signed release, not selected through main ancestry.
var manifest_sha = $(/usr/bin/sha256sum "$release/files.sha256" | /usr/bin/awk '{print $1}')
var approved_manifest = $(/usr/bin/awk -F '\t' '$1=="files_sha256" {print $2}' "$release/release.tsv")
test "$manifest_sha" = "$approved_manifest" || exit 1
cd "$release" { /usr/bin/sha256sum -c files.sha256 >/dev/null }
require_deployment "$release"
equal_field "$release/release.tsv" evidence_class ISOLATED
source "$release/policy/android-producer/graph.ysh"
source "$release/policy/android-producer/execution.ysh"
source "$release/policy/android-producer/decision.ysh"
test "$#" = 5 || reject 'expected DECISION APK SOURCE_COMMIT TARGET ACCEPTANCE_SCOPE'
verify_decision "$release" "$1" "$2" "$3" "$4" "$5"
