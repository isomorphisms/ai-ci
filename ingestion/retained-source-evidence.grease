#!/usr/bin/env grease
# This validates deterministic contract evidence only, not live corpora.
set -eu
fail() { printf 'retained-source evidence: %s\n' "$*" >&2; exit 2; }
test "$#" = 1 || fail 'usage: retained-source-evidence RECEIPT_TSV'
receipt=$1
awk -F '\t' 'NF!=2 || $2=="" || /\r/ {exit 1} seen[$1]++ {exit 1}' "$receipt" || fail 'invalid TSV receipt'
field() { awk -F '\t' -v key="$1" '$1==key {print $2}' "$receipt"; }
test "$(field evidence_kind)" = synthetic-contract || fail 'this verifier does not accept live-source claims'
test "$(field live_source)" = NOT_RUN || fail 'synthetic evidence cannot qualify a live source'
test "$(field physical_device)" = NOT_RUN || fail 'synthetic evidence cannot qualify a physical device'
test "$(field private_source_inspection)" = NOT_RUN || fail 'private-source inspection is an independent gate'
for key in cloud_source ib_source; do
  value=$(field "$key")
  case $value in *[!0-9a-f]*|'') fail "invalid revision: $key" ;; esac
  test "${#value}" = 40 || fail "invalid revision length: $key"
done
for key in upload_state_sha256 grease_launcher_sha256; do
  value=$(field "$key")
  case $value in *[!0-9a-f]*|'') fail "invalid artifact hash: $key" ;; esac
  test "${#value}" = 64 || fail "invalid artifact hash length: $key"
done
for key in source_intake raw_url_projection upload_stream sdf_generation; do
  test "$(field "$key")" = PASS || fail "required contract did not pass: $key"
done
printf '%s\n' 'PASS: deterministic retained-source/transport evidence shape; no live or physical promotion'
