#!/usr/bin/env grease
# Independent assertions about generated bytes and observed external effects.
set -eu
test "$#" -eq 4 || exit 2
kitchen=$1
grease=$2
output=$3
fp=$4
here=$(dirname "$0")
here=$(CDPATH= cd "$here" && pwd)
test ! -e "$output" || exit 2
mkdir -p "$output/bin"
cp "$here/fixtures/transfer-handoff/gh" "$output/bin/gh"
chmod 700 "$output/bin/gh"
ln -s "$grease" "$output/bin/grease"
runtime_directory=$(dirname "$grease")
ln -s "$runtime_directory/ysh" "$output/bin/ysh"
setglobal ENV.PATH = "$output/bin:$[ENV.PATH]"
setglobal ENV.GREASE_BINARY = grease
generator=$kitchen/tasks/github-repository-transfer/render-standalone-github-repository-organization-transfer.ysh
"$grease" "$generator" isomorphisms Museum_of_Shaders functorial-games isomorphisms 1412731191 conanwu777/Museum_of_Shaders > "$output/program.grease"
"$grease" "$generator" isomorphisms Museum_of_Shaders functorial-games isomorphisms 1412731191 conanwu777/Museum_of_Shaders > "$output/repeated.grease"
cmp "$output/program.grease" "$output/repeated.grease"
"$grease" -n "$output/program.grease" > "$output/parse.txt"
"$grease" -c 'var n = 6 * 7; if (n !== 42) { exit 2 }; echo native-grease' > "$output/runtime.txt"

run_case() {
    scenario=$1
    expected=$2
    expected_posts=$3
    diagnostic=$4
    directory=$output/$scenario
    mkdir -p "$directory/remote"
    setglobal ENV.AICI_TRANSFER_FIXTURE = "$directory/remote"
    setglobal ENV.AICI_TRANSFER_SCENARIO = scenario
    setglobal ENV.FP_TRANSFER_STATE = "$directory/job"
    setglobal ENV.FP_TRANSFER_MODE = 'execute'
    try { "$grease" "$output/program.grease" > "$directory/stdout" 2> "$directory/stderr" }
    var actual = _error.code
    printf '%s\n' "$actual" > "$directory/exit"
    test "$actual" = "$expected" || { cat "$directory/stderr" >&2; echo "FAIL $scenario status $actual expected $expected" >&2; exit 1; }
    count=0
    if test -f "$directory/remote/posts"; then count=$(wc -l < "$directory/remote/posts" | tr -d ' '); fi
    test "$count" = "$expected_posts" || { echo "FAIL $scenario POST count $count"; exit 1; }
    cat "$directory/stdout" "$directory/stderr" > "$directory/combined"
    grep -F "$diagnostic" "$directory/combined" >/dev/null
    printf 'PASS\t%s\texit=%s\tposts=%s\n' "$scenario" "$actual" "$count"
}
run_case normal 0 1 status=verified
run_case member-can-create 0 1 status=verified
run_case already 0 0 action=already_transferred
run_case wrong-login 1 0 'authenticated as'
run_case no-admin 1 0 'administrator permission required'
run_case inactive 1 0 'active organization membership required'
run_case cannot-create 1 0 'creation permission not established'
run_case changed-id 1 0 'repository ID differs'
run_case changed-upstream 1 0 'upstream fork relationship changed'
run_case changed-id-after 1 1 'repository ID differs'
run_case changed-upstream-after 1 1 'upstream fork relationship changed'
run_case collision 1 0 'repository ID differs'
run_case unrelated-redirect 1 0 'source redirects'
run_case destination-redirect 1 0 'destination redirects'
run_case interrupted 1 1 ''
# Same durable operation after ambiguous transport failure: no new POST.
setglobal ENV.AICI_TRANSFER_SCENARIO = 'normal'
try { "$grease" "$output/program.grease" > "$output/resume.stdout" 2> "$output/resume.stderr" }
if (_error.code === 0) { echo 'FAIL interrupted request repeated'; exit 1 }
grep -F 'no second POST' "$output/resume.stderr" >/dev/null
count=$(wc -l < "$output/interrupted/remote/posts" | tr -d ' ')
test "$count" = 1
# A later real convergence may be verified without making a new request.
touch "$output/interrupted/remote/moved"
"$grease" "$output/program.grease" > "$output/converged.stdout" 2> "$output/converged.stderr"
grep -F action=already_transferred "$output/converged.stdout" >/dev/null
count=$(wc -l < "$output/interrupted/remote/posts" | tr -d ' ')
test "$count" = 1
printf 'PASS\tinterrupted-resume\tposts=1\n'
# Retained candidate 7 is a known-bad control: it performs a transfer despite a
# destination redirect. The current generated candidate above must reject it.
mkdir -p "$output/candidate-7-redirect/remote"
setglobal ENV.AICI_TRANSFER_FIXTURE = "$output/candidate-7-redirect/remote"
setglobal ENV.AICI_TRANSFER_SCENARIO = 'destination-redirect'
setglobal ENV.FP_TRANSFER_STATE = "$output/candidate-7-redirect/job"
"$grease" "$kitchen/tasks/github-repository-transfer/7.ysh" isomorphisms Museum_of_Shaders functorial-games isomorphisms 1412731191 conanwu777/Museum_of_Shaders > "$output/candidate-7-redirect/stdout" 2> "$output/candidate-7-redirect/stderr"
count=$(wc -l < "$output/candidate-7-redirect/remote/posts" | tr -d ' ')
test "$count" = 1
printf 'PASS\tknown-bad-candidate-7-redirect\told-posts=1\tcurrent-posts=0\n'
# Cross-owner execution through the maintained FP session, twice.
mkdir -p "$output/controller/remote"
approved_digest=$(sha256sum "$output/program.grease" | cut -d ' ' -f1)
setglobal ENV.FP_APPROVED_PROGRAM_SHA256 = approved_digest
setglobal ENV.AICI_TRANSFER_FIXTURE = "$output/controller/remote"
setglobal ENV.AICI_TRANSFER_SCENARIO = 'normal'
setglobal ENV.FP_TRANSFER_CONTEXT = 'acceptance-fixture'
for pass in 1 2; do
    setglobal ENV.GREASE_BINARY = grease
    setglobal ENV.KITCHEN_ROOT = kitchen
    setglobal ENV.AICI_ROOT = "$here/.."
    setglobal ENV.FP_TRANSFER_JOB_ROOT = "$output/controller/state"
    "$grease" "$fp/scripts/how-to-move-the-users-github-repository-to-a-different-organization.ysh" isomorphisms Museum_of_Shaders functorial-games isomorphisms 1412731191 conanwu777/Museum_of_Shaders > "$output/controller/pass-$pass.stdout" 2> "$output/controller/pass-$pass.stderr"
done
count=$(wc -l < "$output/controller/remote/posts" | tr -d ' ')
test "$count" = 1
grep -F 'PASS canonical destination' "$output/controller/pass-2.stdout" >/dev/null
grep -F 'BLOCKED publication' "$output/controller/pass-2.stdout" >/dev/null
# The default live path must stop before API effects without protected admission.
setglobal ENV.FP_TRANSFER_CONTEXT = 'live'
setglobal ENV.AICI_TRANSFER_FIXTURE = "$output/controller/live-remote"
mkdir -p "$output/controller/live-remote"
try { "$grease" "$fp/scripts/how-to-move-the-users-github-repository-to-a-different-organization.ysh" isomorphisms Museum_of_Shaders functorial-games isomorphisms 1412731191 conanwu777/Museum_of_Shaders > "$output/controller/live.stdout" 2> "$output/controller/live.stderr" }
if (_error.code === 0) { echo 'FAIL live execution admitted by local envelope'; exit 1 }
test ! -f "$output/controller/live-remote/posts"
# Independently reject changed delivered bytes and an absent FP envelope.
mkdir -p "$output/negative"
digest=$(sha256sum "$output/program.grease" | cut -d ' ' -f1)
printf 'program_sha256=%s\nrepository_id=1412731191\ndestination=functorial-games/Museum_of_Shaders\nupstream=conanwu777/Museum_of_Shaders\n' "$digest" > "$output/negative/fp-envelope.tsv"
"$grease" "$here/../transfer-handoff/verify.grease" check "$output/program.grease" "$digest" "$output/negative" functorial-games/Museum_of_Shaders 1412731191 conanwu777/Museum_of_Shaders > "$output/negative/good.txt"
# Even forged producer claims cannot authorize publication through this gate.
printf 'trusted_admission=PASS\nvisible_delivery=PASS\npublication=PASS\n' >> "$output/negative/fp-envelope.tsv"
try { "$grease" "$here/../transfer-handoff/verify.grease" publication "$output/program.grease" "$digest" "$output/negative" functorial-games/Museum_of_Shaders 1412731191 conanwu777/Museum_of_Shaders > "$output/negative/forged.stdout" 2> "$output/negative/forged.stderr" }
if (_error.code === 0) { echo 'FAIL forged local admission authorized publication'; exit 1 }
grep -F 'local records cannot authorize publication' "$output/negative/forged.stderr" >/dev/null
cp "$output/program.grease" "$output/negative/changed.grease"
printf '\n# altered after testing\n' >> "$output/negative/changed.grease"
try { "$grease" "$here/../transfer-handoff/verify.grease" check "$output/negative/changed.grease" "$digest" "$output/negative" functorial-games/Museum_of_Shaders 1412731191 conanwu777/Museum_of_Shaders > "$output/negative/changed.stdout" 2> "$output/negative/changed.stderr" }
if (_error.code === 0) { echo 'FAIL changed delivered bytes accepted'; exit 1 }
grep -F 'differs from tested bytes' "$output/negative/changed.stderr" >/dev/null
mkdir "$output/negative/no-envelope"
try { "$grease" "$here/../transfer-handoff/verify.grease" check "$output/program.grease" "$digest" "$output/negative/no-envelope" functorial-games/Museum_of_Shaders 1412731191 conanwu777/Museum_of_Shaders > "$output/negative/bypass.stdout" 2> "$output/negative/bypass.stderr" }
if (_error.code === 0) { echo 'FAIL missing FP envelope accepted'; exit 1 }
grep -F 'missing Flexible Pipes envelope' "$output/negative/bypass.stderr" >/dev/null
# The original 404 response and exit must both survive successful transfer.
rg -l '"status":"404"' "$output/normal/job" > "$output/404-files.txt"
test -s "$output/404-files.txt"
printf 'PASS\tFP-session-rerun-and-byte-mutations\tposts=1\n'
sha256sum "$output/program.grease" "$grease" "$runtime_directory/ysh"
