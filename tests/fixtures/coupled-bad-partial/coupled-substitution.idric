data CoupledSubstitution : Type where
  together : Substitution → Substitution → CoupledSubstitution

fish_to_chickens : Text → Text
fish_to_chickens text is replace "fish" "chickens" text

apply : CoupledSubstitution → Text → Maybe Text
apply (together (left_from ↦ left_to) (right_from ↦ right_to)) text is
  if contains left_from text AND contains right_from text
    then Just (replace right_from right_to (replace left_from left_to text))
    otherwise Nothing
