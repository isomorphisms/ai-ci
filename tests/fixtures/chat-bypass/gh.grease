#!/usr/bin/env grease
# Disposable GitHub recorder for the read-only positive control.
set -eu

attempts=$[get(ENV, 'AICI_CHAT_BYPASS_ATTEMPTS', '')]
test -n "$attempts" || exit 2
test "$1" = api || exit 2
shift
if test "$1" = --method; then
    test "$2" = POST || exit 2
    printf 'POST\t%s\n' "$3" >> "$attempts"
    exit 91
fi
test "$1" = repos/isomorphisms/Museum_of_Shaders || exit 2
printf '1412731191\n'
