#!/usr/bin/env grease
# Independent scoped acceptance driver, invoked by the registered FP pipeline.
set -eu
test "$#" = 7 || exit 2
catfood=$1
kitchen=$2
fp=$3
runtime=$4
a1=$5
c67=$6
output=$7
here=$(dirname "$0")
here=$(CDPATH= cd "$here" && pwd)
test ! -e "$output" || exit 2
mkdir -p "$output"
run_check() {
    label=$1
    shift
    try { "$@" > "$output/$label.stdout" 2> "$output/$label.stderr" }
    var code = _error.code
    printf '%s\n' "$code" > "$output/$label.exit"
    cat "$output/$label.stdout" "$output/$label.stderr"
    if (code !== 0) { printf 'FAIL %s; exit %s\n' "$label" "$code" >&2; exit "$code" }
    printf 'PASS\t%s\n' "$label"
}
run_check source-pins "$runtime" "$here/transfer-source-pins.grease" "$catfood" "$kitchen" "$here/.." "$fp" "$runtime" "$output"
run_check native-effects "$runtime" "$here/transfer-handoff.grease" "$kitchen" "$runtime" "$output/cases" "$fp"
run_check arm-payloads "$runtime" "$here/grease-package-payloads.grease" "$catfood" "$a1" "$c67" "$output/packages"
run_check android-delivery sh "$catfood/tests/android-delivery.sh"
run_check device-targets sh "$catfood/tests/targets.sh"
run_check c67-delivery sh "$catfood/tests/c67-delivery.sh"
run_check target-mutants sh "$catfood/tests/target-mutations.sh"
printf 'PASS scoped legacy YSH reference and published ARM packaging checks; production Grease NOT_ACCEPTED; physical and live transfer NOT_RUN\n'
