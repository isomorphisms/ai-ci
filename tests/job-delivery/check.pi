"""Independent surface oracle: build captures without calling FP deliver()."""
import sys
import json
from pathlib import Path
from builtins import dict, list, ValueError, Exception, AssertionError
import handoff
import job_delivery

args ∈ list[str] ← sys.argv
root ∈ str ← args[1]
fp ∈ str ← args[2]
output ∈ Path ← Path(args[3])
output.mkdir(parents=True, exist_ok=False)

def visible_event(payload ∈ bytes, response ∈ bytes, sequence ∈ int) → dict[str, object]:
    return {"kind": "visible", "sequence": sequence, "payload_sha256": handoff.digest(payload), "response_sha256": handoff.digest(response), "response_text": response.decode(), "message_id": "fixture-visible-message", "surface": "fixture-visible-chat"}

def dispatch_event(payload ∈ bytes, sequence ∈ int) → dict[str, object]:
    return {"kind": "dispatch", "sequence": sequence, "payload_sha256": handoff.digest(payload), "dispatch_id": "fixture-dispatch"}

def run_case(fixture ∈ str, variant ∈ str) → str:
    payload ∈ bytes ← Path(fp + "/regressions/job-delivery/" + fixture + ".txt").read_bytes()
    if variant == "nested-fence":
        payload ← payload + b"\nKeep this embedded example:\n```text\nexample\n```\n"
    request ∈ dict[str, object] ← {"id": fixture, "text": "Make a Sun job"}
    dispatch_variants ∈ list[str] ← ["visible-dispatch", "dispatched-hidden", "changed-dispatch", "dispatch-first", "duplicate-dispatch", "incomplete-dispatch"]
    if dispatch_variants.__contains__(variant):
        request["delivery_mode"] ← "display-and-dispatch"
        request["explicit_mode"] ← "display-and-dispatch"
        request["source"] ← "human"
    if variant == "dispatch-only" or variant == "implicit-dispatch" or variant == "fake-explicit-dispatch":
        request["delivery_mode"] ← "dispatch-only"
        if variant == "dispatch-only" or variant == "fake-explicit-dispatch":
            request["explicit_mode"] ← "dispatch-only"
            request["source"] ← "human"
        if variant == "dispatch-only":
            request["text"] ← "Dispatch only; execute directly."
    if variant == "recovery-new":
        request["text"] ← "Where’s the text?"
    stage ∈ dict[str, object] ← {"name": "assignment", "kind": "command", "exit_code": 0, "stdout_sha256": handoff.digest(payload)}
    spec ∈ dict[str, object] ← {"audience": "Sun", "model": "fixture-Sun", "source_context": "sanitized recurrence", "request": request}
    try:
        stage ← handoff.compose(stage, payload, spec)
        record ∈ dict[str, object] ← dict(stage["handoff"])
        response ∈ bytes ← handoff.render(payload, "")
        events ∈ list[dict[str, object]] ← []
        if variant == "hidden" or variant == "no-op":
            response ← b""
        elif variant == "github":
            response ← b"The job exists; Sun Y2 is ready.\n"
        elif variant == "dispatched-hidden":
            response ← b"I recorded and dispatched the assignment.\n"
            events.append(dispatch_event(payload, 1))
            record["dispatch_state"] ← "ACCEPTED"
        elif variant == "dispatch-only":
            response ← b""
            events.append(dispatch_event(payload, 1))
            record["dispatch_state"] ← "ACCEPTED"
        elif variant == "summary" or variant == "title" or variant == "link" or variant == "issue" or variant == "created":
            response ← ("The assignment is " + variant + " only; see issue 35.\n").encode()
        else:
            actual ∈ bytes ← payload
            if variant == "mutated":
                actual ← payload.replace(b"Cat Food", b"leaf repo")
            elif variant == "truncated":
                actual ← payload[:45] + b"\n"
            response ← handoff.render(actual, "Summary of the job." if variant == "summary-full" else "")
            if variant == "missing-fence":
                response ← response[:-4]
            elif variant == "hidden-html":
                response ← b"<!--\n" + response + b"-->\n"
            elif variant == "quoted":
                quoted ∈ bytes ← response.replace(b"\n", b"\n> ")
                response ← b"> " + quoted
            elif variant == "raw-full":
                response ← payload
            if variant == "dispatch-first":
                events.append(dispatch_event(payload, 1))
            events.append(visible_event(payload, response, len(events) + 1))
            record["visible_state"] ← "OBSERVED"
            if dispatch_variants.__contains__(variant) and variant != "incomplete-dispatch":
                events.append(dispatch_event(payload + b"changed" if variant == "changed-dispatch" else payload, len(events) + 1))
                record["dispatch_state"] ← "ACCEPTED"
            if variant == "duplicate-dispatch":
                events.append(dispatch_event(payload, len(events) + 1))
        record["events"] ← events
        if variant == "changed-model":
            record["model"] ← "wrong-model"
        elif variant == "changed-request":
            record["request"] ← {"id": fixture, "text": "Dispatch without showing", "delivery_mode": "dispatch-only", "explicit_mode": "dispatch-only", "source": "human"}
        stage["handoff"] ← record
        if variant == "recovery-unhandled" or variant == "recovery-visible":
            stage ← handoff.recover(stage, "Where’s the text?")
            if variant == "recovery-visible":
                record ← dict(stage["handoff"])
                events ← list(record["events"])
                response ← handoff.render(payload, "Recovered text follows.")
                events.append(visible_event(payload, response, len(events) + 1))
                record["visible_state"] ← "OBSERVED"
                record["events"] ← events
                stage["handoff"] ← record
        if variant == "response-swapped":
            response ← handoff.render(payload, "Changed surrounding response.")
        job_delivery.check(stage, payload, response, True)
        return "PASS"
    except ValueError as error:
        return str(error)

lines ∈ list[str] ← Path(root + "/tests/job-delivery/cases.tsv").read_text().splitlines()
if len(lines) < 2 or lines[0] != "id\tfixture\tvariant\texpected":
    raise ValueError("invalid or empty case manifest")
seen ∈ list[str] ← []
results ∈ list[str] ← ["id\texpected\tactual\tresult"]
for line in lines[1:]:
    fields ∈ list[str] ← line.split("\t")
    if len(fields) != 4 or seen.__contains__(fields[0]):
        raise ValueError("invalid/duplicate case")
    seen.append(fields[0])
    actual ∈ str ← run_case(fields[1], fields[2])
    results.append(fields[0] + "\t" + fields[3] + "\t" + actual + "\t" + ("PASS" if actual == fields[3] else "FAIL"))
    if actual != fields[3]:
        output.joinpath("results.tsv").write_text(str("\n".join(results)) + "\n")
        raise AssertionError(fields[0] + ": expected " + fields[3] + ", got " + actual)
    print("PASS " + fields[0] + " -> " + actual)
output.joinpath("results.tsv").write_text(str("\n".join(results)) + "\n")
print("independent delivery cases PASS: " + str(len(seen)))
