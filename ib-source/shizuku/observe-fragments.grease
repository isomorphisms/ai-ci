#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) { echo 'usage: grease observe-fragments.grease AICI INPUT SDK ICK ADB SERIAL INSTALLED NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var sdk = ARGV[2]
var compiler = ARGV[3]
var adb = ARGV[4]
var serial = ARGV[5]
var installed = ARGV[6]
var evidence = ARGV[7]
var grease = ENV.IB_GREASE
if test -e "$evidence" { echo 'FAIL reused fragment evidence' >&2; exit 2 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== ENV.AICI_EXPECTED_ANDROID_API) { exit 1 }
var tools = "$sdk/build-tools/35.0.0"
var baseline_uid = $("$adb" -s "$serial" shell pm list packages -U org.isomorphisms.ib.prepaint | tr -d '\r')
proc install(lane) {
  var apk = "$input/native-client/ib-native-$lane.apk"
  "$tools/apksigner" verify --verbose --print-certs "$apk" > "$evidence/$lane.signer.txt"
  rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/$lane.signer.txt"
  "$tools/aapt2" dump badging "$apk" > "$evidence/$lane.package.txt"
  rg -q -F "package: name='org.isomorphisms.ib.prepaint' versionCode='3'" "$evidence/$lane.package.txt"
  "$adb" -s "$serial" install -r "$apk" > "$evidence/$lane.install.txt" 2>&1
  rg -x -F Success "$evidence/$lane.install.txt"
  var uid = $("$adb" -s "$serial" shell pm list packages -U org.isomorphisms.ib.prepaint | tr -d '\r')
  if (uid !== baseline_uid) { echo 'FAIL fragment replacement changed application UID' >&2; exit 1 }
  var path = $("$adb" -s "$serial" shell pm path org.isomorphisms.ib.prepaint | tr -d '\r' | sed -n 's/^package://p')
  printf '%s\n' "$path" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
  "$adb" -s "$serial" pull "$path" "$evidence/$lane.installed.apk"
  cmp "$apk" "$evidence/$lane.installed.apk"
}
proc snapshot(label) {
  "$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
  "$adb" -s "$serial" root > "$evidence/$label.root.txt" 2>&1
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 0
  "$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/files/arena "$evidence/$label-arena"
  "$adb" -s "$serial" unroot > "$evidence/$label.unroot.txt" 2>&1
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
  chmod 700 "$evidence/$label-arena"
  mkdir -m 700 "$evidence/$label-arena/staging"
}
proc diagnose(label) {
  var capture_phase = 'fragment-navigation'
  if (label === 'offline-fragments') { setvar capture_phase = 'offline-fragments' }
  if (label === 'early-single-scroll-mutant' or label === 'actual-early-link') { setvar capture_phase = 'early-native-link' }
  try {
    "$adb" -s "$serial" logcat -d -v threadtime 2>&1 |
      sed -E 's/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}-[0-9]{10,}/[REDACTED_SERVICE_NONCE]/g' > "$evidence/$label.logcat.txt"
  }
  if test -s "$evidence/$label.logcat.txt" {
    awk '/IBIndependentReadiness|IBIndependentFragmentAddressExpected|IBIndependentFragmentAddressObserved/ {print}' "$evidence/$label.logcat.txt"
    awk '/IBIndependentEarlyLinkTouch|IBIndependentFragmentViewport|IBIndependentFragmentCoordinates|IBIndependentReaderSurface|IBIndependentSurfaceDiagnosticUnavailable|IBIndependentReaderStatus|IBIndependentReaderStack|IBReader.*checked renderer|IBReader.*fragment viewport/ {line[++n]=$0}
      END {for(i=(n>80?n-79:1);i<=n;i++)print line[i]}' "$evidence/$label.logcat.txt"
  }
  # Post-instrumentation screencap can show HOME. Preserve it as a
  # diagnostic only, and separately read the SDK's in-process screenshot.
  try { "$adb" -s "$serial" exec-out screencap -p > "$evidence/$label.png" 2> "$evidence/$label.screen-error.txt" }
  try {
    "$adb" -s "$serial" root > "$evidence/$label.capture-root.txt" 2>&1
    timeout 30 "$adb" -s "$serial" wait-for-device
    "$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/cache/ib-acceptance-$capture_phase.png \
      "$evidence/$label.sdk-document.png" > "$evidence/$label.capture-pull.txt" 2>&1
  }
  try { "$adb" -s "$serial" unroot > "$evidence/$label.capture-unroot.txt" 2>&1 }
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
  if (label === 'actual-fragment') {
    if test -s "$evidence/$label.sdk-document.png" {
      sha256sum "$evidence/$label.sdk-document.png"
      printf '%s\n' 'IB_SCREENSHOT_BEGIN'
      base64 --wrap=4096 "$evidence/$label.sdk-document.png"
      printf '%s\n' 'IB_SCREENSHOT_END'
    }
  }
}
proc observe(phase, label, code, marker) {
  "$grease" "$repository/ib-source/shizuku/prepare-test-screen.grease" "$adb" "$serial" "$evidence/$label.screen"
  try {
    timeout 240 "$adb" -s "$serial" shell am instrument -w -r -e phase "$phase" \
      org.isomorphisms.ib.acceptance/acceptance.shizuku.CapabilityInstrumentation > "$evidence/$label.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$label.exit"
  cat "$evidence/$label.txt"
  diagnose "$label"
  if (status !== 0) { echo 'FAIL fragment observer process' >&2; exit 1 }
  rg -x -F "INSTRUMENTATION_CODE: $code" "$evidence/$label.txt"
  rg -x -F "INSTRUMENTATION_RESULT: stream=$marker" "$evidence/$label.txt"
}
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror \
  "$repository/ingestion/src/fixture_server.c" -o "$evidence/fixture-server"
var fixture_pid = ''
trap --add EXIT { if (len(fixture_pid) > 0) { try { kill -KILL "$fixture_pid" } } }
fork { exec "$evidence/fixture-server" 18491 "$repository/ib-source/reader/network-fixtures" > "$evidence/server.stdout" 2> "$evidence/server.stderr" }
setglobal fixture_pid = $!
var ready = false
for attempt in @(seq 1 100) {
  if rg -q -x -F 'READY 18491' "$evidence/server.stdout" { setvar ready = true; break }
  sleep 0.1
}
if (not ready) { cat "$evidence/server.stderr"; echo 'FAIL fragment fixture did not bind' >&2; exit 1 }
var starter = "/data/local/tmp/ib-shizuku-$(sha256sum "$installed/observer.dex" | cut -d ' ' -f 1)/start"
"$adb" -s "$serial" pull "$starter" "$evidence/observed-starter"
cmp "$installed/official-starter" "$evidence/observed-starter"
var manager = $("$adb" -s "$serial" shell pm path moe.shizuku.privileged.api | tr -d '\r' | sed -n 's/^package://p')
printf '%s\n' "$manager" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
var existing = $("$adb" -s "$serial" shell ps -A -o PID,NAME | tr -d '\r' | awk '$2=="shizuku_server"{print $1}')
if (len(existing) !== 0) { echo 'FAIL reused authority before fragment observer' >&2; exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/start-server.txt" 2>&1
install anchor-zero
observe fragment-navigation zero-point-mutant 0 'java.lang.AssertionError: FAIL fragment target is outside the native viewport'
install anchor-reset
# The first negative's independent screenshot snapshot restarted adbd.
# Restore the same observed official authority before testing old scroll
# behavior; capability absence is not its designated mutation outcome.
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/stale-scroll.stop-server.txt" 2>&1 }
var stale_stop = _error.code
if (stale_stop !== 0 and stale_stop !== 1) { exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/stale-scroll.start-server.txt" 2>&1
observe fragment-navigation stale-scroll-mutant 0 'java.lang.AssertionError: FAIL fragment target is outside the native viewport'
snapshot before-positive
install boundary
# Root/unroot restarts adbd, which can terminate the shell-owned Shizuku
# server. Establish the same observed official authority after the snapshot;
# a missing server must not be misreported as a candidate viewport failure.
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/before-positive.stop-server.txt" 2>&1 }
var stopped = _error.code
if (stopped !== 0 and stopped !== 1) { echo 'FAIL stopping fragment test authority' >&2; exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/positive.start-server.txt" 2>&1
observe fragment-navigation actual-fragment -1 'PASS native fragment touch reaches Unicode target and retained Back Forward'
snapshot committed
var current = "$evidence/committed-arena/last-source"
var previous = "$evidence/before-positive-arena/last-source"
var previous_lines = $(wc -l < "$previous")
var current_lines = $(wc -l < "$current")
if (int(current_lines) !== int(previous_lines) + 2) { echo 'FAIL fragment navigation did not append two retained visits' >&2; exit 1 }
var anchor_id = $(sed -n '2p' "$current")
var anchor_generation = $(sed -n '3p' "$current")
var plain_row = $(tail -n 3 "$current" | head -n 1)
var plain_id = $(printf '%s\n' "$plain_row" | cut -f 1)
var plain_generation = $(printf '%s\n' "$plain_row" | cut -f 2)
for identity in "$anchor_id" "$plain_id" { printf '%s\n' "$identity" | rg -x '[0-9a-f]{48}' }
for generation in "$anchor_generation" "$plain_generation" {
  printf '%s\n' "$generation" | awk '$0!~/^[1-9][0-9]*$/ || length($0)>10 || $0+0>2147483647 {exit 1}'
}
var previous_cursor = $(sed -n '5p' "$previous")
printf '%s\n' "$previous_cursor" | awk '$0!~/^(0|[1-9][0-9]*)$/ || $0+0>127 {exit 1}'
var cursor = int(previous_cursor) + 2
printf 'IBLAST2\n%s\n%s\nIBH1\n%s\n' "$anchor_id" "$anchor_generation" "$cursor" > "$evidence/expected-index-prefix"
head -n -1 "$previous" | tail -n +6 >> "$evidence/expected-index-prefix"
printf '%s\t%s\n%s\t%s\n' "$plain_id" "$plain_generation" "$anchor_id" "$anchor_generation" >> "$evidence/expected-index-prefix"
var digest = $(sha256sum "$evidence/expected-index-prefix" | cut -d ' ' -f 1)
cp "$evidence/expected-index-prefix" "$evidence/expected-index"
printf '%s\n' "$digest" >> "$evidence/expected-index"
cmp "$evidence/expected-index" "$current"
for kind in plain anchor {
  var identity = plain_id
  var generation = plain_generation
  var address = 'http://10.0.2.2:18491/anchor-fixture'
  if (kind === 'anchor') {
    setvar identity = anchor_id
    setvar generation = anchor_generation
    setvar address = 'http://10.0.2.2:18491/anchor-fixture#caf%C3%A9'
  }
  sh "$repository/ib-source/verify.sh" "$evidence/committed-arena" "$identity" "$generation" "$address" > "$evidence/$kind.readback.txt" 2>&1
  cat "$evidence/$kind.readback.txt"
  var receipt = "$evidence/committed-arena/receipts/$identity.tsv"
  var offset = $(awk -F '\t' '$1=="arena_offset"{print $2}' "$receipt")
  var amount = $(awk -F '\t' '$1=="byte_count"{print $2}' "$receipt")
  dd "if=$evidence/committed-arena/responses.arena" "of=$evidence/$kind.original.html" \
    bs=65536 iflag=skip_bytes,count_bytes "skip=$offset" "count=$amount" status=none
  cmp "$repository/ib-source/reader/network-fixtures/bodies/anchor.html" "$evidence/$kind.original.html"
}
# Mutate only an independent host clone of the newly observed source. The
# original fixture begins '<', so '!' necessarily changes a committed byte.
cp -R "$evidence/committed-arena" "$evidence/corrupted-host-arena"
var anchor_offset = $(awk -F '\t' '$1=="arena_offset"{print $2}' "$evidence/committed-arena/receipts/$anchor_id.tsv")
printf '!' | dd "of=$evidence/corrupted-host-arena/responses.arena" bs=1 "seek=$anchor_offset" count=1 conv=notrunc status=none
try {
  sh "$repository/ib-source/verify.sh" "$evidence/corrupted-host-arena" "$anchor_id" "$anchor_generation" \
    'http://10.0.2.2:18491/anchor-fixture#caf%C3%A9' > "$evidence/changed-source.txt" 2>&1
}
var corrupted_status = _error.code
if (corrupted_status !== 1) { echo 'FAIL changed fragment source missed its designated refusal' >&2; exit 1 }
rg -x -F 'ai-ci ib-source: committed bytes differ from receipt SHA-256' "$evidence/changed-source.txt"
# The readback snapshot restarts adbd and may already have ended the
# shell-owned server. Both an observed stop and an already absent server are
# legitimate; the SDK phase independently requires UNAVAILABLE before replay.
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/offline.stop-server.txt" 2>&1 }
var offline_stop = _error.code
if (offline_stop !== 0 and offline_stop !== 1) { echo 'FAIL ending acquisition authority before offline replay' >&2; exit 1 }
observe offline-fragments offline-fragments -1 'PASS retained fragment viewport and Back Forward without Shizuku'
snapshot offline
cmp "$current" "$evidence/offline-arena/last-source"
cmp "$evidence/committed-arena/responses.arena" "$evidence/offline-arena/responses.arena"
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$compiler" "$evidence/fixture-server" "$repository/ingestion/src/fixture_server.c" \
  "$input/native-client/ib-native-boundary.apk" "$input/native-client/ib-native-anchor-zero.apk" \
  "$input/native-client/ib-native-anchor-reset.apk" \
  "$repository/ib-source/reader/network-fixtures/bodies/anchor.html" "$evidence/plain.original.html" \
  "$evidence/anchor.original.html" "$current" > "$evidence/sha256.txt"
# A real reflow followed by one early touchscreen gesture must reach the
# child, rather than being swallowed by an idle zero-distance OverScroller.
# The control keeps the caret/viewport fix but omits only the second SDK call.
install single-scroll
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/early-control.stop-server.txt" 2>&1 }
var early_stopped = _error.code
if (early_stopped !== 0 and early_stopped !== 1) { exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/early-control.start-server.txt" 2>&1
observe early-native-link early-single-scroll-mutant 0 'java.lang.AssertionError: FAIL early native link touch reached the document'
install boundary
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/early-positive.stop-server.txt" 2>&1 }
var early_positive_stopped = _error.code
if (early_positive_stopped !== 0 and early_positive_stopped !== 1) { exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/early-positive.start-server.txt" 2>&1
observe early-native-link actual-early-link -1 'PASS frame-timed native Next touch reaches the document and acquires Reader Two through ICU'
snapshot early-link
var early_root = "$evidence/early-link-arena"
var early_identity = $(sed -n '2p' "$early_root/last-source")
var early_generation = $(sed -n '3p' "$early_root/last-source")
sh "$repository/ib-source/verify.sh" "$early_root" "$early_identity" "$early_generation" \
  http://10.0.2.2:18491/malformed > "$evidence/early-link.readback.txt" 2>&1
cat "$evidence/early-link.readback.txt"
var early_receipt = "$early_root/receipts/$early_identity.tsv"
var early_offset = $(awk -F '\t' '$1=="arena_offset"{print $2}' "$early_receipt")
var early_length = $(awk -F '\t' '$1=="byte_count"{print $2}' "$early_receipt")
dd "if=$early_root/responses.arena" "of=$evidence/early-link-original.html" bs=65536 \
  iflag=skip_bytes,count_bytes "skip=$early_offset" "count=$early_length" status=none
cmp "$repository/ib-source/reader/network-fixtures/bodies/malformed.html" "$evidence/early-link-original.html"
printf 'schema\tib-native-fragment-viewport-v3\napi\t%s\nactual_touch_fragment_link\tPASS\nstrict_UTF8_fragment_target\tPASS\nSDK_target_visibility_and_beginning_exclusion\tPASS\ncompiled_native_zero_point\tREJECTED\ncompiled_native_stale_cursor_animation\tREJECTED\noriginal_HTML_and_committed_ranges\tPASS\nchanged_committed_source\tREJECTED\nordered_history\tPASS\noffline_Back_Forward_positions\tPASS\nArena_bytes_unchanged_offline\tPASS\nframe_timed_real_DOWN_UP_after_reflow\tPASS\ncompiled_native_single_scroll\tREJECTED\nactual_early_link_new_ICU_source\tPASS\nindependent_early_link_original_bytes\tPASS\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
