#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 9) { echo 'usage: grease observe-browser-google.grease AICI INPUT SDK ADB SERIAL INSTALLED NAVIGATION CHORD NEW_EVIDENCE' >&2; exit 2 }
var acceptance = ARGV[0]
var input = ARGV[1]
var sdk = ARGV[2]
var adb = ARGV[3]
var serial = ARGV[4]
var installed = ARGV[5]
var navigation = ARGV[6]
var chord = ARGV[7]
var evidence = ARGV[8]
var grease = ENV.IB_GREASE
if test -e "$evidence" { exit 2 }
umask 077
mkdir -m 700 -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -q -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -q -x x86_64
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -q -x 2000
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== ENV.AICI_EXPECTED_ANDROID_API or (api !== '29' and api !== '34')) { exit 1 }
rg -q -x -F 'actual_touch_link_acquisition	PASS' "$navigation/receipt.tsv"
rg -q -x -F 'independent_source_and_fixture_digests	PASS' "$navigation/receipt.tsv"
proc diagnose(label) {
  try {
    "$adb" -s "$serial" logcat -d -v threadtime 2>&1 |
      sed -E 's/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}-[0-9]{10,}/[REDACTED_SERVICE_NONCE]/g' > "$evidence/$label.logcat.txt"
  }
  try { "$adb" -s "$serial" exec-out screencap -p > "$evidence/$label.png" 2> "$evidence/$label.screen-error.txt" }
  # No source/query/opaque href or capability is printed in the public job log.
  if test -s "$evidence/$label.logcat.txt" {
    awk '/IBReader.*browser-derived source complete=|IBReader.*committed source acquired=|IBReader.*checked renderer exception type=/ {line[++n]=$0}
      END{for(i=(n>12?n-11:1);i<=n;i++)print line[i]}' "$evidence/$label.logcat.txt"
  }
}
proc observe(phase, label, marker) {
  "$grease" "$acceptance/ib-source/shizuku/prepare-test-screen.grease" "$adb" "$serial" "$evidence/$label.screen"
  try {
    timeout 300 "$adb" -s "$serial" shell am instrument -w -r -e phase "$phase" \
      org.isomorphisms.ib.acceptance/acceptance.shizuku.CapabilityInstrumentation > "$evidence/$label.txt" 2>&1
  }
  var result = _error.code
  printf '%s\n' "$result" > "$evidence/$label.exit"
  diagnose "$label"
  if (result !== 0) { echo 'FAIL Google transaction observer process' >&2; exit 1 }
  if ! rg -q -x -F 'INSTRUMENTATION_CODE: -1' "$evidence/$label.txt" { echo 'FAIL Google observer instrumentation status' >&2; exit 1 }
  if ! rg -q -x -F "INSTRUMENTATION_RESULT: stream=$marker" "$evidence/$label.txt" {
    sed -n '/^INSTRUMENTATION_RESULT: stream=/p' "$evidence/$label.txt" > "$evidence/$label.failure.txt"
    echo 'FAIL genuine Google end-to-end semantic assertion; retained private diagnostics identify the stage' >&2
    exit 1
  }
  echo "$marker"
}
observe search-callers callers 'PASS installed no-caller spoofed-referrer wrong-caller and warm SEARCH refusals'
"$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
"$adb" -s "$serial" root > "$evidence/caller-root.txt" 2>&1
timeout 30 "$adb" -s "$serial" wait-for-device
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -q -x 0
"$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/files/arena/last-source "$evidence/caller-index" > "$evidence/caller-pull.txt" 2>&1
"$adb" -s "$serial" unroot > "$evidence/caller-unroot.txt" 2>&1
timeout 30 "$adb" -s "$serial" wait-for-device
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -q -x 2000
cmp "$navigation/actual-arena/last-source" "$evidence/caller-index"
var tools = "$sdk/build-tools/35.0.0"
var chord_apk = "$chord/input/android/chordreader-x86_64.apk"
rg -q -x -F 'source	e6c84d645ad7086a11ae2735258188a49e444d13' "$chord/input-identity.tsv"
"$tools/apksigner" verify --verbose --print-certs "$chord_apk" > "$evidence/chord-signer.txt" 2>&1
rg -q -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/chord-signer.txt"
"$tools/aapt2" dump badging "$chord_apk" > "$evidence/chord-package.txt"
rg -q -F "package: name='org.isomorphisms.chordreader.dev' versionCode='1002'" "$evidence/chord-package.txt"
"$adb" -s "$serial" install -r "$chord_apk" > "$evidence/chord-install.txt" 2>&1
rg -q -x -F Success "$evidence/chord-install.txt"
var starter = "/data/local/tmp/ib-shizuku-$(sha256sum "$installed/observer.dex" | cut -d ' ' -f 1)/start"
"$adb" -s "$serial" pull "$starter" "$evidence/observed-starter" > "$evidence/starter-pull.txt" 2>&1
cmp "$installed/official-starter" "$evidence/observed-starter"
var manager = $("$adb" -s "$serial" shell pm path moe.shizuku.privileged.api | tr -d '\r' | sed -n 's/^package://p')
printf '%s\n' "$manager" | rg -q -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
var existing = $("$adb" -s "$serial" shell ps -A -o PID,NAME | tr -d '\r' | awk '$2=="shizuku_server"{print $1}')
if (len(existing) !== 0) { echo 'FAIL reused Shizuku authority before Google search' >&2; exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/start-server.txt" 2>&1
observe browser-google transaction 'PASS genuine ChordReader browser-assisted Google native result touch destination and retained Back Forward'
"$adb" -s "$serial" logcat -d -v raw -s IBIndependentClickedSearchURL:I '*:S' > "$evidence/clicked-URL.log"
sed '/^[[:space:]]*$/d; /^---------/d' "$evidence/clicked-URL.log" > "$evidence/clicked-URL.txt"
test "$(wc -l < "$evidence/clicked-URL.txt")" = 1
var clicked = $(cat "$evidence/clicked-URL.txt")
"$adb" -s "$serial" logcat -d -v raw -s IBIndependentGoogleResultBody:I '*:S' > "$evidence/native-results.log"
sed '/^---------/d' "$evidence/native-results.log" > "$evidence/native-results.txt"
"$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
"$adb" -s "$serial" shell am force-stop org.isomorphisms.chordreader.dev
"$adb" -s "$serial" shell killall shizuku_server
proc snapshot(label) {
  "$adb" -s "$serial" root > "$evidence/$label.root.txt" 2>&1
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -q -x 0
  "$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/files/arena "$evidence/$label" > "$evidence/$label.pull.txt" 2>&1
  "$adb" -s "$serial" unroot > "$evidence/$label.unroot.txt" 2>&1
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -q -x 2000
  chmod 700 "$evidence/$label"
  mkdir -m 700 "$evidence/$label/staging"
}
snapshot actual-arena
var root = "$evidence/actual-arena"
var index = "$root/last-source"
test "$(wc -l < "$index")" = 11
head -n 10 "$index" > "$evidence/index-prefix"
var index_hash = $(sha256sum "$evidence/index-prefix" | cut -d ' ' -f 1)
test "$(tail -n 1 "$index")" = "$index_hash"
var destination_id = $(sed -n '2p' "$index")
var destination_generation = $(sed -n '3p' "$index")
var dom_id = $(sed -n '9p' "$index" | cut -f 1)
var dom_generation = $(sed -n '9p' "$index" | cut -f 2)
printf '%s\n' "$destination_id" "$dom_id" | rg -q -x '[0-9a-f]{48}'
printf 'IBLAST2\n%s\n%s\nIBH1\n4\n' "$destination_id" "$destination_generation" > "$evidence/expected-index-prefix"
sed -n '6,8p' "$navigation/actual-arena/last-source" >> "$evidence/expected-index-prefix"
printf '%s\t%s\n%s\t%s\n' "$dom_id" "$dom_generation" "$destination_id" "$destination_generation" >> "$evidence/expected-index-prefix"
cmp "$evidence/index-prefix" "$evidence/expected-index-prefix"
if (int(destination_generation) <= int(dom_generation)) { echo 'FAIL actual destination did not receive a new source generation' >&2; exit 1 }
sh "$acceptance/ib-source/verify.sh" "$root" "$destination_id" "$destination_generation" "$clicked" > "$evidence/clicked-original.txt" 2>&1
"$grease" "$acceptance/ib-source/reader/verify-browser-google.grease" \
  "$acceptance" "$root" "$dom_id" "$dom_generation" "$clicked" "$evidence/native-results.txt" "$evidence/source-positive"
observe offline-browser-google offline 'PASS browser-derived Google and original ICU destination reopen and navigate without Shizuku'
"$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
snapshot offline-arena
cmp "$root/responses.arena" "$evidence/offline-arena/responses.arena"
cmp "$root/responses.arena.used" "$evidence/offline-arena/responses.arena.used"
cmp "$root/last-source" "$evidence/offline-arena/last-source"
proc reject_dom(directory, label, assertion) {
  try {
    "$grease" "$acceptance/ib-source/reader/verify-browser-google.grease" \
      "$acceptance" "$directory" "$dom_id" "$dom_generation" "$clicked" "$evidence/native-results.txt" "$evidence/$label" > "$evidence/$label.txt" 2>&1
  }
  if (_error.code !== 1) { echo 'FAIL changed DOM source missed semantic rejection' >&2; exit 1 }
  rg -q -x -F "$assertion" "$evidence/$label.txt"
}
cp -R "$root" "$evidence/changed-DOM-byte"
var dom_offset = $(awk -F '\t' '$1=="arena_offset"{print $2}' "$root/receipts/$dom_id.dom.tsv")
printf X | dd "of=$evidence/changed-DOM-byte/responses.arena" bs=1 "seek=$dom_offset" conv=notrunc status=none
reject_dom "$evidence/changed-DOM-byte" changed-DOM-byte-refused 'FAIL rendered source field sha256'
cp -R "$root" "$evidence/changed-DOM-generation"
awk -F '\t' 'BEGIN{OFS="\t"}$1=="source_generation"{$2="2147483647"}{print}' \
  "$root/receipts/$dom_id.dom.tsv" > "$evidence/changed-DOM-generation/receipts/$dom_id.dom.tsv"
reject_dom "$evidence/changed-DOM-generation" changed-DOM-generation-refused 'FAIL rendered source field source_generation'
git -C "$acceptance" rev-parse HEAD > "$evidence/observer.commit"
sha256sum "$input/native-client/ib-native-boundary.apk" "$installed/observer.dex" "$root/responses.arena" \
  "$root/last-source" "$root/receipts/$dom_id.dom.tsv" > "$evidence/source-bound.sha256"
printf 'schema\tIB-browser-assisted-Google-E2E-v1\napi\t%s\nABI\tx86_64\nreal_ChordReader_search_and_authenticated_caller\tPASS\nactual_native_result_touch\tPASS\nICU_destination_acquisition\tPASS\nsource_to_native_title_destination\tPASS\nretained_Back_Forward\tPASS\nprocess_death_offline_restore\tPASS\nchanged_DOM_byte_generation\tREJECTED\nGoogle_acquisition\tBROWSER_ASSISTED\nICU_only_Google\tFAIL\nphysical_ARM\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
