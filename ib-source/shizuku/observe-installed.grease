#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 9 and len(ARGV) !== 10) {
  echo 'usage: grease observe-installed.grease AICI INPUT SMALI SDK KEYSTORE SHIZUKU_APK ADB SERIAL NEW_EVIDENCE [reader]' >&2; exit 2
}
var repository = ARGV[0]
var input = ARGV[1]
var smali = ARGV[2]
var sdk = ARGV[3]
var keystore = ARGV[4]
var shizuku = ARGV[5]
var adb = ARGV[6]
var serial = ARGV[7]
var evidence = ARGV[8]
var reader = false
if (len(ARGV) === 10) {
  if (ARGV[9] !== 'reader') { echo 'FAIL unknown installed observer mode' >&2; exit 2 }
  setvar reader = true
}
if rg -x -F 'schema	ib-native-reader-worker-build-v1' "$input/receipt.tsv" {
  if (not reader) { echo 'FAIL complete worker candidate requires the declared reader observer' >&2; exit 1 }
} else {
  if (reader) { echo 'FAIL reader observer requires the maintained complete worker producer' >&2; exit 1 }
}
for path in "$repository" "$input" "$smali" "$sdk" "$keystore" "$shizuku" "$adb" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute installed-observer input required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused installed Shizuku evidence' >&2; exit 2 }
mkdir -p "$evidence"
# This destructive-to-server control is confined to a verified emulator with
# no pre-existing target packages. It is never a physical device procedure.
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== '29' and api !== '34') { echo 'FAIL undeclared emulator API' >&2; exit 1 }
if (api !== ENV.AICI_EXPECTED_ANDROID_API) { echo 'FAIL observed API differs from declared lane' >&2; exit 1 }
"$adb" -s "$serial" shell getprop ro.build.fingerprint > "$evidence/fingerprint.txt"
for package in org.isomorphisms.ib.prepaint moe.shizuku.privileged.api org.isomorphisms.ib.acceptance {
  var installed = $("$adb" -s "$serial" shell pm list packages "$package" | tr -d '\r')
  if (len(installed) !== 0) { echo 'FAIL installed observer requires a fresh emulator package namespace' >&2; exit 1 }
}
printf '6e273ab0e991c4e79bc8b1bbb9b9dd739ccac1a8712a541a214078886b7b790f  %s\n' "$shizuku" | sha256sum -c -
printf 'd83f7a36a205e49b4c755f37d27a0ded02779acc0da82a22e19d458dc6e5a89a  %s\n' "$keystore" | sha256sum -c -
var tools = "$sdk/build-tools/35.0.0"
"$tools/apksigner" verify --verbose --print-certs "$shizuku" > "$evidence/shizuku-signer.txt"
rg -x -F 'Signer #1 certificate SHA-256 digest: 268b5590e868fb08bae7e0ac413564cd1ff88f5ccff74af9dbd0dc918e30db30' "$evidence/shizuku-signer.txt"
for lane in boundary uid-bypass death-noop strict-flags {
  var apk = "$input/ib-native-$lane.apk"
  "$tools/apksigner" verify --verbose --print-certs "$apk" > "$evidence/$lane.signer.txt"
  rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/$lane.signer.txt"
  "$tools/aapt2" dump badging "$apk" > "$evidence/$lane.package.txt"
  rg -q -F "package: name='org.isomorphisms.ib.prepaint' versionCode='3'" "$evidence/$lane.package.txt"
}
java -jar "$smali" assemble "$repository/ib-source/shizuku/installed" -o "$evidence/observer.dex"
"$tools/aapt2" link --manifest "$repository/ib-source/shizuku/installed/AndroidManifest.xml" \
  -I "$sdk/platforms/android-34/android.jar" -o "$evidence/observer-base.apk"
cp "$evidence/observer-base.apk" "$evidence/observer-unsigned.apk"
cp "$evidence/observer.dex" "$evidence/classes.dex"
cd "$evidence"
zip -q observer-unsigned.apk classes.dex
"$tools/zipalign" -f -p 4 "$evidence/observer-unsigned.apk" "$evidence/observer-aligned.apk"
"$tools/apksigner" sign --ks "$keystore" --ks-key-alias wegert-debug \
  --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --out "$evidence/observer.apk" "$evidence/observer-aligned.apk"
"$tools/apksigner" verify --verbose --print-certs "$evidence/observer.apk" > "$evidence/observer-signer.txt"
"$adb" -s "$serial" install -r "$shizuku" > "$evidence/install-manager.txt" 2>&1
"$adb" -s "$serial" install -r "$evidence/observer.apk" > "$evidence/install-observer.txt" 2>&1
var first_uid = ''
proc install_candidate(lane, label) {
  var apk = "$input/ib-native-$lane.apk"
  "$adb" -s "$serial" install -r "$apk" > "$evidence/$label.install.txt" 2>&1
  rg -x -F Success "$evidence/$label.install.txt"
  var observed_uid = $("$adb" -s "$serial" shell pm list packages -U org.isomorphisms.ib.prepaint | tr -d '\r')
  printf '%s\n' "$observed_uid" | rg -x 'package:org\.isomorphisms\.ib\.prepaint uid:[1-9][0-9]{4,}'
  if (len(first_uid) === 0) { setglobal first_uid = observed_uid }
  if (first_uid !== observed_uid) { echo 'FAIL replacement changed the application UID' >&2; exit 1 }
  var installed_path = $("$adb" -s "$serial" shell pm path org.isomorphisms.ib.prepaint | tr -d '\r' | sed -n 's/^package://p')
  printf '%s\n' "$installed_path" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
  "$adb" -s "$serial" pull "$installed_path" "$evidence/$label.installed.apk"
  cmp "$apk" "$evidence/$label.installed.apk"
  "$adb" -s "$serial" shell dumpsys package org.isomorphisms.ib.prepaint > "$evidence/$label.installed-package.txt"
}
proc diagnose(label) {
  # User-service attachment nonces are not source/provenance identifiers.
  # Preserve numeric stages and caller observations while redacting them.
  try {
    "$adb" -s "$serial" logcat -d -v threadtime 2>&1 |
      sed -E 's/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}-[0-9]{10,}/[REDACTED_SERVICE_NONCE]/g' > "$evidence/$label.logcat.txt"
  }
  try { "$adb" -s "$serial" exec-out screencap -p > "$evidence/$label.screen.png" 2> "$evidence/$label.screen-error.txt" }
  try { "$adb" -s "$serial" shell uiautomator dump /data/local/tmp/ib-boundary-diagnostic.xml > "$evidence/$label.dump.txt" 2>&1 }
  try { "$adb" -s "$serial" pull /data/local/tmp/ib-boundary-diagnostic.xml "$evidence/$label.ui.xml" > "$evidence/$label.pull-ui.txt" 2>&1 }
}
proc observe(phase, label, code, marker) {
  try {
    timeout 150 "$adb" -s "$serial" shell am instrument -w -r -e phase "$phase" \
      org.isomorphisms.ib.acceptance/acceptance.shizuku.CapabilityInstrumentation > "$evidence/$label.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$label.exit"
  cat "$evidence/$label.txt"
  if (status !== 0) { diagnose "$label"; echo 'FAIL observer process exit' >&2; exit 1 }
  if ! rg -x -F "INSTRUMENTATION_CODE: $code" "$evidence/$label.txt" { diagnose "$label"; exit 1 }
  if ! rg -x -F "INSTRUMENTATION_RESULT: stream=$marker" "$evidence/$label.txt" { diagnose "$label"; exit 1 }
}
install_candidate boundary positive-before-server
try {
  timeout 90 "$adb" -s "$serial" shell am instrument -w -r \
    org.isomorphisms.ib.acceptance/acceptance.shizuku.ProviderIntruder > "$evidence/external-caller.txt" 2>&1
}
var external_status = _error.code
cat "$evidence/external-caller.txt"
if (external_status !== 0) { diagnose external-caller; exit 1 }
if ! rg -x -F 'INSTRUMENTATION_CODE: -1' "$evidence/external-caller.txt" { diagnose external-caller; exit 1 }
if ! rg -x -F 'INSTRUMENTATION_RESULT: stream=PASS independent external provider caller refused by Android' "$evidence/external-caller.txt" { diagnose external-caller; exit 1 }
observe missing absent-and-unauthorized -1 'PASS installed IB unavailable capability and unprivileged delivery refusal'
install_candidate uid-bypass caller-mutant
observe missing caller-mutant 0 'java.lang.AssertionError: FAIL unprivileged Shizuku capability delivery'
install_candidate boundary restored-before-server
observe missing restored-absence -1 'PASS installed IB unavailable capability and unprivileged delivery refusal'
var remote = "/data/local/tmp/ib-shizuku-$(sha256sum "$evidence/observer.dex" | cut -d ' ' -f 1)"
"$adb" -s "$serial" shell test ! -e "$remote"
"$adb" -s "$serial" shell mkdir -m 700 "$remote"
unzip -p "$shizuku" lib/x86_64/libshizuku.so > "$evidence/official-starter"
"$adb" -s "$serial" push "$evidence/official-starter" "$remote/start"
"$adb" -s "$serial" shell chmod 500 "$remote/start"
"$adb" -s "$serial" pull "$remote/start" "$evidence/received-starter"
cmp "$evidence/official-starter" "$evidence/received-starter"
var manager_path = $("$adb" -s "$serial" shell pm path moe.shizuku.privileged.api | tr -d '\r' | sed -n 's/^package://p')
printf '%s\n' "$manager_path" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
"$adb" -s "$serial" pull "$manager_path" "$evidence/installed-manager.apk"
cmp "$shizuku" "$evidence/installed-manager.apk"
proc start_server(label) {
  var existing = $("$adb" -s "$serial" shell ps -A -o PID,NAME | tr -d '\r' | awk '$2 == "shizuku_server" { print $1 }')
  if (len(existing) !== 0) { echo 'FAIL reused Shizuku server process' >&2; exit 1 }
  "$adb" -s "$serial" shell "$remote/start" "--apk=$manager_path" > "$evidence/$label.start.txt" 2>&1
  cat "$evidence/$label.start.txt"
  var found = false
  for attempt in @(seq 1 100) {
    var pid = $("$adb" -s "$serial" shell ps -A -o PID,NAME | tr -d '\r' | awk '$2 == "shizuku_server" { print $1 }')
    if (len(pid) !== 0) {
      printf '%s\n' "$pid" | rg -x '[1-9][0-9]*' > "$evidence/$label.pid.txt"
      setvar found = true
      break
    }
    sleep 0.2
  }
  if (not found) { diagnose "$label"; echo 'FAIL official Shizuku did not start' >&2; exit 1 }
}
install_candidate strict-flags transport-mutant
start_server positive-server
observe authorize transport-mutant 0 'java.lang.AssertionError: FAIL real Shizuku provider delivery and application attachment'
install_candidate boundary restored-after-transport-mutant
observe authorize actual-permission-and-death -1 'PASS installed IB real Shizuku denial grant and Binder death'
install_candidate death-noop death-mutant
start_server mutant-server
observe death-only death-mutant 0 'java.lang.AssertionError: FAIL revoked Shizuku capability after Binder death'
install_candidate boundary restored-after-mutants
start_server restored-server
observe death-only legitimate-reconnection -1 'PASS installed IB authorized reconnection and Binder death'
if (reader) {
  start_server reader-server
  observe read-example actual-native-document -1 'PASS installed native URL entry actual Example Domain and acknowledged retained source'
  diagnose after-native-document
  "$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
  "$adb" -s "$serial" shell killall shizuku_server
  observe retained-example retained-without-worker -1 'PASS installed native retained Example Domain reopened with Shizuku unavailable'
  install_candidate boundary retained-update
  observe retained-example retained-after-update -1 'PASS installed native retained Example Domain reopened with Shizuku unavailable'
  "$adb" -s "$serial" reboot
  timeout 90 "$adb" -s "$serial" wait-for-device
  var booted = false
  for attempt in @(seq 1 120) {
    var boot = $("$adb" -s "$serial" shell getprop sys.boot_completed | tr -d '\r')
    if (boot === '1') { setvar booted = true; break }
    sleep 1
  }
  if (not booted) { diagnose reboot; echo 'FAIL emulator reboot did not complete' >&2; exit 1 }
  "$adb" -s "$serial" shell input keyevent 82
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
  observe retained-example retained-after-reboot -1 'PASS installed native retained Example Domain reopened with Shizuku unavailable'
  # Root is used only by this independent observer, after the real shell-UID
  # Shizuku transactions and UI observations. No candidate process gains it.
  "$adb" -s "$serial" root > "$evidence/snapshot-root.txt" 2>&1
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 0
  "$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/files/arena "$evidence/actual-arena"
  "$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/cache/ib-acceptance-retained-example.png "$evidence/retained-document.png"
  "$adb" -s "$serial" unroot > "$evidence/snapshot-unroot.txt" 2>&1
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
  chmod 700 "$evidence/actual-arena"
  # This host-only directory belongs to the independent oracle's temporary
  # reads. It neither modifies the tablet nor creates a publication receipt.
  mkdir -m 700 "$evidence/actual-arena/staging"
  var id = $(sed -n '2p' "$evidence/actual-arena/last-source")
  var generation = $(sed -n '3p' "$evidence/actual-arena/last-source")
  printf '%s\n' "$id" | rg -x '[0-9a-f]{48}'
  printf '%s\n' "$generation" | rg -x '[1-9][0-9]{0,9}'
  test "$(head -n 1 "$evidence/actual-arena/last-source")" = IBLAST1
  test "$(head -n 3 "$evidence/actual-arena/last-source" | sha256sum | cut -d ' ' -f 1)" = "$(sed -n '4p' "$evidence/actual-arena/last-source")"
  sh "$repository/ib-source/verify.sh" "$evidence/actual-arena" "$id" "$generation" https://example.com/ > "$evidence/independent-source-readback.txt" 2>&1
  cat "$evidence/independent-source-readback.txt"
  cp -R "$evidence/actual-arena" "$evidence/corrupted-arena"
  var offset = $(awk -F '\t' '$1=="arena_offset"{print $2}' "$evidence/corrupted-arena/receipts/$id.tsv")
  printf '%s\n' "$offset" | rg -x '[0-9]+'
  printf '\000' | dd of="$evidence/corrupted-arena/responses.arena" bs=1 "seek=$offset" conv=notrunc status=none
  try {
    sh "$repository/ib-source/verify.sh" "$evidence/corrupted-arena" "$id" "$generation" https://example.com/ > "$evidence/corrupt-source.stdout" 2> "$evidence/corrupt-source.stderr"
  }
  if (_error.code === 0) { echo 'FAIL independently corrupted committed body was accepted' >&2; exit 1 }
  test ! -s "$evidence/corrupt-source.stdout"
  rg -x -F 'ai-ci ib-source: committed bytes differ from receipt SHA-256' "$evidence/corrupt-source.stderr"
  printf 'schema\tib-installed-native-document-v1\nactual_URL_entry\tPASS\nvisible_Example_Domain\tPASS\nacknowledged_last_source\tPASS\nreopen_without_Shizuku\tPASS\nreplacement_install\tPASS\nemulator_reboot\tPASS\nindependent_committed_readback\tPASS\nchanged_committed_byte\tREJECTED\nphysical_TAB_P10\tNOT_RUN\nlinks_history_exact_copy_SEARCH\tNOT_RUN\n' > "$evidence/reader-receipt.tsv"
  sha256sum "$evidence/retained-document.png" "$evidence/actual-arena/last-source" \
    "$evidence/actual-arena/responses.arena" "$evidence/actual-arena/receipts/$id.tsv" > "$evidence/reader-artifacts.sha256"
  cat "$evidence/reader-receipt.tsv"
}
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$evidence/observer.dex" "$evidence/observer.apk" "$shizuku" "$evidence/official-starter" \
  "$input/ib-native-boundary.apk" "$input/ib-native-uid-bypass.apk" "$input/ib-native-death-noop.apk" \
  "$input/ib-native-strict-flags.apk" > "$evidence/sha256.txt"
printf 'schema\tib-installed-shizuku-client-v1\napi\t%s\nabi\tx86_64\nsource\tRikkaApps/Shizuku 2650830c5b099ae0dd34fedf614d4f592ca05d65\nreal_Binder_provider_attachment\tPASS\nactual_permission_denial\tPASS\nactual_permission_grant\tPASS\nindependent_identity_queries\tPASS\nexternal_provider_caller\tREJECTED\ncompiled_UID_bypass\tREJECTED\nactual_Binder_death\tPASS\ncompiled_death_noop\tREJECTED\nlegitimate_reconnection\tPASS\nreplacement_install_same_UID\tPASS\nretained_source_after_update\tNOT_RUN\nGrease_ICU_worker\tNOT_RUN\nsource_to_native_document\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
