#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 9) { echo 'usage: grease observe-encoding.grease AICI IB_INPUT SDK ICK ADB SERIAL INSTALLED_EVIDENCE NAVIGATION_EVIDENCE NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var sdk = ARGV[2]
var compiler = ARGV[3]
var adb = ARGV[4]
var serial = ARGV[5]
var installed = ARGV[6]
var navigation = ARGV[7]
var evidence = ARGV[8]
var grease = ENV.IB_GREASE
for path in "$repository" "$input" "$sdk" "$compiler" "$adb" "$installed" "$navigation" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused encoding evidence' >&2; exit 2 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== ENV.AICI_EXPECTED_ANDROID_API or (api !== '29' and api !== '34')) { exit 1 }
rg -x -F 'installed_HTTP_404_refusal	PASS' "$navigation/receipt.tsv"
rg -x -F 'no_caller_spoofed_referrer_wrong_caller_warm_SEARCH	REJECTED' "$navigation/receipt.tsv"
var fixtures = "$repository/ib-source/reader/network-fixtures"
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror \
  "$repository/ingestion/src/fixture_server.c" -o "$evidence/fixture-server"
var fixture_pid = ''
trap --add EXIT {
  if (len(fixture_pid) > 0) { try { kill -KILL "$fixture_pid" } }
}
fork { exec "$evidence/fixture-server" 18491 "$fixtures" > "$evidence/server.stdout" 2> "$evidence/server.stderr" }
setglobal fixture_pid = $!
var ready = false
for attempt in @(seq 1 100) {
  if rg -q -x -F 'READY 18491' "$evidence/server.stdout" { setvar ready = true; break }
  sleep 0.1
}
if (not ready) { cat "$evidence/server.stderr" >&2; echo 'FAIL encoding fixture did not bind' >&2; exit 1 }
var starter = "/data/local/tmp/ib-shizuku-$(sha256sum "$installed/observer.dex" | cut -d ' ' -f 1)/start"
"$adb" -s "$serial" pull "$starter" "$evidence/observed-starter"
cmp "$installed/official-starter" "$evidence/observed-starter"
var manager = $("$adb" -s "$serial" shell pm path moe.shizuku.privileged.api | tr -d '\r' | sed -n 's/^package://p')
printf '%s\n' "$manager" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
var old_server = $("$adb" -s "$serial" shell ps -A -o PID,NAME | tr -d '\r' | awk '$2=="shizuku_server"{print $1}')
if (len(old_server) !== 0) { echo 'FAIL reused Shizuku server before encoding continuation' >&2; exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/start-server.txt" 2>&1
proc diagnose(label) {
  try {
    "$adb" -s "$serial" logcat -d -v threadtime 2>&1 |
      sed -E 's/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}-[0-9]{10,}/[REDACTED_SERVICE_NONCE]/g' > "$evidence/$label.logcat.txt"
  }
  try { "$adb" -s "$serial" exec-out screencap -p > "$evidence/$label.png" 2> "$evidence/$label.screen-error.txt" }
}
proc observe(phase, label, marker) {
  try {
    timeout 240 "$adb" -s "$serial" shell am instrument -w -r -e phase "$phase" \
      org.isomorphisms.ib.acceptance/acceptance.shizuku.CapabilityInstrumentation > "$evidence/$label.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$label.exit"
  cat "$evidence/$label.txt"
  if (status !== 0) { diagnose "$label"; exit 1 }
  if ! rg -x -F 'INSTRUMENTATION_CODE: -1' "$evidence/$label.txt" { diagnose "$label"; exit 1 }
  if ! rg -x -F "INSTRUMENTATION_RESULT: stream=$marker" "$evidence/$label.txt" { diagnose "$label"; exit 1 }
}
observe encoded-documents actual-codecs 'PASS installed actual ICU windows-1252 ISO-8859-1 decoding exact clipboard and reflow'
diagnose after-codecs
"$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
"$adb" -s "$serial" shell killall shizuku_server
observe offline-encoded-documents offline-codecs 'PASS installed original-byte retained non-UTF-8 documents reopen and navigate without Shizuku'
"$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
"$adb" -s "$serial" reboot
timeout 90 "$adb" -s "$serial" wait-for-device
var booted = false
for attempt in @(seq 1 120) {
  var boot = $("$adb" -s "$serial" shell getprop sys.boot_completed | tr -d '\r')
  if (boot === '1') { setvar booted = true; break }
  sleep 1
}
if (not booted) { echo 'FAIL encoding reboot did not complete' >&2; exit 1 }
"$adb" -s "$serial" shell input keyevent 82
observe offline-encoded-documents rebooted-codecs 'PASS installed original-byte retained non-UTF-8 documents reopen and navigate without Shizuku'
"$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
"$adb" -s "$serial" root > "$evidence/snapshot-root.txt" 2>&1
timeout 30 "$adb" -s "$serial" wait-for-device
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 0
"$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/files/arena "$evidence/actual-arena"
"$adb" -s "$serial" unroot > "$evidence/snapshot-unroot.txt" 2>&1
timeout 30 "$adb" -s "$serial" wait-for-device
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
chmod 700 "$evidence/actual-arena"
mkdir -m 700 "$evidence/actual-arena/staging"
try {
  "$grease" "$repository/ib-source/reader/verify-encoding-index.grease" "$repository" "$evidence/actual-arena" \
    "$evidence/actual-arena/last-source" "$navigation/actual-arena/last-source" "$fixtures" "$evidence/index" > "$evidence/index.txt" 2>&1
}
var result = _error.code
cat "$evidence/index.txt"
if (result !== 0) { exit "$result" }
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$compiler" "$evidence/fixture-server" "$repository/ingestion/src/fixture_server.c" \
  "$input/native-client/ib-native-boundary.apk" "$installed/observer.dex" \
  "$fixtures/bodies/windows-1252.hex" "$fixtures/bodies/latin-1.hex" \
  "$evidence/actual-arena/last-source" "$evidence/actual-arena/responses.arena" > "$evidence/sha256.txt"
printf 'schema\tib-installed-source-decoding-v1\napi\t%s\nabi\tx86_64\nactual_ICU_windows1252_ISO88591\tPASS\nactual_SDK_original_octet_carrier\tPASS\nchecked_decode_admission\tPASS\nsource_faithful_decoded_clipboard\tPASS\nWindows_source_copy_after_reflow\tPASS\noffline_history_and_reboot\tPASS\nindependent_original_bytes_identity_generation_digest\tPASS\nraw_receipt_promoted_to_admission\tNO\nchanged_expected_charset\tREJECTED\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
