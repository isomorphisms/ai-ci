#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'usage: grease observe-parcelable.grease AICI INPUT SMALI ADB SERIAL NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
var serial = ARGV[4]
var evidence = ARGV[5]
for path in "$repository" "$input" "$smali" "$adb" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused Parcelable ART evidence' >&2; exit 2 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== '29' and api !== '34') { echo 'FAIL undeclared ART API' >&2; exit 1 }
if (api !== ENV.AICI_EXPECTED_ANDROID_API) { echo 'FAIL observed API differs from declared lane' >&2; exit 1 }
"$adb" -s "$serial" shell getprop ro.build.fingerprint > "$evidence/fingerprint.txt"
java -jar "$smali" assemble "$repository/ib-source/shizuku/ParcelableObserver.smali" -o "$evidence/observer.dex"
var dex_digest = $(sha256sum "$input/parcelable.dex" | cut -d ' ' -f 1)
for lane in x86_64 x86_64-mutant {
  var native = "$input/$lane/libib_reader.so"
  test -s "$native"
  var native_digest = $(sha256sum "$native" | cut -d ' ' -f 1)
  var remote = "/data/local/tmp/ib-parcelable-$dex_digest-$native_digest"
  "$adb" -s "$serial" shell test ! -e "$remote"
  "$adb" -s "$serial" shell mkdir "$remote"
  "$adb" -s "$serial" push "$input/parcelable.dex" "$remote/parcelable.dex"
  "$adb" -s "$serial" push "$evidence/observer.dex" "$remote/observer.dex"
  "$adb" -s "$serial" push "$native" "$remote/libib_reader.so"
  "$adb" -s "$serial" shell chmod 444 "$remote/parcelable.dex" "$remote/observer.dex" "$remote/libib_reader.so"
  "$adb" -s "$serial" pull "$remote/parcelable.dex" "$evidence/$lane.received.dex"
  "$adb" -s "$serial" pull "$remote/libib_reader.so" "$evidence/$lane.received.so"
  cmp "$input/parcelable.dex" "$evidence/$lane.received.dex"
  cmp "$native" "$evidence/$lane.received.so"
  try {
    timeout 120 "$adb" -s "$serial" shell -T \
      "LD_LIBRARY_PATH=$remote CLASSPATH=$remote/parcelable.dex:$remote/observer.dex app_process -Xcheck:jni -Djava.library.path=$remote /system/bin acceptance.ParcelableObserver" \
      > "$evidence/$lane.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$lane.exit"
  cat "$evidence/$lane.txt"
  var expected = 0
  var marker = 'PASS independent native Shizuku Parcelable wire on ART'
  if (lane === 'x86_64-mutant') {
    setvar expected = 73
    setvar marker = 'FAIL native Shizuku Parcelable Binder identity'
  }
  if (status !== expected) {
    try { "$adb" -s "$serial" logcat -d -v threadtime > "$evidence/$lane.logcat.txt" 2>&1 }
    echo "FAIL wrong Parcelable ART exit: $lane observed $status expected $expected" >&2
    exit 1
  }
  rg -x -F "$marker" "$evidence/$lane.txt"
}
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$evidence/observer.dex" "$input/parcelable.dex" \
  "$input/x86_64/libib_reader.so" "$input/x86_64-mutant/libib_reader.so" > "$evidence/sha256.txt"
printf 'schema\tib-native-parcelable-art-v1\napi\t%s\nabi\tx86_64\nSDK_to_candidate\tPASS\ncandidate_to_SDK\tPASS\ncreator_array_bound\tPASS\nnull_parcel_refusal\tPASS\ncompiled_Binder_identity_mutant\tREJECTED\nreal_cross_process_Binder\tNOT_RUN\nShizuku_authorization\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
