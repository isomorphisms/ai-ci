#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) { echo 'usage: grease observe-reader-lifecycle.grease AICI INPUT SDK ICK ADB SERIAL INSTALLED NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var sdk = ARGV[2]
var compiler = ARGV[3]
var adb = ARGV[4]
var serial = ARGV[5]
var installed = ARGV[6]
var evidence = ARGV[7]
var grease = ENV.IB_GREASE
if test -e "$evidence" { echo 'FAIL reused Activity lifecycle evidence' >&2; exit 2 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== ENV.AICI_EXPECTED_ANDROID_API) { exit 1 }
var tools = "$sdk/build-tools/35.0.0"
var baseline_uid = $("$adb" -s "$serial" shell pm list packages -U org.isomorphisms.ib.prepaint | tr -d '\r')
proc install(lane) {
  var apk = "$input/native-client/ib-native-$lane.apk"
  "$tools/apksigner" verify --verbose --print-certs "$apk" > "$evidence/$lane.signer.txt"
  rg -x -F 'Signer #1 certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$evidence/$lane.signer.txt"
  "$tools/aapt2" dump badging "$apk" > "$evidence/$lane.package.txt"
  rg -q -F "package: name='org.isomorphisms.ib.prepaint' versionCode='3'" "$evidence/$lane.package.txt"
  "$adb" -s "$serial" install -r "$apk" > "$evidence/$lane.install.txt" 2>&1
  rg -x -F Success "$evidence/$lane.install.txt"
  var uid = $("$adb" -s "$serial" shell pm list packages -U org.isomorphisms.ib.prepaint | tr -d '\r')
  if (uid !== baseline_uid) { echo 'FAIL Activity lifecycle replacement changed application UID' >&2; exit 1 }
  var path = $("$adb" -s "$serial" shell pm path org.isomorphisms.ib.prepaint | tr -d '\r' | sed -n 's/^package://p')
  printf '%s\n' "$path" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
  "$adb" -s "$serial" pull "$path" "$evidence/$lane.installed.apk"
  cmp "$apk" "$evidence/$lane.installed.apk"
}
proc snapshot(label) {
  "$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
  "$adb" -s "$serial" root > "$evidence/$label.root.txt" 2>&1
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 0
  "$adb" -s "$serial" pull /data/user/0/org.isomorphisms.ib.prepaint/files/arena "$evidence/$label-arena"
  "$adb" -s "$serial" unroot > "$evidence/$label.unroot.txt" 2>&1
  timeout 30 "$adb" -s "$serial" wait-for-device
  "$adb" -s "$serial" shell id -u | tr -d '\r' | rg -x 2000
  chmod 700 "$evidence/$label-arena"
  mkdir -p -m 700 "$evidence/$label-arena/staging"
}
proc diagnose(label) {
  try {
    "$adb" -s "$serial" logcat -d -v threadtime 2>&1 |
      sed -E 's/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}-[0-9]{10,}/[REDACTED_SERVICE_NONCE]/g' > "$evidence/$label.logcat.txt"
  }
  if test -s "$evidence/$label.logcat.txt" {
    awk '/IBIndependentReadiness|IBIndependentFragmentAddressExpected|IBIndependentFragmentAddressObserved/ {print}' "$evidence/$label.logcat.txt"
    awk '/IBIndependentFragmentViewport|IBIndependentReaderSurface|IBIndependentSurfaceDiagnosticUnavailable|IBIndependentReaderStatus|IBIndependentReaderStack|IBReader.*checked renderer/ {line[++n]=$0}
      END {for(i=(n>30?n-29:1);i<=n;i++)print line[i]}' "$evidence/$label.logcat.txt"
  }
  try { "$adb" -s "$serial" exec-out screencap -p > "$evidence/$label.png" 2> "$evidence/$label.screen-error.txt" }
}
proc observe(phase, label, code, marker) {
  "$grease" "$repository/ib-source/shizuku/prepare-test-screen.grease" "$adb" "$serial" "$evidence/$label.screen"
  try {
    timeout 240 "$adb" -s "$serial" shell am instrument -w -r -e phase "$phase" \
      org.isomorphisms.ib.acceptance/acceptance.shizuku.CapabilityInstrumentation > "$evidence/$label.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$label.exit"
  cat "$evidence/$label.txt"
  diagnose "$label"
  if (status !== 0) { echo 'FAIL Activity lifecycle observer process' >&2; exit 1 }
  rg -x -F "INSTRUMENTATION_CODE: $code" "$evidence/$label.txt"
  if (label === 'detach-any') {
    # Android may deliver the old destroy callback before or after retained
    # readback finishes. Both exact failures mean that callback detached the
    # resumed owner; crashes and unrelated assertions remain unacceptable.
    rg -x -e 'INSTRUMENTATION_RESULT: stream=java.lang.AssertionError: FAIL resumed Activity did not reopen last committed document' \
      -e 'INSTRUMENTATION_RESULT: stream=java.lang.AssertionError: FAIL resumed Activity navigation after stale destroy' "$evidence/$label.txt"
  } else {
    rg -x -F "INSTRUMENTATION_RESULT: stream=$marker" "$evidence/$label.txt"
  }
}
"$compiler" -fno-link-libatomic -std=c11 -O2 -Wall -Wextra -Wpedantic -Werror \
  "$repository/ingestion/src/fixture_server.c" -o "$evidence/fixture-server"
var fixture_pid = ''
var pending_observer_pid = ''
trap --add EXIT {
  if (len(pending_observer_pid) > 0) { try { kill -KILL "$pending_observer_pid" } }
  if (len(fixture_pid) > 0) { try { kill -KILL "$fixture_pid" } }
}
var release_file = "$evidence/release-held-response"
if test -e "$release_file" { exit 2 }
fork { exec "$evidence/fixture-server" 18491 "$repository/ib-source/reader/network-fixtures" "$release_file" > "$evidence/server.stdout" 2> "$evidence/server.stderr" }
setglobal fixture_pid = $!
var ready = false
for attempt in @(seq 1 100) {
  if rg -q -x -F 'READY 18491' "$evidence/server.stdout" { setvar ready = true; break }
  sleep 0.1
}
if (not ready) { cat "$evidence/server.stderr"; echo 'FAIL Activity lifecycle fixture did not bind' >&2; exit 1 }
var starter = "/data/local/tmp/ib-shizuku-$(sha256sum "$installed/observer.dex" | cut -d ' ' -f 1)/start"
"$adb" -s "$serial" pull "$starter" "$evidence/observed-starter"
cmp "$installed/official-starter" "$evidence/observed-starter"
var manager = $("$adb" -s "$serial" shell pm path moe.shizuku.privileged.api | tr -d '\r' | sed -n 's/^package://p')
printf '%s\n' "$manager" | rg -x '/data/app/[A-Za-z0-9_./~+=-]+/base\.apk'
var existing = $("$adb" -s "$serial" shell ps -A -o PID,NAME | tr -d '\r' | awk '$2=="shizuku_server"{print $1}')
if (len(existing) !== 0) {
  "$adb" -s "$serial" shell killall shizuku_server > "$evidence/initial.stop-server.txt" 2>&1
}
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/start-server.txt" 2>&1
install resume-noop
observe reader-lifecycle resume-noop 0 'java.lang.AssertionError: FAIL resumed Activity did not reopen last committed document'
install detach-any
observe reader-lifecycle detach-any 0 'java.lang.AssertionError: FAIL resumed Activity navigation after stale destroy'
install boundary
snapshot completed-control-before
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/completed-control.stop-server.txt" 2>&1 }
var control_stop = _error.code
if (control_stop !== 0 and control_stop !== 1) { exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/completed-control.start-server.txt" 2>&1
"$grease" "$repository/ib-source/shizuku/prepare-test-screen.grease" "$adb" "$serial" "$evidence/completed-control.screen"
fork {
  exec timeout 120 "$adb" -s "$serial" shell am instrument -w -r -e phase complete-held-source \
    org.isomorphisms.ib.acceptance/acceptance.shizuku.CapabilityInstrumentation > "$evidence/completed-control.txt" 2>&1
}
setglobal pending_observer_pid = $!
var control_request = false
for attempt in @(seq 1 500) {
  if rg -q -x -F HELD_REQUEST "$evidence/server.stdout" { setvar control_request = true; break }
  sleep 0.1
}
if (not control_request) { cat "$evidence/completed-control.txt"; echo 'FAIL completed-response control did not reach real ICU request' >&2; exit 1 }
printf 'release\n' > "$release_file"
try { wait "$pending_observer_pid" }
var completed_status = _error.code
setglobal pending_observer_pid = ''
printf '%s\n' "$completed_status" > "$evidence/completed-control.exit"
cat "$evidence/completed-control.txt"
if (completed_status !== 0) { echo 'FAIL completed-response control process' >&2; exit 1 }
rg -q -x -F 'INSTRUMENTATION_CODE: -1' "$evidence/completed-control.txt"
rg -q -x -F 'INSTRUMENTATION_RESULT: stream=PASS controlled completed held acquisition is admitted' "$evidence/completed-control.txt"
test "$(rg -c -x -F HELD_REQUEST "$evidence/server.stdout")" = 1
test "$(rg -c -x -F HELD_RELEASED "$evidence/server.stdout")" = 1
# This process loss happens after successful admission. The independent
# unchanged-state claim must fail, proving that the later kill-before-release
# observation cannot pass merely by comparing arbitrary old paths.
snapshot before-positive
try { cmp "$evidence/completed-control-before-arena/last-source" "$evidence/before-positive-arena/last-source" > "$evidence/completed-control.unchanged-claim.txt" 2>&1 }
var unchanged_control = _error.code
if (unchanged_control !== 1) { echo 'FAIL completed source was misclassified as unchanged interrupted state' >&2; exit 1 }
var control_identity = $(sed -n '2p' "$evidence/before-positive-arena/last-source")
var control_generation = $(sed -n '3p' "$evidence/before-positive-arena/last-source")
sh "$repository/ib-source/verify.sh" "$evidence/before-positive-arena" "$control_identity" "$control_generation" \
  http://10.0.2.2:18491/held-uncommitted > "$evidence/completed-control.readback.txt" 2>&1
cat "$evidence/completed-control.readback.txt"
rm "$release_file"
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/before-positive.stop-server.txt" 2>&1 }
var stopped = _error.code
if (stopped !== 0 and stopped !== 1) { echo 'FAIL stopping lifecycle authority' >&2; exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/positive.start-server.txt" 2>&1
observe reader-lifecycle actual-lifecycle -1 'PASS native reader Activity return retained source new navigation and stale destroy refusal'
snapshot committed
var current = "$evidence/committed-arena/last-source"
var previous = "$evidence/before-positive-arena/last-source"
var previous_lines = $(wc -l < "$previous")
var current_lines = $(wc -l < "$current")
if (int(current_lines) !== int(previous_lines) + 3) { echo 'FAIL Activity lifecycle did not retain exactly three new visits' >&2; exit 1 }
var before_receipts = $(rg --files "$evidence/before-positive-arena/receipts" | wc -l)
var after_receipts = $(rg --files "$evidence/committed-arena/receipts" | wc -l)
if (int(after_receipts) !== int(before_receipts) + 3) { echo 'FAIL Activity resume refetched source or lost a retained receipt' >&2; exit 1 }
var current_id = $(sed -n '2p' "$current")
var current_generation = $(sed -n '3p' "$current")
var previous_cursor = $(sed -n '5p' "$previous")
printf '%s\n' "$previous_cursor" | awk '$0!~/^(0|[1-9][0-9]*)$/ || $0+0>124 {exit 1}'
if (int(previous_cursor) !== int(previous_lines) - 7) { echo 'FAIL lifecycle baseline is not the last retained visit' >&2; exit 1 }
var cursor = int(previous_cursor) + 3
tail -n 4 "$current" | head -n 3 > "$evidence/new-visits.tsv"
printf 'IBLAST2\n%s\n%s\nIBH1\n%s\n' "$current_id" "$current_generation" "$cursor" > "$evidence/expected-index-prefix"
head -n -1 "$previous" | tail -n +6 >> "$evidence/expected-index-prefix"
cat "$evidence/new-visits.tsv" >> "$evidence/expected-index-prefix"
var index_digest = $(sha256sum "$evidence/expected-index-prefix" | cut -d ' ' -f 1)
cp "$evidence/expected-index-prefix" "$evidence/expected-index"
printf '%s\n' "$index_digest" >> "$evidence/expected-index"
cmp "$evidence/expected-index" "$current"
var latest_offset = ''
var latest_identity = ''
var latest_generation = ''
for position in 1 2 3 {
  var row = $(sed -n "${position}p" "$evidence/new-visits.tsv")
  var identity = $(printf '%s\n' "$row" | cut -f 1)
  var generation = $(printf '%s\n' "$row" | cut -f 2)
  printf '%s\n' "$identity" | rg -x '[0-9a-f]{48}'
  printf '%s\n' "$generation" | awk '$0!~/^[1-9][0-9]*$/ || length($0)>10 || $0+0>2147483647 {exit 1}'
  var address = 'http://10.0.2.2:18491/valid'
  var fixture = "$repository/ib-source/reader/network-fixtures/bodies/valid.html"
  if (position === '2') {
    setvar address = 'http://10.0.2.2:18491/malformed'
    setvar fixture = "$repository/ib-source/reader/network-fixtures/bodies/malformed.html"
  }
  sh "$repository/ib-source/verify.sh" "$evidence/committed-arena" "$identity" "$generation" "$address" > "$evidence/$position.readback.txt" 2>&1
  cat "$evidence/$position.readback.txt"
  var receipt = "$evidence/committed-arena/receipts/$identity.tsv"
  var offset = $(awk -F '\t' '$1=="arena_offset"{print $2}' "$receipt")
  var amount = $(awk -F '\t' '$1=="byte_count"{print $2}' "$receipt")
  dd "if=$evidence/committed-arena/responses.arena" "of=$evidence/$position.original.html" \
    bs=65536 iflag=skip_bytes,count_bytes "skip=$offset" "count=$amount" status=none
  cmp "$fixture" "$evidence/$position.original.html"
  setglobal latest_offset = offset
  setglobal latest_identity = identity
  setglobal latest_generation = generation
}
if (current_id !== latest_identity or current_generation !== latest_generation) { echo 'FAIL lifecycle selected source differs from its final retained visit' >&2; exit 1 }
cp -R "$evidence/committed-arena" "$evidence/corrupted-host-arena"
printf '!' | dd "of=$evidence/corrupted-host-arena/responses.arena" bs=1 "seek=$latest_offset" count=1 conv=notrunc status=none
try {
  sh "$repository/ib-source/verify.sh" "$evidence/corrupted-host-arena" "$latest_identity" "$latest_generation" \
    http://10.0.2.2:18491/valid > "$evidence/changed-source.txt" 2>&1
}
if (_error.code !== 1) { echo 'FAIL changed lifecycle source missed its designated refusal' >&2; exit 1 }
rg -x -F 'ai-ci ib-source: committed bytes differ from receipt SHA-256' "$evidence/changed-source.txt"
# Independent process-loss acceptance starts only after the complete
# committed source was read back above. The fixture withholds its response
# until the host has observed the actual ICU request and killed the app.
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/held.stop-server.txt" 2>&1 }
var held_stop = _error.code
if (held_stop !== 0 and held_stop !== 1) { exit 1 }
"$adb" -s "$serial" shell "$starter" "--apk=$manager" > "$evidence/held.start-server.txt" 2>&1
"$grease" "$repository/ib-source/shizuku/prepare-test-screen.grease" "$adb" "$serial" "$evidence/held.screen"
fork {
  exec timeout 90 "$adb" -s "$serial" shell am instrument -w -r -e phase begin-held-source \
    org.isomorphisms.ib.acceptance/acceptance.shizuku.CapabilityInstrumentation > "$evidence/held-instrumentation.txt" 2>&1
}
setglobal pending_observer_pid = $!
var held_ready = false
for attempt in @(seq 1 500) {
  var held_count = $(rg -c -x -F HELD_REQUEST "$evidence/server.stdout")
  if (held_count === '2') { setvar held_ready = true; break }
  sleep 0.1
}
if (not held_ready) { cat "$evidence/held-instrumentation.txt"; echo 'FAIL real ICU did not reach the held response' >&2; exit 1 }
var ui_ready = false
for attempt in @(seq 1 50) {
  "$adb" -s "$serial" logcat -d -v raw -s IBIndependentHeldSource:I '*:S' > "$evidence/held-ready.log"
  if rg -q -x -F 'READY controlled pending acquisition' "$evidence/held-ready.log" { setvar ui_ready = true; break }
  sleep 0.1
}
if (not ui_ready) { echo 'FAIL held acquisition lacked its native input observation' >&2; exit 1 }
var original_pid = $("$adb" -s "$serial" shell pidof org.isomorphisms.ib.prepaint | tr -d '\r')
printf '%s\n' "$original_pid" | rg -x '[1-9][0-9]*' > "$evidence/held-app.pid"
"$adb" -s "$serial" shell am force-stop org.isomorphisms.ib.prepaint
# A legitimate provider reconnect may already have created a new process.
# Require the independently recorded original PID to die; a new PID must not
# be confused with survival of the killed owner.
var original_gone = false
for attempt in @(seq 1 100) {
  "$adb" -s "$serial" shell ps -A -o PID,NAME | tr -d '\r' > "$evidence/after-kill.processes.txt"
  awk 'NR==1 {if($1!="PID" || $2!="NAME")exit 1} END {if(NR<2)exit 1}' "$evidence/after-kill.processes.txt"
  if awk -v original="$original_pid" '$1==original {found=1} END {exit found?1:0}' "$evidence/after-kill.processes.txt" {
    setvar original_gone = true
    break
  }
  sleep 0.05
}
if (not original_gone) { echo 'FAIL original target PID remained after the held acquisition kill' >&2; exit 1 }
try { "$adb" -s "$serial" shell pidof org.isomorphisms.ib.prepaint > "$evidence/killed-app.pid" 2>&1 }
var replacement_process = _error.code
if (replacement_process !== 0 and replacement_process !== 1) { echo 'FAIL replacement process observation' >&2; exit 1 }
printf '%s\n' "$replacement_process" > "$evidence/killed-app.pid.exit"
try { wait "$pending_observer_pid" }
var terminated_observer = _error.code
setglobal pending_observer_pid = ''
printf '%s\n' "$terminated_observer" > "$evidence/held-instrumentation.exit"
if (terminated_observer !== 0 and terminated_observer !== 1) { echo 'FAIL controlled process kill did not end its observer' >&2; exit 1 }
cat "$evidence/held-instrumentation.txt"
if rg -q -x -F 'INSTRUMENTATION_CODE: -1' "$evidence/held-instrumentation.txt" { echo 'FAIL held observer completed before its controlled process kill' >&2; exit 1 }
printf 'release\n' > "$release_file"
var released = false
for attempt in @(seq 1 100) {
  var release_count = $(rg -c -x -F HELD_RELEASED "$evidence/server.stdout")
  if (release_count === '2') { setvar released = true; break }
  sleep 0.1
}
if (not released) { echo 'FAIL held response was not released after process death' >&2; exit 1 }
test "$(rg -c -x -F HELD_REQUEST "$evidence/server.stdout")" = 2
test "$(rg -c -x -F HELD_RELEASED "$evidence/server.stdout")" = 2
if rg -q -x -F HELD_TIMEOUT "$evidence/server.stdout" { echo 'FAIL held source timed out instead of being killed' >&2; exit 1 }
snapshot killed-during-ICU
cmp "$current" "$evidence/killed-during-ICU-arena/last-source"
cmp "$evidence/committed-arena/responses.arena" "$evidence/killed-during-ICU-arena/responses.arena"
var killed_receipts = $(rg --files "$evidence/killed-during-ICU-arena/receipts" | wc -l)
if (int(killed_receipts) !== int(after_receipts)) { echo 'FAIL incomplete killed acquisition published a receipt' >&2; exit 1 }
sh "$repository/ib-source/verify.sh" "$evidence/killed-during-ICU-arena" "$current_id" "$current_generation" \
  http://10.0.2.2:18491/valid > "$evidence/killed-last-good.readback.txt" 2>&1
cat "$evidence/killed-last-good.readback.txt"
# The readback snapshot restarts adbd and may already have ended the
# shell-owned server. Both an observed stop and an already absent server are
# legitimate; the SDK phase independently requires UNAVAILABLE before replay.
try { "$adb" -s "$serial" shell killall shizuku_server > "$evidence/offline.stop-server.txt" 2>&1 }
var offline_stop = _error.code
if (offline_stop !== 0 and offline_stop !== 1) { echo 'FAIL ending acquisition authority before offline replay' >&2; exit 1 }
observe offline-reader-lifecycle offline-lifecycle -1 'PASS native reader Activity return and retained Back Forward without Shizuku'
snapshot offline
cmp "$current" "$evidence/offline-arena/last-source"
cmp "$evidence/committed-arena/responses.arena" "$evidence/offline-arena/responses.arena"
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$compiler" "$evidence/fixture-server" "$repository/ingestion/src/fixture_server.c" \
  "$input/native-client/ib-native-boundary.apk" "$input/native-client/ib-native-resume-noop.apk" \
  "$input/native-client/ib-native-detach-any.apk" "$current" "$evidence/1.original.html" \
  "$evidence/2.original.html" "$evidence/3.original.html" > "$evidence/sha256.txt"
printf 'schema\tib-native-Activity-ownership-v2\napi\t%s\nframework_two_Activities_and_return\tPASS\nretained_current_source_on_resume\tPASS\nnew_navigation_after_return\tPASS\ndeliberately_stale_checked_destroy\tREFUSED\ncompiled_resume_noop\tREJECTED\ncompiled_detach_any_owner\tREJECTED\nthree_original_ranges_and_fixture_digests\tPASS\nchanged_committed_source\tREJECTED\nordered_history\tPASS\nresume_without_refetch\tPASS\noffline_Activity_return_Back_Forward\tPASS\nactual_ICU_request_before_process_kill\tPASS\noriginal_application_PID_death\tPASS\nlegitimate_recreation_allowed_without_old_source_publication\tPASS\ncompleted_response_unchanged_state_claim\tREJECTED\nheld_response_released_after_observed_process_death\tPASS\nsource_history_receipts_unchanged_after_pending_acquisition_loss\tPASS\nindependent_last_good_readback_after_process_loss\tPASS\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
