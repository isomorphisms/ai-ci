#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 2) { echo 'usage: grease prepare-replay.grease AICI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var evidence = ARGV[1]
for path in "$repository" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused replay evidence' >&2; exit 2 }
mkdir -p "$evidence"
sudo apt-get install -y ripgrep unzip
sudo chmod 666 /dev/kvm
curl -fL --retry 2 https://nightly.link/isomorphisms/ib/actions/artifacts/13056729386.zip -o "$evidence/checkpoint.zip"
var grease = "$repository/.tools/runtime/.build/grease/bin/grease"
"$grease" "$repository/ib-source/reader/replay-input.grease" "$repository/.tools/ib-source" "$evidence/checkpoint.zip" "$evidence/input"
cp "$evidence/checkpoint.zip" "$evidence/changed.zip"
printf 'changed-byte-control' >> "$evidence/changed.zip"
try {
  "$grease" "$repository/ib-source/reader/replay-input.grease" "$repository/.tools/ib-source" "$evidence/changed.zip" "$evidence/refused" > "$evidence/archive-control.txt" 2>&1
}
if (_error.code === 0) { echo 'FAIL changed archive accepted' >&2; exit 1 }
test ! -e "$evidence/refused"
rg -F 'FAILED' "$evidence/archive-control.txt"
printf 'candidate_ib\t9b97c4a2fae1ee5b95f4595587f7bdad7b6e0e38\nbackend\tb2720c422f957bd53f3e5e0895e38b4289735ad8\nartifact\t13056729386\narchive_sha256\tef18d9bfa2b480da45478ef717fd2330352c8250a95f28c3137ea2dd6be37b40\narchive_mutation\tREJECTED\n' > "$evidence/input-identity.tsv"
var observer = $(git -C "$repository" rev-parse HEAD)
printf 'observer_source\t%s\n' "$observer" >> "$evidence/input-identity.tsv"
