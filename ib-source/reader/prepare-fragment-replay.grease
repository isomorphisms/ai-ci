#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 2) { echo 'requires AICI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var evidence = ARGV[1]
for path in "$repository" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused installed replay evidence' >&2; exit 2 }
mkdir -p "$evidence/input"
var archive = "$evidence/candidate.zip"
var authorization = ENV.GITHUB_TOKEN
# Authorization is used only for the fixed GitHub artifact endpoint. Curl
# drops that header when redirected to the signed blob host; do not print it.
curl --fail --location --silent --show-error --max-time 300 \
  --header "Authorization: Bearer $authorization" \
  https://api.github.com/repos/isomorphisms/ib/actions/artifacts/13096624598/zip \
  --output "$archive"
test "$(wc -c < "$archive")" = 895592341
printf 'd4ff428ff93fbe7eec0f0f030d1ccc2fafa9911272ac4f6b2a5eec9051dbbdfe  %s\n' "$archive" | sha256sum -c -
unzip -q "$archive" -d "$evidence/input"
test "$(cat "$evidence/input/ib-commit.txt")" = 1a0a0602de168387f556c428c470e9b3eb6f5fe1
test "$(cat "$evidence/input/native-client/ib-commit.txt")" = 1a0a0602de168387f556c428c470e9b3eb6f5fe1
test "$(cat "$evidence/input/native-client/backend-commit.txt")" = 9861b303a7e6d989125d80cee552a46cb2503555
test "$(cat "$evidence/input/native-client/frontend-commit.txt")" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test "$(cat "$evidence/input/native-client/observer-commit.txt")" = 210e6a013691986674a6259f91d1f786e68734de
printf 'schema\tib-installed-replay-v1\nsource\t1a0a0602de168387f556c428c470e9b3eb6f5fe1\noriginal_run\t41340061495\noriginal_artifact\t13096624598\narchive_sha256\td4ff428ff93fbe7eec0f0f030d1ccc2fafa9911272ac4f6b2a5eec9051dbbdfe\n' > "$evidence/input-identity.tsv"
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$evidence/input/native-client/ib-native-boundary.apk" \
  "$evidence/input/native-client/ib-native-uid-bypass.apk" \
  "$evidence/input/native-client/ib-native-death-noop.apk" \
  "$evidence/input/native-client/ib-native-strict-flags.apk" \
  "$evidence/input/native-client/ib-native-stale-authorization.apk" \
  "$evidence/input/native-client/ib-native-anchor-zero.apk" \
  "$evidence/input/native-client/ib-native-resume-noop.apk" \
  "$evidence/input/native-client/ib-native-detach-any.apk" > "$evidence/candidate-sha256.txt"
