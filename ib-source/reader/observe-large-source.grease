#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'usage: grease observe-large-source.grease AICI INPUT SMALI ADB SERIAL NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
var serial = ARGV[4]
var evidence = ARGV[5]
for path in "$repository" "$input" "$smali" "$adb" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused large-source evidence' >&2; exit 2 }
mkdir -p "$evidence/observer-source"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== ENV.AICI_EXPECTED_ANDROID_API or (api !== '29' and api !== '34')) { exit 1 }
cp "$repository/ib-source/reader/LargeSourceObserver.smali" "$repository/ib-source/reader/AssertionFailure.smali" "$repository/ib-source/reader/SourceStackSampler.smali" "$evidence/observer-source/"
java -jar "$smali" assemble "$evidence/observer-source" -o "$evidence/observer.dex"
var digest = $(sha256sum "$input/prepaint/reader.dex" | cut -d ' ' -f 1)
var remote = "/data/local/tmp/ib-scale-$digest"
"$adb" -s "$serial" shell test ! -e "$remote"
"$adb" -s "$serial" shell mkdir "$remote"
"$adb" -s "$serial" push "$evidence/observer.dex" "$remote/observer.dex"
"$adb" -s "$serial" shell chmod 444 "$remote/observer.dex"
for lane in prepaint prepaint-decoding-gate-mutant {
  "$adb" -s "$serial" push "$input/$lane/reader.dex" "$remote/$lane.dex"
  "$adb" -s "$serial" shell chmod 444 "$remote/$lane.dex"
  "$adb" -s "$serial" pull "$remote/$lane.dex" "$evidence/$lane.received.dex"
  cmp "$input/$lane/reader.dex" "$evidence/$lane.received.dex"
  try {
    timeout 180 "$adb" -s "$serial" shell -T \
      "CLASSPATH=$remote/$lane.dex:$remote/observer.dex app_process /system/bin acceptance.LargeSourceObserver" > "$evidence/$lane.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$lane.exit"
  cat "$evidence/$lane.txt"
  if (lane === 'prepaint') {
    if (status !== 0) {
      awk '
        FNR==NR {if($0 ~ /^__idric(Managed[0-9]+|Apply|RecursiveGroup_.*|TailGroup_.*)$/) wanted[$0]=1; next}
        $1=="method" {selected=($2 in wanted); title=$0; next}
        selected && /^source:/ {print title; print; selected=0}
      ' "$evidence/$lane.txt" "$input/$lane/reader.dex.plan" > "$evidence/failing-checked-methods.txt"
      cat "$evidence/failing-checked-methods.txt"
      echo 'FAIL unchanged checked large source projection' >&2
      exit 1
    }
    rg -x -F 'PASS independent exact 231 and 84007 byte legacy source projections' "$evidence/$lane.txt"
  } else {
    if (status !== 137) { echo 'FAIL compiled source-admission mutant did not reach its designated rejection' >&2; exit 1 }
    rg -x -F 'FAIL checked scale incomplete-source refusal' "$evidence/$lane.txt"
  }
}
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$input/prepaint/reader.dex" "$input/prepaint-decoding-gate-mutant/reader.dex" "$evidence/observer.dex" > "$evidence/sha256.txt"
printf 'schema\tib-large-source-v1\napi\t%s\nabi\tx86_64\nexact_231_and_84007_original_byte_projection\tPASS\nincomplete_source\tREJECTED\ncompiled_admission_mutant\tREJECTED\nactual_network_Arena_Activity\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
