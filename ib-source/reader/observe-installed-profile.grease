#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'requires AICI INPUT SDK ICK PROFILE NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var sdk = ARGV[2]
var compiler = ARGV[3]
var profile = ARGV[4]
var evidence = ARGV[5]
var grease = ENV.IB_GREASE
if (profile !== 'fragments' and profile !== 'lifecycle' and profile !== 'links' and profile !== 'full') { exit 2 }
if test -e "$evidence" { echo 'FAIL reused profile replay evidence' >&2; exit 2 }
mkdir -p "$evidence"
var adb = "$sdk/platform-tools/adb"
if (profile === 'full') {
  var consumer = "$repository/.tools/ib-source"
  test "$(git -C "$consumer" rev-parse HEAD)" = d02fe516833d0941e8ff1ab2b84369c1661aee6c
  mkdir -p "$consumer/.tools"
  if test -e "$consumer/.tools/reader-acceptance" { echo 'FAIL reused acceptance checkout' >&2; exit 2 }
  ln -s "$repository" "$consumer/.tools/reader-acceptance"
  var api = ENV.AICI_EXPECTED_ANDROID_API
  "$grease" "$consumer/examples/autogenerated/tabp10-reader/observe-all.grease" \
    "$consumer" "$input" "$sdk" "$api" "$evidence/full"
  exit 0
}
"$grease" "$repository/ib-source/shizuku/observe-installed.grease" "$repository" \
  "$input/native-client" "$input/oracles/smali.jar" "$sdk" \
  "$input/platform-inputs/public-test-keystore" "$input/platform-inputs/shizuku-official.apk" \
  "$adb" emulator-5554 "$evidence/installed" reader-v2
var program = 'observe-fragments.grease'
if (profile === 'lifecycle') { setvar program = 'observe-reader-lifecycle.grease' }
if (profile === 'links') { setvar program = 'observe-link-shapes.grease' }
"$grease" "$repository/ib-source/shizuku/$program" "$repository" "$input" "$sdk" "$compiler" \
  "$adb" emulator-5554 "$evidence/installed" "$evidence/$profile"
