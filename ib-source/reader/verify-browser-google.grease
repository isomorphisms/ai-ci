#!/usr/bin/env grease
# Independent source/range/heading/destination proof for the actual Android
# transaction. Producer result extraction is not used by this observer.
set -eu -o pipefail
if (len(ARGV) !== 7) { echo 'usage: grease verify-browser-google.grease AICI ARENA DOM_ID GENERATION CLICKED_URI NATIVE_BODY NEW_EVIDENCE' >&2; exit 2 }
var acceptance = ARGV[0]
var root = ARGV[1]
var identity = ARGV[2]
var generation = ARGV[3]
var clicked = ARGV[4]
var visible = ARGV[5]
var evidence = ARGV[6]
var grease = ENV.IB_GREASE
if test -e "$evidence" { exit 2 }
umask 077
mkdir -m 700 -p "$evidence"
printf '%s\n' "$identity" | rg -q -x '[0-9a-f]{48}'
printf '%s\n' "$generation" | rg -q -x '[1-9][0-9]{0,9}'
if (int(generation) > 2147483647) { exit 1 }
test "$(stat -c %a "$root")" = 700
for file in "$root" "$root/receipts" "$root/responses.arena" "$root/responses.arena.used" "$root/responses.arena.lock" {
  test ! -L "$file"
}
var receipt = "$root/receipts/$identity.dom.tsv"
test -f "$receipt"
test ! -L "$receipt"
test "$(stat -c %s "$receipt")" -le 32768
tr -cd '\011\012\040-\176' < "$receipt" > "$evidence/ascii-receipt"
cmp "$receipt" "$evidence/ascii-receipt"
"$grease" "$acceptance/ib-source/reader/verify-browser-dom-receipt-shape.grease" "$receipt"
proc field(key) { awk -F '\t' -v "key=$key" '$1==key{print $2}' "$receipt" }
proc expect(key, value) {
  if ! rg -q -x -F "$key	$value" "$receipt" { echo "FAIL rendered source field $key" >&2; exit 1 }
}
var query = 'https://google.com/search?q=open+source+guitar+chord+transposition+chords'
var final_search = 'https://www.google.com/search?q=open+source+guitar+chord+transposition+chords'
expect schema ib-browser-dom-arena-v1
expect request_id "$identity"
expect source_generation "$generation"
expect parent_generation "$generation"
expect requested_url "$query"
# Google adds bounded frontend continuation parameters (observed `sei`).
# Keep the exact resolved URI in the receipt, but independently require the
# original once-encoded query exactly once on the first-party HTTPS endpoint.
var observed_search = $(field resolved_url)
printf '%s\n' "$observed_search" > "$evidence/resolved-search.txt"
if (len(observed_search) > 2048 or not observed_search.startsWith('https://www.google.com/search?')) { echo 'FAIL rendered search origin or path' >&2; exit 1 }
if rg -q '#' "$evidence/resolved-search.txt" { echo 'FAIL rendered search fragment' >&2; exit 1 }
sed 's/^[^?]*?//' "$evidence/resolved-search.txt" | tr '&' '\n' > "$evidence/search-parameters.txt"
awk '$0!~/^[A-Za-z0-9_]+=[!-~]*$/ {bad=1} /^q=/{n++}
  END{if(bad || n!=1)exit 1}' "$evidence/search-parameters.txt"
rg -q -x -F 'q=open+source+guitar+chord+transposition+chords' "$evidence/search-parameters.txt"
expect serialization webview-content-outerHTML-utf8-v1
expect complete YES
var provider = $(field provider_package)
printf '%s\n' "$provider" | rg -q -x 'com\.android\.webview|com\.google\.android\.webview'
var version = $(field provider_version)
printf '%s\n' "$version" | rg -q -x '[0-9]+(\.[0-9]+){2,4}'
var parent = $(field parent_id)
printf '%s\n' "$parent" | rg -q -x '[0-9a-f]{48}'
"$grease" "$acceptance/ib-source/reader/verify-decoder-original.grease" \
  "$acceptance" "$root" "$parent" "$generation" "$query" iso-8859-1 - "$evidence/parent" \
  observed-browser-parent-v1 "$final_search" > "$evidence/parent-verification.txt" 2>&1
var parent_sha = $(sha256sum "$evidence/parent/body" | cut -d ' ' -f 1)
expect parent_sha256 "$parent_sha"
var offset = $(field arena_offset)
var bytes = $(field byte_count)
var pointer = $(cat "$root/responses.arena.used")
for number in "$offset" "$bytes" "$pointer" {
  printf '%s\n' "$number" | rg -q -x '0|[1-9][0-9]{0,14}'
}
if (int(bytes) < 1 or int(bytes) > 2097152 or int(offset) + int(bytes) > int(pointer) or
    int(pointer) > int($(stat -c %s "$root/responses.arena"))) { echo 'FAIL rendered source committed range' >&2; exit 1 }
dd "if=$root/responses.arena" "of=$evidence/original.dom.html" bs=65536 iflag=skip_bytes,count_bytes \
  "skip=$offset" "count=$bytes" status=none
test "$(stat -c %s "$evidence/original.dom.html")" = "$bytes"
var digest = $(sha256sum "$evidence/original.dom.html" | cut -d ' ' -f 1)
expect sha256 "$digest"
iconv -f UTF-8 -t UTF-8 < "$evidence/original.dom.html" > /dev/null
test "$(cat "$root/responses.arena.used")" = "$pointer"
var headings = '//a[.//h3 or .//*[@role="heading"]][not(ancestor::nav or ancestor::header or ancestor::footer or ancestor::script or ancestor::template)]'
timeout 20 xmllint --html --recover --nonet --xpath "count($headings)" "$evidence/original.dom.html" \
  > "$evidence/heading-count.txt" 2> "$evidence/parser.stderr"
var heading_count = $(cat "$evidence/heading-count.txt")
printf '%s\n' "$heading_count" | rg -q -x '[0-9]{1,2}'
if (int(heading_count) < 1 or int(heading_count) > 64) { exit 1 }
var copied = "$(dirname "$visible")/native-source.txt"
"$grease" "$acceptance/ib-source/reader/verify-native-google-selection.grease" \
  "$copied" "$visible" "$evidence/native-selection"
awk '{gsub(/[[:space:]]+/," ");printf "%s ",$0}' "$copied" > "$evidence/source-normalized.txt"
tr -d '\011\012\015\040' < "$visible" > "$evidence/visible-addresses.txt"
var count = $(field target_count)
var clicked_matches = 0
var snippets = 0
for index in @(seq 1 "$count") {
  var target = "$evidence/target-$index"
  mkdir -m 700 "$target"
  var target_id = $(field "target${index}_id")
  var requested = $(field "target${index}_requested")
  var original_href = $(field "target${index}_href")
  printf '%s\n' "$target_id" | rg -q -x '[0-9a-f]{48}'
  printf '%s\n' "$original_href" > "$target/retained-href.txt"
  printf '%s\n' "$requested" > "$target/retained-requested.txt"
  # The producer retains the original attribute spelling; the independent DOM
  # parser returns the once entity-decoded value. Decode that exact bounded
  # spelling with the independent parser before comparing anchor membership.
  if rg -q '[<>"\\]' "$target/retained-href.txt" { echo 'FAIL unsafe retained href spelling' >&2; exit 1 }
  printf '<a href="%s"></a>\n' "$original_href" > "$target/attribute-decoder.html"
  timeout 20 xmllint --html --recover --nonet --xpath 'string(//a/@href)' "$target/attribute-decoder.html" \
    > "$target/decoded-href.txt" 2>> "$evidence/parser.stderr"
  var href = $(cat "$target/decoded-href.txt")
  var matches = 0
  var matching_heading = 0
  for heading in @(seq 1 "$heading_count") {
    timeout 20 xmllint --html --recover --nonet --xpath "string(($headings)[$heading]/@href)" \
      "$evidence/original.dom.html" > "$target/href-$heading.txt" 2>> "$evidence/parser.stderr"
    var observed = $(cat "$target/href-$heading.txt")
    if (observed === href) {
      setvar matches += 1
      setvar matching_heading = int(heading)
      timeout 20 xmllint --html --recover --nonet --xpath "count(($headings)[$heading]//*[self::h3 or @role='heading'])" \
        "$evidence/original.dom.html" > "$target/title-heading-count.txt" 2>> "$evidence/parser.stderr"
      test "$(cat "$target/title-heading-count.txt")" = 1
      timeout 20 xmllint --html --recover --nonet --xpath "normalize-space(string((($headings)[$heading]//*[self::h3 or @role='heading'])[1]))" \
        "$evidence/original.dom.html" > "$target/title.txt" 2>> "$evidence/parser.stderr"
    }
  }
  if (matches < 1) { echo 'FAIL resolved target href is not a retained titled DOM anchor' >&2; exit 1 }
  var title = $(cat "$target/title.txt")
  if (len(title) < 1 or len(title) > 1024) { exit 1 }
  var direct = ''
  if (href.startsWith('https://') or href.startsWith('http://')) {
    setvar direct = href
  } elif (href.startsWith('//')) {
    setvar direct = 'https:' ++ href
  } elif (href.startsWith('/')) {
    setvar direct = 'https://www.google.com' ++ href
  } else { echo 'FAIL unsupported independent result reference' >&2; exit 1 }
  if (direct.startsWith('https://www.google.com/url?') or direct.startsWith('https://google.com/url?')) {
    printf '%s\n' "$direct" | sed 's/^[^?]*?//' | tr '&' '\n' > "$target/parameters.txt"
    test "$(awk '/^(q|url)=/{n++}END{print n+0}' "$target/parameters.txt")" = 1
    var encoded = $(sed -n -E 's/^(q|url)=//p' "$target/parameters.txt")
    printf '%s\n' "$encoded" > "$target/encoded-target.txt"
    if rg -q '\\|%([01][0-9A-Fa-f]|7[Ff])' "$target/encoded-target.txt" { exit 1 }
    sed -E 's/%[0-9A-Fa-f]{2}//g' "$target/encoded-target.txt" > "$target/unpaired-target.txt"
    if rg -q '%' "$target/unpaired-target.txt" { exit 1 }
    var escaped = $(printf '%s' "$encoded" | sed -e 's/+/ /g' -e 's/%/\\x/g')
    var decoded = $(printf '%b' "$escaped")
    # Only a clear HTTP(S) target is decoded into a public URL. An opaque
    # Google token preserves the exact observed Google request for ICU.
    if (decoded.startsWith('https://') or decoded.startsWith('http://')) { setvar direct = decoded }
  }
  if (direct !== requested) { echo 'FAIL retained DOM href and ICU request differ' >&2; exit 1 }
  sh "$acceptance/ib-source/verify.sh" "$root" "$target_id" "$generation" "$requested" > "$target/ICU-source.txt" 2>&1
  var final = $(awk -F '\t' '$1=="resolved_url"{print $2}' "$root/receipts/$target_id.tsv")
  printf '%s\n' "$final" | rg -q -x 'https://[A-Za-z0-9][A-Za-z0-9.-]*(/[!-~]*)?'
  var host = $(printf '%s\n' "$final" | awk -F / '{print tolower($3)}')
  printf '%s\n' "$host" > "$target/host.txt"
  if rg -q '(^|\.)(google\.[a-z.]+|gstatic\.com|googleusercontent\.com|googleadservices\.com|localhost|local|invalid|test)$|^[0-9.]+$' "$target/host.txt" { exit 1 }
  if ! rg -q -F -- "$title" "$evidence/source-normalized.txt" { echo 'FAIL original DOM title is missing from actual SDK copied native result source' >&2; exit 1 }
  if ! rg -q -F -- "$final" "$evidence/visible-addresses.txt" { echo 'FAIL verified public destination is missing from native result text' >&2; exit 1 }
  # Independently associate an available snippet only with the nearest actual
  # Google result group containing one heading and one data-sncf source node.
  # Ambiguous/unrelated prose is never used as a substitute.
  var group = "($headings)[$matching_heading]/ancestor::div[contains(concat(' ',normalize-space(@class),' '),' MjjYud ')][1]"
  timeout 20 xmllint --html --recover --nonet --xpath "concat(count($group//a[.//h3 or .//*[@role='heading']]),'|',count($group//div[@data-sncf]))" \
    "$evidence/original.dom.html" > "$target/snippet-shape.txt" 2>> "$evidence/parser.stderr"
  var snippet_shape = $(cat "$target/snippet-shape.txt")
  if (snippet_shape === '1|1') {
    timeout 20 xmllint --html --recover --nonet --xpath "normalize-space(string(($group//div[@data-sncf])[1]))" \
      "$evidence/original.dom.html" > "$target/snippet.txt" 2>> "$evidence/parser.stderr"
    var snippet = $(cat "$target/snippet.txt")
    if (len(snippet) > 0 and len(snippet) <= 1024) {
      if ! rg -q -F -- "$snippet" "$evidence/source-normalized.txt" { echo 'FAIL associated DOM snippet is missing from actual SDK copied native result source' >&2; exit 1 }
      setvar snippets += 1
    }
  }
  if (final === clicked) { setvar clicked_matches += 1 }
}
if (clicked_matches !== 1) { echo 'FAIL actual touched public URL has no unique DOM-to-ICU result correspondence' >&2; exit 1 }
printf 'schema\tindependent-browser-Google-source-v1\noriginal_ICU_parent\tPASS\nrendered_DOM_immutable_range_digest\tPASS\nrendered_provenance\tEXPLICIT\nindependent_titled_anchor_membership\tPASS\nICU_resolved_destinations\t%s\nsource_to_native_title_URL\tPASS\nassociated_visible_snippets\t%s\nactual_touch_URL_correspondence\tPASS\nICU_only_Google\tFAIL\n' "$count" "$snippets" > "$evidence/receipt.tsv"
echo 'PASS independent original ICU parent, distinct DOM bytes, actual headings and verified native destinations'
