#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) { echo 'requires AICI INPUT SMALI ADB SERIAL EXPECTED_API NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
var serial = ARGV[4]
var api = ARGV[5]
var evidence = ARGV[6]
if test -e "$evidence" { exit 1 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
"$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r' | rg -x -F "$api"
var remote = '/data/local/tmp/ai-ci-text-order'
"$adb" -s "$serial" shell mkdir -p "$remote"
for kind in TextOrder PureTextOrder {
  java -jar "$smali" assemble "$repository/ib-source/reader/${kind}Observer.smali" -o "$evidence/$kind.dex"
  "$adb" -s "$serial" push "$evidence/$kind.dex" "$remote/$kind.dex"
}
for lane in managed pure command mutant {
  "$adb" -s "$serial" push "$input/$lane/candidate.dex" "$remote/$lane.dex"
  "$adb" -s "$serial" pull "$remote/$lane.dex" "$evidence/$lane.received.dex"
  cmp "$input/$lane/candidate.dex" "$evidence/$lane.received.dex"
}
proc execute(lane, observer, expected_status, marker) {
  var class = 'Idric.Generated'
  var classpath = "$remote/$lane.dex"
  if (observer !== 'none') {
    setvar class = "acceptance.reader.${observer}Observer"
    setvar classpath = "$classpath:$remote/$observer.dex"
  }
  try { timeout 60 "$adb" -s "$serial" shell -T "CLASSPATH=$classpath app_process /system/bin $class" > "$evidence/$lane.txt" 2>&1 }
  var observed_status = _error.code
  printf '%s\n' "$observed_status" > "$evidence/$lane.exit"
  cat "$evidence/$lane.txt"
  if test "$observed_status" -ne "$expected_status" { echo 'FAIL Text ordering observer exit' >&2; exit 1 }
  tr -d '\r' < "$evidence/$lane.txt" | rg -x -F "$marker"
}
execute managed TextOrder 0 'PASS independent ASCII prefix NUL combining and supplementary scalar Text ordering'
execute pure PureTextOrder 0 'PASS independent pure Text export scalar ordering'
execute command none 0 '00011'
execute mutant TextOrder 73 'FAIL Unicode scalar Text ordering'
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
sha256sum "$evidence/TextOrder.dex" "$evidence/PureTextOrder.dex" "$input/managed/candidate.dex" \
  "$input/pure/candidate.dex" "$input/command/candidate.dex" "$input/mutant/candidate.dex" > "$evidence/sha256.txt"
printf 'unicode_scalar_Text_order\tPASS\npure_Text_entry\tPASS\nmanaged_command_entry\tPASS\ncompiled_UTF16_mutant\tREJECTED\napi\t%s\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
cat "$evidence/receipt.tsv"
