#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease prepare-recursive-replay.grease AICI NEW_EVIDENCE API' >&2; exit 2 }
var repository = ARGV[0]
var evidence = ARGV[1]
var api = ARGV[2]
if (api !== '29' and api !== '34') { exit 2 }
for path in "$repository" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused recursive source replay' >&2; exit 2 }
mkdir -p "$evidence/input"
var artifact = '13084599148'
var count = '19187689'
var digest = '6381bb22131a770ae2837b609d1a53376d5bd5c95e212e346c29ccd3279536f9'
if (api === '34') {
  setglobal artifact = '13085198176'
  setglobal count = '19188490'
  setglobal digest = '9006139b99483473dbe2b7175936ad359d29803db5be1c02476d041d6ef17299'
}
var authorization = ENV.GITHUB_TOKEN
curl --fail --location --silent --show-error --max-time 120 \
  --header "Authorization: Bearer $authorization" \
  "https://api.github.com/repos/isomorphisms/android-NDK/actions/artifacts/$artifact/zip" --output "$evidence/original.zip"
test "$(wc -c < "$evidence/original.zip")" = "$count"
printf '%s  %s\n' "$digest" "$evidence/original.zip" | sha256sum -c -
unzip -q "$evidence/original.zip" -d "$evidence/input"
test "$(cat "$evidence/input/integration-commit.txt")" = 150ae18dcac6e97e6bb5150e868929245f133594
test "$(cat "$evidence/input/recursive-consumer/compiler-source.txt")" = 150ae18dcac6e97e6bb5150e868929245f133594
test "$(cat "$evidence/input/recursive-consumer/IB-source.txt")" = a7349efc8041b4c41ff158afca7f13079c8df1c2
printf '9b734b1a545112a53a4a0ad9ab48f9ad0db788933afce11d525c3c877a3a1642  %s\n' \
  "$evidence/input/recursive-consumer/prepaint/reader.dex" | sha256sum -c -
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
printf 'schema\tidric-recursive-replay-input-v1\ncompiler_source\t150ae18dcac6e97e6bb5150e868929245f133594\nIB_source\ta7349efc8041b4c41ff158afca7f13079c8df1c2\noriginal_run\t41309505546\nartifact\t%s\narchive_sha256\t%s\napi\t%s\n' "$artifact" "$digest" "$api" > "$evidence/input-identity.tsv"
