#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 2) { echo 'requires AICI NEW_EVIDENCE' >&2; exit 2 }
var repository = ARGV[0]
var evidence = ARGV[1]
for path in "$repository" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused installed replay evidence' >&2; exit 2 }
mkdir -p "$evidence/input"
var archive = "$evidence/candidate.zip"
var authorization = ENV.GITHUB_TOKEN
# Authorization is used only for the fixed GitHub artifact endpoint. Curl
# drops that header when redirected to the signed blob host; do not print it.
curl --fail --location --silent --show-error --max-time 300 \
  --header "Authorization: Bearer $authorization" \
  https://api.github.com/repos/isomorphisms/ib/actions/artifacts/13109668025/zip \
  --output "$archive"
test "$(wc -c < "$archive")" = 1186825357
printf '1bf0722b006843061b42f746cea4c8f1a665dd624fdd2ff8b52053955ec2856c  %s\n' "$archive" | sha256sum -c -
# Keep the immutable producer archive remote and retain its verified identity.
# Android observes the original APK/DEX/ELF bytes below; frontend bundles,
# native object trees and host compiler workspaces are not runtime inputs.
unzip -Z1 "$archive" > "$evidence/archive-entries.txt"
awk 'substr($0,1,1)=="/" || $0~/(^|\/)\.\.(\/|$)/ {exit 1}' "$evidence/archive-entries.txt"
unzip -q "$archive" -d "$evidence/input" \
  ib-commit.txt backend-commit.txt frontend-commit.txt \
  '*.dex' '*.dex.plan' 'parcelable/*/libib_reader.so' \
  'native-client/*.apk' 'native-client/*-commit.txt' \
  native-client/receipt.tsv native-client/sha256.txt \
  native-client/reproduction.tsv native-client/reproduction.sha256 \
  'oracles/*.jar' platform-inputs/public-test-keystore platform-inputs/shizuku-official.apk

test "$(cat "$evidence/input/ib-commit.txt")" = f43af99856a8ad4161114863e681c118e38c2218
test "$(cat "$evidence/input/native-client/ib-commit.txt")" = f43af99856a8ad4161114863e681c118e38c2218
test "$(cat "$evidence/input/native-client/backend-commit.txt")" = 153e7fc8053ba4072954a5e77d4efa3609d829e4
test "$(cat "$evidence/input/native-client/frontend-commit.txt")" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test "$(cat "$evidence/input/native-client/observer-commit.txt")" = cef5ae8eb891c97dba81cd7bfc6f36edebb44c53
for field in checked_Activity_platform_worker_DEX_repeat ICK_NDK_application_ELF_three_ABIs_repeat signed_APK_byte_reproduction {
  rg -q -x -F "$field	PASS" "$evidence/input/native-client/reproduction.tsv"
}
rg -q -x -F 'native_ICU_Grease_dependencies	REUSED_UNCHANGED_HASHED_INPUTS' "$evidence/input/native-client/reproduction.tsv"
printf 'schema\tib-installed-replay-v1\nsource\tf43af99856a8ad4161114863e681c118e38c2218\noriginal_run\t41370466399\noriginal_artifact\t13109668025\narchive_sha256\t1bf0722b006843061b42f746cea4c8f1a665dd624fdd2ff8b52053955ec2856c\n' > "$evidence/input-identity.tsv"
git -C "$repository" rev-parse HEAD > "$evidence/observer-commit.txt"
for name in ib-native-boundary.apk ib-native-uid-bypass.apk ib-native-death-noop.apk \
  ib-native-strict-flags.apk ib-native-stale-authorization.apk ib-native-anchor-zero.apk \
  ib-native-resume-noop.apk ib-native-detach-any.apk ib-native-anchor-reset.apk ib-native-single-scroll.apk {
  var expected = $(awk -v name="$name" '{n=split($2,p,"/"); if(p[n]==name)print $1}' "$evidence/input/native-client/sha256.txt")
  printf '%s\n' "$expected" | awk 'length($0)!=64 || $0~/[^0-9a-f]/ {exit 1} END {if(NR!=1)exit 1}'
  printf '%s  %s\n' "$expected" "$evidence/input/native-client/$name" | sha256sum -c -
  sha256sum "$evidence/input/native-client/$name" >> "$evidence/candidate-sha256.txt"
}
# Delete only this verified downloaded copy; its original artifact, exact
# digest, entry list and unchanged runtime files remain independently retained.
rm "$archive"
df -PB1 "$evidence" > "$evidence/after-input-capacity.txt"
