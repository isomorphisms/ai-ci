#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6 and len(ARGV) !== 7) { echo 'usage: grease observe-art.grease AICI INPUT SMALI ADB SERIAL NEW_EVIDENCE [history-v2]' >&2; exit 2 }
var repository = ARGV[0]
var input = ARGV[1]
var smali = ARGV[2]
var adb = ARGV[3]
var serial = ARGV[4]
var evidence = ARGV[5]
# Six arguments preserve the declared schema of the frozen 513d72cb replay.
# The integrated reader explicitly selects v2. Missing v2 inputs are failures;
# availability of a file never silently decides which checks must run.
var history = len(ARGV) === 7
if (history and ARGV[6] !== 'history-v2') { echo 'FAIL unknown ART consumer profile' >&2; exit 2 }
for path in "$repository" "$input" "$smali" "$adb" "$evidence" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$evidence" { echo 'FAIL reused ART evidence' >&2; exit 2 }
mkdir -p "$evidence"
"$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r' | rg -x 1
"$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r' | rg -x x86_64
var api = $("$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
if (api !== '29' and api !== '34') { echo 'FAIL undeclared ART API' >&2; exit 1 }
if (api !== ENV.AICI_EXPECTED_ANDROID_API) { echo 'FAIL observed ART API differs from the declared lane' >&2; exit 1 }
"$adb" -s "$serial" shell getprop ro.build.fingerprint > "$evidence/fingerprint.txt"
var digest = $(sha256sum "$input/prepaint/reader.dex" | cut -d ' ' -f 1)
var remote = "/data/local/tmp/ib-checked-reader-$digest"
"$adb" -s "$serial" shell test ! -e "$remote"
"$adb" -s "$serial" shell mkdir "$remote"
for observer in Projection Search ReaderProjection TextNumberCast History {
  mkdir "$evidence/$observer-source"
  cp "$repository/ib-source/reader/${observer}Observer.smali" "$evidence/$observer-source/"
  cp "$repository/ib-source/reader/AssertionFailure.smali" "$evidence/$observer-source/"
  java -jar "$smali" assemble "$evidence/$observer-source" -o "$evidence/$observer.dex"
  "$adb" -s "$serial" push "$evidence/$observer.dex" "$remote/$observer.dex"
  "$adb" -s "$serial" shell chmod 444 "$remote/$observer.dex"
}
var lanes = ['projection', 'search', 'number-casts', 'number-casts-mutant', 'prepaint', 'prepaint-selector-mutant', 'prepaint-admission-mutant', 'title-mutant']
if (history) { setglobal lanes = lanes ++ ['history', 'history-branch-mutant', 'history-cursor-mutant', 'history-generation-mutant'] }
for lane in @lanes {
  test -s "$input/$lane/reader.dex"
  "$adb" -s "$serial" push "$input/$lane/reader.dex" "$remote/$lane.dex"
  "$adb" -s "$serial" shell chmod 444 "$remote/$lane.dex"
  "$adb" -s "$serial" pull "$remote/$lane.dex" "$evidence/$lane.received.dex"
  cmp "$input/$lane/reader.dex" "$evidence/$lane.received.dex"
}
proc execute(lane, observer, class, expected_status, expected_text) {
  "$adb" -s "$serial" shell cat /proc/meminfo > "$evidence/$lane.meminfo-before.txt"
  try {
    timeout 120 "$adb" -s "$serial" shell -T \
      "CLASSPATH=$remote/$lane.dex:$remote/$observer.dex app_process /system/bin $class" \
      > "$evidence/$lane.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$evidence/$lane.exit"
  cat "$evidence/$lane.txt"
  if (status !== int(expected_status)) {
    try { "$adb" -s "$serial" logcat -d -v threadtime > "$evidence/$lane.logcat.txt" 2>&1 }
    try { "$adb" -s "$serial" shell cat /proc/meminfo > "$evidence/$lane.meminfo-after.txt" 2>&1 }
    echo "FAIL wrong ART exit for $lane: observed $status expected $expected_status" >&2
    exit 1
  }
  rg -x -F "$expected_text" "$evidence/$lane.txt"
}
execute projection Projection acceptance.ProjectionExportObserver 0 'PASS unchanged IB source projection on ART'
execute search Search acceptance.SearchExportObserver 0 'PASS unchanged IB search export on ART'
execute number-casts TextNumberCast acceptance.TextNumberCastObserver 0 'PASS checked Text numeric casts on ART'
execute number-casts-mutant TextNumberCast acceptance.TextNumberCastObserver 137 'FAIL checked Text numeric cast'
if (history) {
  execute history History acceptance.HistoryObserver 0 'PASS independent retained history Back Forward branching canonical identity and generation bounds'
  execute history-branch-mutant History acceptance.HistoryObserver 137 'FAIL arrival after Back drops only forward references'
  execute history-cursor-mutant History acceptance.HistoryObserver 137 'FAIL out of range cursor refusal'
  execute history-generation-mutant History acceptance.HistoryObserver 137 'FAIL source generation overflow refusal'
}
execute prepaint ReaderProjection acceptance.ReaderProjectionObserver 0 'PASS checked IB admission, Prepaint and source reflow on ART'
execute prepaint-selector-mutant ReaderProjection acceptance.ReaderProjectionObserver 137 'FAIL squared-reflow'
execute prepaint-admission-mutant ReaderProjection acceptance.ReaderProjectionObserver 137 'FAIL count-mismatch-refusal'
execute title-mutant Projection acceptance.ProjectionExportObserver 137 'FAIL unchanged IB retained-source export'
printf 'schema\tib-reader-art-v2\napi\t%s\nabi\tx86_64\ncompiler_exports\tPASS\nnumeric_casts\tPASS\ncompiled_numeric_mutant\tREJECTED\ncompiled_selector_mutant\tREJECTED\ncompiled_admission_mutant\tREJECTED\ncompiled_title_mutant\tREJECTED\nActivity_events\tNOT_RUN\nBinder_Shizuku\tNOT_RUN\nphysical_TAB_P10\tNOT_RUN\n' "$api" > "$evidence/receipt.tsv"
if (history) {
  printf 'profile\thistory-v2\nhistory_semantics\tPASS\ncompiled_history_branch_cursor_generation_mutants\tREJECTED\n' >> "$evidence/receipt.tsv"
} else {
  printf 'profile\tfrozen-consumer-v1\nhistory_semantics\tNOT_RUN\ncompiled_history_branch_cursor_generation_mutants\tNOT_RUN\n' >> "$evidence/receipt.tsv"
}
sha256sum "$evidence/Projection.dex" "$evidence/Search.dex" "$evidence/ReaderProjection.dex" "$evidence/TextNumberCast.dex" "$evidence/History.dex" > "$evidence/observers.sha256"
