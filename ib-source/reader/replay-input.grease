#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease replay-input.grease IB_SOURCE ZIP NEW_INPUT' >&2; exit 2 }
var source = ARGV[0]
var archive = ARGV[1]
var input = ARGV[2]
for path in "$source" "$archive" "$input" {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$input" { echo 'FAIL reused replay input' >&2; exit 2 }
# Official GitHub artifact 13059301266, run 41243973437. This is an exact
# retained checkpoint, not automatic qualification of a later application head.
printf '%s  %s\n' 2ce4bf5fa14cc5f39320e835fdc1a0632f111100537d94702cf5edd5495b4bac "$archive" | sha256sum -c -
test "$(git -C "$source" rev-parse HEAD)" = 513d72cb43d3097a61f6fcb821b6e4215def960f
mkdir -p "$input"
unzip -Z1 "$archive" > "$input/archive-entries.txt"
if rg -n '(^/|(^|/)\.\.(/|$))' "$input/archive-entries.txt" { echo 'FAIL unsafe archive member' >&2; exit 1 }
unzip -q "$archive" -d "$input"
test "$(cat "$input/ib-commit.txt")" = 513d72cb43d3097a61f6fcb821b6e4215def960f
test "$(cat "$input/backend-commit.txt")" = 0f9b6e1b867d424ac2ba0b2036a54ac74a277d7d
test "$(cat "$input/frontend-commit.txt")" = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$input/oracles/smali.jar" | sha256sum -c -
diff -r "$source/src/IB" "$input/source/IB"
cmp "$source/examples/autogenerated/tabp10-reader/ReaderProjection.idric" "$input/source/ReaderProjection.idric"
cmp "$source/examples/autogenerated/native-reader/NativeReader.idric" "$input/source/NativeReader.idric"
cmp "$source/examples/autogenerated/native-source-projection/NativeSourceProjection.idric" "$input/source/NativeSourceProjection.idric"
cmp "$source/examples/autogenerated/chordsearch/SearchIntentRequest.idric" "$input/source/SearchIntentRequest.idric"
for lane in projection search number-casts number-casts-mutant prepaint prepaint-selector-mutant prepaint-admission-mutant title-mutant {
  var expected = $(cut -d ' ' -f 1 "$input/$lane/output.sha256")
  printf '%s  %s\n' "$expected" "$input/$lane/reader.dex" | sha256sum -c -
}
